package api

import core.Cliente
import core.Resposta
import kof.json

class DesabafosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? cursor, Int limite) {
        return this.cliente.get("/desabafos" + Consulta.pagina(cursor, limite))
    }

    Resposta obter(String postId) {
        return this.cliente.get("/desabafos/posts/" + ConsultaTextos.caminho(postId))
    }

    Resposta publicar(String conteudo) {
        return this.cliente.post("/desabafos/posts",
            json.encode(mapOf("content", conteudo)))
    }

    Resposta apagar(String postId) {
        return this.cliente.delete("/desabafos/posts/" + ConsultaTextos.caminho(postId))
    }

    Resposta comentarios(String postId) {
        return this.cliente.get("/desabafos/posts/" + ConsultaTextos.caminho(postId) + "/comments")
    }

    Resposta comentar(String postId, String conteudo) {
        return this.cliente.post("/desabafos/posts/" + ConsultaTextos.caminho(postId)
            + "/comments", json.encode(mapOf("content", conteudo)))
    }

    Resposta reagir(String postId, String tipo) {
        return this.cliente.post("/desabafos/posts/" + ConsultaTextos.caminho(postId)
            + "/reactions", json.encode(mapOf("type", tipo)))
    }

    Resposta desreagir(String postId) {
        return this.cliente.delete("/desabafos/posts/"
            + ConsultaTextos.caminho(postId) + "/reactions")
    }

    static PaginaAnonimos pagina(Resposta r) {
        if (!r.ok()) { return PaginaAnonimos(listOf<PostAnonimo>(), null) }
        try {
            return json.decode<PaginaAnonimos>(r.corpo)
        } catch (String e) {
            return PaginaAnonimos(listOf<PostAnonimo>(), null)
        }
    }
}

