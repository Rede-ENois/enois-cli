package core

import api.*
import screens.*
import ui.*

class App {

    Config config
    Sessao sessao
    Cliente cliente

    public constructor() {
        this.config = Config.carregar()
        this.sessao = Sessao.carregar()
        this.cliente = Cliente(this.config, this.sessao)
    }

    void executar() {
        this.conferirSessao()
        var rodando = true
        while (rodando && Entrada.ativa) {
            var escolha = this.tela()
            if (escolha == "sair") { rodando = false }
            this.abrir(escolha)
            this.avisarSessaoPerdida()
        }
        println(Tema.mudo("até já"))
    }

    void avisarSessaoPerdida() {
        if (!this.cliente.sessaoPerdida) { return }
        this.cliente.sessaoPerdida = false
        println(Tema.alerta("a sessão neste aparelho terminou — entre de novo"))
    }

    void conferirSessao() {
        if (!this.sessao.logado()) { return }
        if (this.sessao.alvo.length > 0 && this.sessao.alvo != this.config.alvo) {
            this.sessao.limpar()
            println(Tema.alerta("a sessão guardada era de outro alvo — entre de novo"))
            return
        }
        if (!this.cliente.sessaoValida()) {
            this.sessao.limpar()
            this.cliente.sessaoPerdida = false
            println(Tema.alerta("sessão expirada — entre de novo"))
            return
        }
        this.sessao.alvo = this.config.alvo
        this.sessao.salvar()
    }

    String tela() {
        if (this.sessao.logado() && Teclado.disponivel()) { return this.painel() }
        return this.numerado()
    }

    String painel() {
        var seletor = Seletor(this.config.contexto, this.cliente)
        var rota = seletor.escolher("↑↓ navega · enter abre · 1–6 seções · tab contexto · r atualiza · q encerra")
        this.guardarContexto(seletor.contexto)
        if (rota.length == 0) { return "sair" }
        return rota
    }

    String numerado() {
        print(Ansi.LIMPAR)
        println(this.topo())
        if (!this.sessao.logado()) {
            Caixa.desenhar(Caixa.simples(Tema.titulo("você") + "\n" + Tema.suave("alvo: " + this.config.alvo + " · " + this.config.urlApi)))
            var entrada = Entrada.menu("entrar", listOf("entrar", "trocar alvo"), "encerrar")
            if (entrada < 0) { return "sair" }
            if (entrada == 0) { return "entrar" }
            return "trocar alvo"
        }
        var itens = Navegacao.visiveis(this.config.contexto)
        println(Abas.lista(Navegacao.CONTEXTOS, this.config.contexto))
        println("")
        var escolha = Entrada.menuSecoes("principal", Navegacao.secoes(itens), this.rotulos(itens), "encerrar")
        if (escolha < 0) { return "sair" }
        Menu.rodapeDe("número para escolher · 0 encerra a cli")
        return itens.get(escolha).rota
    }

    String topo() {
        var usuario = ""
        var saldo = 0
        if (this.sessao.logado() && this.sessao.usuario != null) {
            usuario = this.sessao.usuario.usuario
            saldo = this.sessao.usuario.faisca
        }
        return Menu.topoCom("Énóis", this.direita(usuario, saldo))
    }

    List<List<String>> rotulos(List<ItemNavegacao> itens) {
        var grupos = listOf<List<String>>()
        for (var secao in Navegacao.secoes(itens)) {
            var rotulos = listOf<String>()
            for (var item in Navegacao.daSecao(itens, secao)) {
                rotulos.add(item.rotulo)
            }
            grupos.add(rotulos)
        }
        return grupos
    }

    void guardarContexto(String novo) {
        if (novo == this.config.contexto) { return }
        this.config.usaContexto(novo)
        this.config.salvar()
    }

    void alternarContexto() {
        this.config.usaContexto(Navegacao.proximoContexto(this.config.contexto))
        this.config.salvar()
        println(Tema.suave("contexto: " + this.config.contexto))
    }

    String direita(String usuario, Int saldo) {
        var partes = listOf<String>()
        if (usuario.length > 0) {
            partes.add(Tema.suave("@" + usuario))
        }
        if (saldo > 0) {
            partes.add(Tema.suave(Faisca.texto(saldo)))
        }
        partes.add(Tema.mudo(this.config.alvo))
        var linha = ""
        for (var i = 0; i < partes.size(); i = i + 1) {
            if (i > 0) { linha = linha + Tema.mudo(" · ") }
            linha = linha + partes.get(i)
        }
        return linha
    }

    void abrir(String escolha) {
        if (escolha == "entrar") {
            var entrar = TelaEntrar(this.cliente, this.config, this.sessao)
            if (entrar.executar()) { entrar.provarFeed() }
        } else if (escolha == "feed") {
            var destino = TelaFeed(this.cliente, this.config.contexto).executar()
            if (destino.length > 0) { this.abrir(destino) }
        } else if (escolha == "mensagens") {
            TelaMensagens(this.cliente, this.sessao, this.config.contexto).executar()
        } else if (escolha == "rede") {
            TelaRede(this.cliente, this.sessao).executar()
        } else if (escolha == "salvos") {
            TelaSalvos(this.cliente).executar()
        } else if (escolha == "comunidades") {
            TelaComunidades(this.cliente).executar()
        } else if (escolha == "grupos") {
            TelaGrupos(this.cliente).executar()
        } else if (escolha == "eventos") {
            TelaEventos(this.cliente).executar()
        } else if (escolha == "blogs") {
            TelaBlogs(this.cliente).executar()
        } else if (escolha == "par de estudo") {
            TelaParesEstudo(this.cliente).executar()
        } else if (escolha == "vagas") {
            TelaVagas(this.cliente).executar()
        } else if (escolha == "freelances") {
            TelaFreelances(this.cliente).executar()
        } else if (escolha == "serviços") {
            TelaServicos(this.cliente).executar()
        } else if (escolha == "empresas") {
            TelaEmpresas(this.cliente).executar()
        } else if (escolha == "mentoria") {
            TelaMentoria(this.cliente).executar()
        } else if (escolha == "perfil profissional") {
            TelaProfissional(this.cliente).executar()
        } else if (escolha == "explorar") {
            TelaExplorar(this.cliente, this.sessao).executar()
        } else if (escolha == "perfil") {
            TelaPerfil(this.cliente, this.sessao).executar()
        } else if (escolha == "notificações") {
            var destino = TelaNotificacoes(this.cliente, this.sessao, this.config.contexto).executar()
            if (destino.length > 0) { this.abrir(destino) }
        } else if (escolha == "conta") {
            TelaConta(this.cliente, this.sessao).executar()
        } else if (escolha == "trocar contexto") {
            this.alternarContexto()
        } else if (escolha == "trocar alvo") {
            this.alternarAlvo()
        } else if (escolha == "sair da conta") {
            this.sairDaConta()
        }
    }

    void sairDaConta() {
        if (!Entrada.confirmar("encerrar a sessão nesta conta?")) { return }
        var confirmado = this.cliente.sair()
        if (confirmado) {
            println(Tema.ok("sessão encerrada"))
        } else {
            println(Tema.erro("não foi possível sair agora. sua sessão continua ativa neste aparelho"))
        }
    }

    void alternarAlvo() {
        if (this.config.alvo == "qa") {
            this.config.usaAlvo("producao")
        } else {
            this.config.usaAlvo("qa")
        }
        this.config.salvar()
        if (this.sessao.logado()) {
            this.sessao.limpar()
            println(Tema.suave("alvo: " + this.config.alvo + " — entre de novo neste alvo"))
        } else {
            println(Tema.suave("alvo: " + this.config.alvo))
        }
    }
}
