package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class EmpresasApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta diretorio(String? termo, String? setor, Int limite) {
        return this.cliente.get("/empresas/diretorio" + Cliente.query(listOf(
            Cliente.par("query", termo),
            Cliente.par("sector", setor),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta obter(String empresaId) {
        return this.cliente.get("/empresas/" + Cliente.caminho(empresaId))
    }

    Resposta pagina(String slug) {
        return this.cliente.get("/empresa/" + Cliente.caminho(slug))
    }

    Resposta minhas() {
        return this.cliente.get("/empresas/mine")
    }

    Resposta seguir(String empresaId) {
        return this.cliente.post("/empresas/" + Cliente.caminho(empresaId)
            + "/follow", "{}")
    }

    Resposta deixarDeSeguir(String empresaId) {
        return this.cliente.delete("/empresas/" + Cliente.caminho(empresaId) + "/follow")
    }

    Resposta membros(String empresaId) {
        return this.cliente.get("/empresas/" + Cliente.caminho(empresaId) + "/members")
    }

    Resposta microprojetos(String empresaId) {
        return this.cliente.get("/empresas/" + Cliente.caminho(empresaId)
            + "/microprojetos")
    }

    Resposta abertos() {
        return this.cliente.get("/microprojetos")
    }

    Resposta microprojeto(String projetoId) {
        return this.cliente.get("/microprojetos/" + Cliente.caminho(projetoId))
    }

    Resposta publicarMicroprojeto(String empresaId, String corpo) {
        return this.cliente.post("/empresas/" + Cliente.caminho(empresaId)
            + "/microprojetos", corpo)
    }

    Resposta editarMicroprojeto(String projetoId, String corpo) {
        return this.cliente.put("/microprojetos/" + Cliente.caminho(projetoId), corpo)
    }

    Resposta removerMicroprojeto(String projetoId) {
        return this.cliente.delete("/microprojetos/" + Cliente.caminho(projetoId))
    }

    Resposta concluirMicroprojeto(String projetoId, String avaliacao, String texto) {
        return this.cliente.post("/microprojetos/" + Cliente.caminho(projetoId) + "/complete",
            json.encode(mapOf("rating", avaliacao, "text", texto)))
    }

    Resposta propostasDoMicroprojeto(String projetoId) {
        return this.cliente.get("/microprojetos/"
            + Cliente.caminho(projetoId) + "/proposals")
    }

    Resposta escolherProposta(String projetoId, String propostaId) {
        return this.cliente.post("/microprojetos/" + Cliente.caminho(projetoId)
            + "/proposals/" + Cliente.caminho(propostaId) + "/select", "{}")
    }

    Resposta propor(String projetoId, String mensagem) {
        return this.cliente.post("/microprojetos/" + Cliente.caminho(projetoId)
            + "/proposals", json.encode(mapOf("message", mensagem)))
    }

    static String corpoMicroprojeto(String titulo, String problema, String escopo,
        String entregaveis, String criterios, String prazo, String orcamento) {
        return "{\"title\":" + json.encode(titulo)
            + ",\"problem\":" + json.encode(problema)
            + ",\"scope\":" + json.encode(escopo)
            + ",\"deliverables\":" + json.encode(entregaveis)
            + ",\"acceptanceCriteria\":" + json.encode(criterios)
            + ",\"deadline\":" + json.encode(prazo)
            + ",\"budget\":" + json.encode(orcamento) + "}"
    }

    static List<EmpresaResumo> listaDe(Resposta r) {
        if (!r.ok()) { return listOf<EmpresaResumo>() }
        try {
            return json.decode<List<EmpresaResumo>>(r.corpo)
        } catch (String e) {
            return listOf<EmpresaResumo>()
        }
    }

    static List<EmpresaDiretorio> diretorioDe(Resposta r) {
        if (!r.ok()) { return listOf<EmpresaDiretorio>() }
        try {
            return json.decode<List<EmpresaDiretorio>>(r.corpo)
        } catch (String e) {
            return listOf<EmpresaDiretorio>()
        }
    }

    static List<MicroProjeto> projetosDe(Resposta r) {
        if (!r.ok()) { return listOf<MicroProjeto>() }
        try {
            return json.decode<List<MicroProjeto>>(r.corpo)
        } catch (String e) {
            return listOf<MicroProjeto>()
        }
    }

    static List<PropostaMicroProjeto> propostasDe(Resposta r) {
        if (!r.ok()) { return listOf<PropostaMicroProjeto>() }
        try {
            return json.decode<List<PropostaMicroProjeto>>(r.corpo)
        } catch (String e) {
            return listOf<PropostaMicroProjeto>()
        }
    }

    static DetalheMicroProjeto detalheDe(Resposta r) {
        var vazio = DetalheMicroProjeto(null, listOf<PropostaMicroProjeto>())
        if (!r.ok()) { return vazio }
        try {
            return json.decode<DetalheMicroProjeto>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }
}
