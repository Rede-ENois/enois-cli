package core

import kof.json

class Config {

    static String URL_PRODUCAO = "https://api.enois.ia.br/api"
    static String URL_QA = "https://enois-api-qa.b7cloud.tech/api"

    static String ORIGEM_PRODUCAO = "https://enois.ia.br"
    static String ORIGEM_QA = "https://enois-qa.b7cloud.tech"

    static String dirEstado() {
        return Config.baseDeConfiguracao() + "/enois-cli"
    }

    static String baseDeConfiguracao() {
        var xdg = config.env("XDG_CONFIG_HOME")
        var xdgTexto = ""
        if (xdg != null) { xdgTexto = xdg }
        if (xdgTexto.length > 0) { return xdgTexto }
        var home = config.env("HOME")
        var homeTexto = ""
        if (home != null) { homeTexto = home }
        if (homeTexto.length > 0) { return homeTexto + "/.config" }
        return "/tmp"
    }

    String alvo
    String urlApi
    String origem
    String contexto

    public constructor() {
        this.alvo = "producao"
        this.urlApi = URL_PRODUCAO
        this.origem = ORIGEM_PRODUCAO
        this.contexto = "social"
    }

    void usaAlvo(String novo) {
        if (novo == "qa") {
            this.alvo = "qa"
            this.urlApi = URL_QA
            this.origem = ORIGEM_QA
        } else {
            this.alvo = "producao"
            this.urlApi = URL_PRODUCAO
            this.origem = ORIGEM_PRODUCAO
        }
    }

    void usaContexto(String novo) {
        if (novo == "profissional") {
            this.contexto = "profissional"
        } else {
            this.contexto = "social"
        }
    }

    String comoJson() {
        return json.encode(mapOf(
            "alvo", this.alvo,
            "urlApi", this.urlApi,
            "origem", this.origem,
            "contexto", this.contexto))
    }

    static Config deMapa(Map<String, Object> m) {
        var c = Config()
        var bruto = Json.texto(m, "alvo")
        if (bruto.length == 0) { bruto = "producao" }
        c.usaAlvo(bruto)
        c.usaContexto(Json.texto(m, "contexto"))
        return c
    }

    static Config carregar() {
        var c = Config()
        var caminho = dirEstado() + "/config.json"
        var bruto = readFile(caminho)
        if (bruto == null) { return c }
        try {
            var m = json.decode<Map<String, Object>>(bruto)
            return deMapa(m)
        } catch (String erro) {
            return c
        }
    }

    Bool salvar() {
        File(dirEstado()).mkdirs()
        return File(dirEstado() + "/config.json").writeText(this.comoJson())
    }
}
