package api

/**
 * Tipos de leitura de perfil e usuários — o espelho terminal do Profile do frontend.
 */
record Perfil(
    String id,
    String? nome,
    String? usuario,
    String? avatar,
    String? bio,
    String? titulo,
    String? local,
    String? site,
    Int? faisca,
    List<String>? selos,
    String? criadoEm
)

/** Entrada da rede (conexões/seguidores) de um perfil. */
record PessoaRede(String id, String? nome, String? usuario, String? avatar)

/** Resultado de busca de usuário. */
record UsuarioBusca(String id, String? nome, String? usuario, String? avatar)
