package ui

import core.*
import tipos.*

record AcaoGaleria(String rotulo, Int inicio, Int fim, Int indice)

class Galeria {

    static List<AcaoGaleria> acoes(List<String> rotulos) {
        var acoes = listOf<AcaoGaleria>()
        var posicao = 2
        for (var i = 0; i < rotulos.size(); i = i + 1) {
            var rotulo = rotulos.get(i)
            acoes.add(AcaoGaleria(rotulo, posicao + 1, posicao + rotulo.length, i))
            posicao = posicao + rotulo.length + 3
        }
        return acoes
    }

    static List<MidiaAnexo> itens(PostResumo p) {
        var lista = listOf<MidiaAnexo>()
        var anexos = p.media
        if (anexos == null) { return lista }
        for (var anexo in anexos) {
            var imagem = Imagem.eImagem(anexo.mimeType)
            var video = CapaVideo.eVideo(anexo.mimeType)
            if (!imagem && !video) { continue }
            if (Galeria.endereco(anexo).length == 0) { continue }
            lista.add(anexo)
        }
        return lista
    }

    static String endereco(MidiaAnexo anexo) {
        if (anexo.cdnUrl == null) { return "" }
        return Midia.url(anexo.cdnUrl)
    }

    static String indicador(Int indice, Int total) {
        return String.valueOf(indice + 1) + "/" + String.valueOf(total)
    }

    static String tipo(MidiaAnexo anexo) {
        if (CapaVideo.eVideo(anexo.mimeType)) { return "vídeo" }
        if (Imagem.eImagem(anexo.mimeType)) { return "imagem" }
        if (anexo.mimeType == null) { return "mídia" }
        return anexo.mimeType
    }

    static String dimensoes(MidiaAnexo anexo) {
        if (anexo.width == null || anexo.height == null) { return "" }
        if (anexo.width <= 0 || anexo.height <= 0) { return "" }
        return String.valueOf(anexo.width) + "×" + String.valueOf(anexo.height)
    }

    static String sufixo(MidiaAnexo anexo) {
        var dimensoes = Galeria.dimensoes(anexo)
        if (dimensoes.length == 0) { return "" }
        return " · " + dimensoes
    }

    static Int colunas() {
        var colunas = Ansi.LARGURA_CONTEUDO - 6
        if (colunas < 20) { colunas = 20 }
        return colunas
    }

    static Int colunasDesenho(MidiaAnexo anexo) {
        var caminho = Galeria.caminho(anexo)
        if (CapaVideo.eVideo(anexo.mimeType)) { caminho = CapaVideo.capa(anexo, true) }
        if (caminho.length == 0) { return Galeria.colunas() }
        var largura = MeioBloco.colunasFinais(caminho, Galeria.colunas(), Terminal.altura() - 6)
        if (largura <= 0) { return Galeria.colunas() }
        return largura
    }

    static Bool mostrar(MidiaAnexo anexo, Int linha, Int coluna) {
        if (CapaVideo.eVideo(anexo.mimeType)) {
            return CapaVideo.mostrar(anexo, Galeria.colunas(), linha, coluna)
        }
        return Imagem.mostrar(Galeria.endereco(anexo), Galeria.colunas(), linha, coluna)
    }

    static String caminho(MidiaAnexo anexo) {
        return Midia.arquivo(Galeria.endereco(anexo))
    }

    static String aviso() {
        return "não foi possível desenhar esta mídia aqui"
    }
}
