package core

class Tema {

    static String RESET = "\u001b[0m"
    static String NEGRITO = "\u001b[1m"
    static String APAGADA = "\u001b[2m"
    static String INVERSO = "\u001b[7m"

    static String FUNDO = "\u001b[48;2;21;17;28m"
    static String SUPERFICIE = "\u001b[48;2;27;22;35m"
    static String CARTAO = "\u001b[48;2;31;25;41m"
    static String CARTAO_ALTO = "\u001b[48;2;42;34;54m"
    static String CARTAO_SUAVE = "\u001b[48;2;36;29;48m"
    static String FUNDO_PRIMARIO = "\u001b[48;2;167;139;250m"
    static String FUNDO_PRIMARIO_SUAVE = "\u001b[48;2;38;29;62m"
    static String FUNDO_AVATAR = "\u001b[48;2;196;181;253m"

    static String TEXTO = "\u001b[38;2;243;238;247m"
    static String TEXTO_SUAVE = "\u001b[38;2;185;174;198m"
    static String TEXTO_MUDO = "\u001b[38;2;156;144;167m"
    static String TEXTO_PLACEHOLDER = "\u001b[38;2;138;127;150m"

    static String PRIMARIO = "\u001b[38;2;167;139;250m"
    static String ANEL = "\u001b[38;2;177;128;252m"
    static String TEXTO_SO_PRIMARIO = "\u001b[38;2;12;12;22m"
    static String TEXTO_AVATAR = "\u001b[38;2;76;29;149m"

    static String BORDA_SUAVE = "\u001b[38;2;52;41;63m"
    static String BORDA_FORTE = "\u001b[38;2;143;127;161m"

    static String DESTRUTIVO = "\u001b[38;2;247;133;125m"
    static String SUCESSO = "\u001b[38;2;110;231;183m"
    static String AVISO = "\u001b[38;2;255;184;107m"
    static String INFO = "\u001b[38;2;147;197;253m"
    static String AMOR = "\u001b[38;2;255;143;177m"
    static String CRESCIMENTO = "\u001b[38;2;43;187;113m"
    static String OPORTUNIDADE = "\u001b[38;2;255;137;24m"

    static String FUNDO_SUCESSO = "\u001b[48;2;16;54;43m"
    static String FUNDO_AVISO = "\u001b[48;2;58;42;30m"
    static String FUNDO_DESTRUTIVO = "\u001b[48;2;61;29;31m"
    static String FUNDO_MUDO = "\u001b[48;2;42;34;54m"

    static String pinta(String estilo, String texto) {
        return estilo + texto + RESET
    }

    static String comFundo(String fundo, String estiloTexto, String texto) {
        return fundo + estiloTexto + texto + RESET
    }

    static String comFundoSobre(String fundo, String texto) {
        return Tema.reaplicar(fundo, texto)
    }

    static String reaplicar(String estilo, String texto) {
        if (texto == null) { return estilo + RESET }
        var saida = estilo
        var restante = texto
        var seguindo = true
        while (seguindo) {
            var marca = restante.indexOf(Tema.RESET)
            if (marca < 0) {
                saida = saida + restante
                seguindo = false
            } else {
                var fim = marca + Tema.RESET.length
                saida = saida + restante.substring(0, fim) + estilo
                restante = restante.substring(fim, restante.length)
            }
        }
        return saida + RESET
    }

    static String marca(String texto) {
        return NEGRITO + PRIMARIO + texto + RESET
    }

    static String destaque(String texto) {
        return NEGRITO + PRIMARIO + texto + RESET
    }

    static String titulo(String texto) {
        return NEGRITO + TEXTO + texto + RESET
    }

    static String texto(String conteudo) {
        return TEXTO + conteudo + RESET
    }

    static String suave(String texto) {
        return TEXTO_SUAVE + texto + RESET
    }

    static String mudo(String texto) {
        return TEXTO_MUDO + texto + RESET
    }

    static String lugar(String texto) {
        return TEXTO_PLACEHOLDER + texto + RESET
    }

    static String erro(String texto) {
        return NEGRITO + DESTRUTIVO + texto + RESET
    }

    static String ok(String texto) {
        return NEGRITO + SUCESSO + texto + RESET
    }

    static String alerta(String texto) {
        return NEGRITO + AVISO + texto + RESET
    }

    static String amor(String texto) {
        return AMOR + texto + RESET
    }

    static String crescimento(String texto) {
        return CRESCIMENTO + texto + RESET
    }

    static String oportunidade(String texto) {
        return OPORTUNIDADE + texto + RESET
    }

    static String progresso(String texto) {
        return NEGRITO + SUCESSO + texto + RESET
    }

    static String selecionado(String texto) {
        return FUNDO_PRIMARIO_SUAVE + NEGRITO + TEXTO + texto + RESET
    }

    static String link(String texto) {
        return "\u001b[4m" + INFO + texto + RESET
    }
}
