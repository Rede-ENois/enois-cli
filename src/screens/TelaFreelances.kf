package screens

import tipos.*
import api.*
import core.Ansi
import core.Cliente
import core.Entrada
import core.Resposta
import core.Tema
import ui.Caixa
import ui.Lista
import ui.Menu

class TelaFreelances {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    void executar() {
        var rodando = true
        while (rodando && Entrada.ativa) {
            var itens = FreelancesApi.pagina(FreelancesApi(this.cliente).listar(null, null, 20)).items
            var freelas = listOf<Freela>()
            if (itens != null) { freelas = itens }
            print(Ansi.LIMPAR)
            println(Menu.topo("énois", ""))
            println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
            println(Tema.destaque("freelas"))
            var opcoes = listOf<String>()
            for (var i = 0; i < freelas.size(); i = i + 1) {
                println(Lista.item(this.titulo(freelas.get(i)), this.resumo(freelas.get(i))))
                opcoes.add(this.titulo(freelas.get(i)))
            }
            if (freelas.size() == 0) {
                println(Caixa.simples(Lista.vazia("nenhum freela aberto")))
            }
            opcoes.add("meus freelas")
            opcoes.add("publicar freela")
            var escolha = Entrada.menu("bicos", opcoes, "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha < freelas.size()) {
                this.abrir(freelas.get(escolha))
            } else if (escolha == freelas.size()) {
                this.meus()
            } else {
                this.criar()
            }
        }
    }

    void meus() {
        var r = FreelancesApi(this.cliente).meus()
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var itens = FreelancesApi.listaDe(r)
        if (itens.size() == 0) {
            println(Caixa.simples(Lista.vazia("você ainda não publicou freelas")))
            Entrada.pausar()
            return
        }
        print(Ansi.LIMPAR)
        println(Tema.destaque("meus freelas"))
        var opcoes = listOf<String>()
        for (var i = 0; i < itens.size(); i = i + 1) {
            println(Lista.item(this.titulo(itens.get(i)), this.resumo(itens.get(i))))
            opcoes.add(this.titulo(itens.get(i)))
        }
        var escolha = Entrada.menu("meus freelas", opcoes, "voltar")
        if (escolha >= 0) { this.abrir(itens.get(escolha)) }
    }

    void abrir(Freela f) {
        var api = FreelancesApi(this.cliente)
        print(Ansi.LIMPAR)
        println(Caixa.simples(this.cartao(f)))
        var opcoes = listOf<String>()
        if ("" + f.owned == "true") {
            opcoes.add("encerrar")
        } else {
            opcoes.add("propor")
        }
        var escolha = Entrada.menu(this.titulo(f), opcoes, "voltar")
        if (escolha < 0) { return }
        if (opcoes.get(escolha) == "propor") {
            var mensagem = Entrada.textoObrigatorio("sua proposta")
            this.avisar(api.propor(f.id, mensagem), "proposta enviada")
        } else if (opcoes.get(escolha) == "encerrar") {
            this.avisar(api.encerrar(f.id), "freela encerrado")
        }
    }

    void criar() {
        var titulo = Entrada.textoObrigatorio("título")
        var descricao = Entrada.textoObrigatorio("escopo")
        this.avisar(FreelancesApi(this.cliente).criar(titulo, descricao), "freela publicado")
    }

    void avisar(Resposta r, String sucesso) {
        if (r.ok()) {
            println(Tema.ok(sucesso))
        } else {
            println(Tema.erro(r.mensagem()))
        }
        Entrada.pausar()
    }

    String titulo(Freela f) {
        if (f.title != null) { return f.title }
        return f.id
    }

    String resumo(Freela f) {
        var texto = ""
        if (f.budgetMin != null) {
            texto = String.valueOf(f.budgetMin)
            if (f.budgetMax != null) { texto = texto + "–" + String.valueOf(f.budgetMax) }
        }
        if (f.username != null) {
            if (texto.length > 0) { texto = texto + " · " }
            texto = texto + "@" + f.username
        }
        if (f.status != null) {
            if (texto.length > 0) { texto = texto + " · " }
            texto = texto + f.status
        }
        return texto
    }

    String cartao(Freela f) {
        var texto = this.titulo(f)
        var rodape = this.resumo(f)
        if (rodape.length > 0) { texto = texto + "\n" + Tema.suave(rodape) }
        if (f.scope != null) { texto = texto + "\n" + f.scope }
        if (f.deadline != null) { texto = texto + "\n" + Tema.mudo("prazo: " + f.deadline) }
        if (f.paymentMethod != null) {
            texto = texto + "\n" + Tema.mudo("pagamento: " + f.paymentMethod)
        }
        return texto
    }
}
