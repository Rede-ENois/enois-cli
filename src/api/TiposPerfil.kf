package api

record Perfil(
    String id,
    String? nome,
    String? usuario,
    String? avatar,
    String? bio,
    String? titulo,
    String? local,
    String? site,
    Int? faisca,
    List<String>? selos,
    String? criadoEm
)

record PessoaRede(String id, String? nome, String? usuario, String? avatar)

record UsuarioBusca(String id, String? nome, String? usuario, String? avatar)
