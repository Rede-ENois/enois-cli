package api

import core.Cliente
import core.Resposta
import tipos.*
import kof.json

class ModeracaoApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta meuEstado() {
        return this.cliente.get("/moderation/me")
    }

    Resposta meusRelatos() {
        return this.cliente.get("/moderation/reports")
    }

    Resposta votarDenuncia(String denunciaId, Bool punir, String nota) {
        var voto = "DISMISS"
        if (punir) { voto = "PUNISH" }
        return this.cliente.post("/moderation/reports/" + Cliente.caminho(denunciaId)
            + "/vote", json.encode(mapOf("vote", voto, "note", nota)))
    }

    Resposta propostas(String estado, Int limite) {
        return this.cliente.get("/moderation/sanction-proposals" + Cliente.query(listOf(
            Cliente.par("status", estado),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta votarProposta(String propostaId, String voto) {
        return this.cliente.post("/moderation/sanction-proposals/"
            + Cliente.caminho(propostaId) + "/vote", json.encode(mapOf("vote", voto)))
    }

    Resposta historico(String usuario, Int limite) {
        return this.cliente.get("/admin/moderation/users/" + Cliente.caminho(usuario)
            + "/history" + Cliente.par("limit", Cliente.numero(limite)))
    }

    Resposta advertencias(String usuario) {
        return this.cliente.get("/admin/moderation/users/" + Cliente.caminho(usuario)
            + "/warnings")
    }

    Resposta advertir(String usuario, String motivo) {
        return this.cliente.post("/admin/moderation/users/" + Cliente.caminho(usuario)
            + "/sanction", json.encode(mapOf("type", "WARNING", "reason", motivo)))
    }

    Resposta removerAdvertencia(String advertenciaId) {
        return this.cliente.post("/admin/moderation/warnings/"
            + Cliente.caminho(advertenciaId) + "/revoke", "{}")
    }

    Resposta removerPost(String postId) {
        return this.cliente.post("/admin/moderation/posts/" + Cliente.caminho(postId)
            + "/remove", "{}")
    }

    Resposta candidaturas(String estado, Int limite) {
        return this.cliente.get("/admin/moderator-applications" + Cliente.query(listOf(
            Cliente.par("status", estado),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta aprovarCandidatura(String candidaturaId) {
        return this.cliente.post("/admin/moderator-applications/"
            + Cliente.caminho(candidaturaId) + "/approve", "{}")
    }

    Resposta recusarCandidatura(String candidaturaId) {
        return this.cliente.post("/admin/moderator-applications/"
            + Cliente.caminho(candidaturaId) + "/reject", "{}")
    }

    Resposta emails(Int limite) {
        return this.cliente.get("/admin/emails" + Cliente.par("limit", Cliente.numero(limite)))
    }

    Resposta ipsBloqueados(Int limite) {
        return this.cliente.get("/admin/blocked-ips" + Cliente.par("limit",
            Cliente.numero(limite)))
    }

    Resposta desbloquearIp(String ip) {
        return this.cliente.post("/admin/blocked-ips/" + Cliente.caminho(ip) + "/unblock", "{}")
    }

    static List<DenunciaPainel> painelDe(Resposta r) {
        if (!r.ok()) { return listOf<DenunciaPainel>() }
        try {
            return json.decode<List<DenunciaPainel>>(r.corpo)
        } catch (String e) {
            return listOf<DenunciaPainel>()
        }
    }
}
