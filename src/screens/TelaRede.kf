package screens

import tipos.*
import api.*
import core.Ansi
import core.Cliente
import core.Entrada
import core.Sessao
import core.Tema
import ui.Caixa
import ui.Lista
import ui.Menu

class TelaRede {

    Cliente cliente
    Sessao sessao

    public constructor(Cliente cliente, Sessao sessao) {
        this.cliente = cliente
        this.sessao = sessao
    }

    void executar() {
        var rede = RedeApi(this.cliente)
        var rodando = true
        while (rodando && Entrada.ativa) {
            print(Ansi.LIMPAR)
            println(Menu.topo("Énóis", ""))
            println(Tema.destaque("rede"))
            var escolha = Entrada.menu("conexões",
                listOf("sugestões", "seguidores", "seguindo", "pedidos"), "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == 0) {
                this.sugestoes(rede)
            } else if (escolha == 1) {
                this.lista(rede, "followers", "seguidores")
            } else if (escolha == 2) {
                this.lista(rede, "following", "seguindo")
            } else {
                this.pedidos(rede)
            }
        }
    }

    String rotulo(PessoaRede p) {
        var nome = p.id
        if (p.name != null) { nome = p.name }
        if (p.username != null) { return nome + " @" + p.username }
        return nome
    }

    List<String> rotulos(List<PessoaRede> pessoas) {
        var opcoes = listOf<String>()
        for (var i = 0; i < pessoas.size(); i = i + 1) {
            opcoes.add(this.rotulo(pessoas.get(i)))
        }
        return opcoes
    }

    void sugestoes(RedeApi rede) {
        var r = rede.sugestoes(20)
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var pessoas = RedeApi.listaDe(r)
        if (pessoas.size() == 0) {
            Caixa.desenhar(Caixa.simples(Lista.vazia("sem sugestões agora")))
            Entrada.pausar()
            return
        }
        var escolha = Entrada.menu("sugestões", this.rotulos(pessoas), "voltar")
        if (escolha < 0) { return }
        var pessoa = pessoas.get(escolha)
        var f = rede.conectar(pessoa.id)
        if (f.ok()) {
            println(Tema.ok("pedido enviado para " + this.rotulo(pessoa)))
        } else {
            println(Tema.erro(f.mensagem()))
        }
        Entrada.pausar()
    }

    void lista(RedeApi rede, String tipo, String titulo) {
        if (this.sessao.usuario == null) { return }
        var r = PerfilApi(this.cliente).rede(this.sessao.usuario.usuario, tipo)
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var pessoas = PerfilApi.redeDe(r)
        if (pessoas.size() == 0) {
            Caixa.desenhar(Caixa.simples(Lista.vazia("ninguém aqui")))
            Entrada.pausar()
            return
        }
        var escolha = Entrada.menu(titulo, this.rotulos(pessoas), "voltar")
        if (escolha < 0) { return }
        this.pessoa(rede, pessoas.get(escolha))
    }

    void pedidos(RedeApi rede) {
        var r = rede.pedidosPendentes(null, 20)
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var pedidos = RedeApi.pedidosDe(r)
        var pessoas = listOf<PessoaRede>()
        var opcoes = listOf<String>()
        for (var i = 0; i < pedidos.size(); i = i + 1) {
            var peer = pedidos.get(i).peer
            if (peer != null) {
                pessoas.add(peer)
                opcoes.add(this.rotulo(peer))
            }
        }
        if (pessoas.size() == 0) {
            Caixa.desenhar(Caixa.simples(Lista.vazia("nenhum pedido pendente")))
            Entrada.pausar()
            return
        }
        var escolha = Entrada.menu("pedidos", opcoes, "voltar")
        if (escolha < 0) { return }
        var pessoa = pessoas.get(escolha)
        var f = rede.aceitar(pessoa.id)
        if (f.ok()) {
            println(Tema.ok("conexão aceita com " + this.rotulo(pessoa)))
        } else {
            println(Tema.erro(f.mensagem()))
        }
        Entrada.pausar()
    }

    void pessoa(RedeApi rede, PessoaRede p) {
        var opcoes = listOf("conectar", "deixar de seguir", "silenciar", "dessilenciar",
            "bloquear", "desbloquear")
        var escolha = Entrada.menu(this.rotulo(p), opcoes, "voltar")
        if (escolha < 0) { return }
        var acao = opcoes.get(escolha)
        var f = rede.silenciar(p.id)
        if (acao == "conectar") { f = rede.conectar(p.id) }
        if (acao == "deixar de seguir") { f = rede.desconectar(p.id) }
        if (acao == "dessilenciar") { f = rede.dessilenciar(p.id) }
        if (acao == "bloquear") { f = rede.bloquear(p.id) }
        if (acao == "desbloquear") { f = rede.desbloquear(p.id) }
        if (f.ok()) {
            println(Tema.ok(acao + ": " + this.rotulo(p)))
        } else {
            println(Tema.erro(f.mensagem()))
        }
        Entrada.pausar()
    }
}
