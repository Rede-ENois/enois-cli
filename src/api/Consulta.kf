package api

import java.net.URLEncoder

class Consulta {

    static String par(String chave, String? valor) {
        if (valor == null) { return "" }
        if (valor.length == 0) { return "" }
        return URLEncoder.encode(chave, "UTF-8") + "=" + URLEncoder.encode(valor, "UTF-8")
    }

    static String numero(Int valor) {
        return String.valueOf(valor)
    }

    static String query(List<String> pares) {
        var fora = ""
        for (var p in pares) {
            if (p.length == 0) { continue }
            if (fora.length > 0) { fora = fora + "&" }
            fora = fora + p
        }
        if (fora.length == 0) { return "" }
        return "?" + fora
    }

    static String pagina(String? cursor, Int limite) {
        return Consulta.query(listOf(
            Consulta.par("cursor", cursor),
            Consulta.par("limit", Consulta.numero(limite))))
    }
}
