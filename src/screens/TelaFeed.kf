package screens

import tipos.*
import api.*
import core.*
import ui.*

class TelaFeed {

    Cliente cliente
    String contexto
    Teclado teclado
    Vista vista
    List<PostResumo> posts = listOf<PostResumo>()
    String proximo = ""
    Bool temMais = false
    String erro = ""
    String status = ""
    String destino = ""
    Int larguraCartoes = 0
    ContagensNavegacao contagens
    SinaisApi sinaisApi

    public constructor(Cliente cliente) {
        this.cliente = cliente
        this.contexto = "social"
        this.sinaisApi = SinaisApi(cliente)
        this.contagens = ContagensNavegacao(null, listOf<String>(), 0, 0)
    }

    public constructor(Cliente cliente, String contexto) {
        this.cliente = cliente
        this.contexto = contexto
        this.sinaisApi = SinaisApi(cliente)
        this.contagens = ContagensNavegacao(null, listOf<String>(), 0, 0)
    }

    Bool corporativo() {
        return this.contexto == "profissional"
    }

    String contextoDoServidor() {
        if (this.contexto == "profissional") { return "PROFESSIONAL" }
        return "SOCIAL"
    }

    Resposta carregar(String cursor, Int limite) {
        if (this.corporativo()) { return FeedApi(this.cliente).corporativo(cursor, limite) }
        return FeedApi(this.cliente).listar(cursor, limite)
    }

    String executar() {
        var teclado = Teclado()
        if (Teclado.disponivel() && teclado.entrar()) {
            return this.executarInterativo(teclado)
        }
        this.executarSimples()
        return ""
    }

    String executarInterativo(Teclado teclado) {
        this.teclado = teclado
        this.vista = Vista(Vista.alturaPadrao())
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), this.contexto == "social")
        print(Ansi.OCULTAR_CURSOR)
        print(Ansi.ALTERNATIVO)
        this.status = Tema.mudo("carregando…")
        this.carregarPagina("")
        var destino = ""
        var rodando = true
        var pintar = true
        while (rodando && Entrada.ativa) {
            if (this.temMais && this.posts.size() > 0 && this.vista.rolagem.noFim()) {
                this.status = Tema.mudo("carregando mais…")
                this.desenhar()
                this.carregarPagina(this.proximo)
            }
            if (pintar) {
                this.desenhar()
                teclado.ligarMouse()
            }
            pintar = true
            var tecla = teclado.ler()
            if (tecla.nome == "clique") {
                if (!this.clicar(tecla)) { pintar = false }
            } else if (tecla.nome == "cima") {
                this.vista.rolagem.moverFoco(-1)
            } else if (tecla.nome == "baixo") {
                this.vista.rolagem.moverFoco(1)
            } else if (tecla.nome == "roda-cima") {
                this.vista.rolagem.rolar(-3)
            } else if (tecla.nome == "roda-baixo") {
                this.vista.rolagem.rolar(3)
            } else if (tecla.nome == "enter") {
                this.abrirFoco()
            } else if (tecla.nome == "texto") {
                this.destino = this.atalho(tecla.caractere)
            } else if (tecla.nome == "escape" || tecla.nome == "ctrl-c") {
                rodando = false
            } else if (Teclado.inerte(tecla)) {
                pintar = false
            }
            if (this.destino.length > 0) { rodando = false }
        }
        destino = this.destino
        teclado.desligarMouse()
        Ansi.escrever(Ansi.NORMAL)
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        teclado.sair()
        return destino
    }

    String atalho(String caractere) {
        if (caractere == "k") { this.vista.rolagem.moverFoco(-1) }
        if (caractere == "j") { this.vista.rolagem.moverFoco(1) }
        if (caractere == "l" || caractere == "L") { this.curtir() }
        if (caractere == "c" || caractere == "C") { this.comentar() }
        if (caractere == "r" || caractere == "R") { this.recarregar() }
        if (caractere == "m" || caractere == "M") { this.mostrarImagens() }
        var indice = Seletor.digito(caractere)
        if (indice >= 0) {
            var rotas = Navegacao.secoesDe(this.contexto)
            if (indice < rotas.size()) { return rotas.get(indice) }
        }
        return ""
    }

    void executarSimples() {
        var r = this.carregar("", 10)
        var rodando = true
        while (rodando && Entrada.ativa) {
            if (!r.ok()) {
                println(Tema.erro(r.mensagem()))
                Entrada.pausar()
                return
            }
            var pagina = FeedApi.paginaFeed(r)
            var itens = pagina.items
            print(Ansi.LIMPAR)
            println(Menu.topo("Énóis", ""))
            println(Menu.cabecalho(this.titulo(), this.subtitulo()))
            if (itens == null || itens.size() == 0) {
                Caixa.desenhar(Caixa.simples(Lista.vazia(this.vazio())))
                Entrada.pausar()
                return
            }
            for (var i = 0; i < itens.size(); i = i + 1) {
                println(this.card(itens.get(i)))
                this.mostrarImagens(itens.get(i))
            }
            var proximo = ""
            if (pagina.nextCursor != null) { proximo = pagina.nextCursor }
            var opcoes = listOf<String>()
            for (var i = 0; i < itens.size(); i = i + 1) {
                opcoes.add(this.resumo(itens.get(i)))
            }
            if (proximo.length > 0) { opcoes.add("carregar mais") }
            var escolha = Entrada.menu(this.titulo(), opcoes, "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == itens.size()) {
                r = this.carregar(proximo, 10)
            } else {
                TelaPost(this.cliente).executar(itens.get(escolha))
                r = this.carregar("", 10)
            }
        }
    }

    void desenhar() {
        Ansi.medir()
        if (this.larguraCartoes != Ansi.LARGURA_CONTEUDO) { this.reconstruir() }
        var topo = Cabecalho.linha(this.cliente, this.titulo(), this.contexto)
        var cabecalho = Caixa.juntar(BarraSecoes.linhas(this.contexto, "feed", this.contagens))
        this.vista.marcarSecoes(this.contexto, "feed", this.contagens)
        var posicao = ""
        if (this.posts.size() > 0) { posicao = this.vista.posicao() }
        var rodape = Caixa.juntar(BarraContexto.linhas(this.atalhos(), this.status, posicao))
        this.vista.desenhar(topo, cabecalho, rodape)
    }

    List<String> atalhos() {
        var lista = listOf<String>()
        lista.add("↑↓ move")
        lista.add("enter abre")
        lista.add("L curtir")
        lista.add("C comenta")
        lista.add("R atualiza")
        lista.add("q volta")
        lista.add("M mídias")
        lista.add("1–6 seções")
        return lista
    }

    Bool clicar(Tecla tecla) {
        var alvo = this.vista.regioes.em(tecla.linha, tecla.coluna)
        if (alvo.tipo == "secao") {
            this.destino = this.rotaDaSecao(alvo.indice)
            return true
        }
        if (alvo.tipo != "item") { return false }
        this.abrirPost(alvo.indice)
        return true
    }

    String rotaDaSecao(Int indice) {
        var rotas = Navegacao.secoesDe(this.contexto)
        if (indice < 0 || indice >= rotas.size()) { return "" }
        return rotas.get(indice)
    }

    void abrirFoco() {
        var indice = this.vista.rolagem.dadoDoBloco(this.vista.rolagem.foco)
        this.abrirPost(indice)
    }

    void abrirPost(Int indice) {
        if (indice < 0 || indice >= this.posts.size()) { return }
        var post = this.posts.get(indice)
        var destino = TelaPost(this.cliente).executarInterativo(post, this.teclado)
        if (destino.length > 0) { this.destino = destino }
        this.recarregarMantendo(post.id)
    }

    void recarregar() {
        this.posts = listOf<PostResumo>()
        this.proximo = ""
        this.temMais = false
        this.erro = ""
        this.status = Tema.mudo("carregando…")
        this.reconstruir()
        this.carregarPagina("")
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), this.contexto == "social")
    }

    void recarregarMantendo(String id) {
        var foco = this.indiceDoPost(id)
        this.posts = listOf<PostResumo>()
        this.proximo = ""
        this.temMais = false
        this.erro = ""
        this.carregarPagina("")
        if (foco >= 0) {
            this.vista.rolagem.foco = foco
            this.vista.rolagem.alinhar()
        }
    }

    Int indiceDoPost(String id) {
        for (var i = 0; i < this.posts.size(); i = i + 1) {
            if (this.posts.get(i).id == id) { return i }
        }
        return -1
    }

    void carregarPagina(String cursor) {
        var r = this.carregar(cursor, 10)
        if (!r.ok()) {
            this.erro = r.mensagem()
            this.temMais = false
            this.status = Tema.erro(this.erro)
            this.reconstruir()
            return
        }
        var pagina = FeedApi.paginaFeed(r)
        var itens = pagina.items
        if (itens != null) {
            for (var i = 0; i < itens.size(); i = i + 1) {
                this.posts.add(itens.get(i))
            }
        }
        var novo = ""
        if (pagina.nextCursor != null) { novo = pagina.nextCursor }
        if (novo.length == 0 || novo == this.proximo) {
            this.temMais = false
        } else {
            this.proximo = novo
            this.temMais = true
        }
        this.reconstruir()
        if (this.posts.size() > 0) {
            this.status = Tema.mudo(String.valueOf(this.posts.size()) + " publicações")
        } else {
            this.status = ""
        }
    }

    void reconstruir() {
        var deslocamento = this.vista.rolagem.deslocamento
        var foco = this.vista.rolagem.foco
        this.vista = Vista(Vista.alturaPadrao())
        for (var i = 0; i < this.posts.size(); i = i + 1) {
            this.vista.adicionar(i, this.linhasDoPost(this.posts.get(i)))
        }
        if (this.vista.total() == 0) {
            var texto = this.vazio()
            if (this.erro.length > 0) { texto = this.erro + " — tente R" }
            this.vista.adicionar(-1, listOf<String>(" " + Tema.mudo("~ " + texto)))
        }
        this.vista.rolagem.deslocamento = deslocamento
        this.vista.rolagem.foco = foco
        this.larguraCartoes = Ansi.LARGURA_CONTEUDO
    }

    PostResumo postoFoco() {
        var indice = this.vista.rolagem.dadoDoBloco(this.vista.rolagem.foco)
        if (indice < 0 || indice >= this.posts.size()) { return null }
        return this.posts.get(indice)
    }

    void curtir() {
        var p = this.postoFoco()
        if (p == null) { return }
        var reagindo = p.currentUserReaction != null && p.currentUserReaction.length > 0
        var api = ComentariosApi(this.cliente)
        var r = Resposta(0, "", "")
        if (reagindo) {
            r = api.desreagir(p.id)
        } else {
            r = api.reagir(p.id, "LIKE")
        }
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        var reacoes = 0
        var comentarios = 0
        if (p.counters != null) {
            if (p.counters.reactions != null) { reacoes = p.counters.reactions }
            if (p.counters.comments != null) { comentarios = p.counters.comments }
        }
        if (reagindo) {
            if (reacoes > 0) { reacoes = reacoes - 1 }
            this.status = Tema.mudo("reação removida")
            this.atualizar(p, reacoes, comentarios, null)
        } else {
            reacoes = reacoes + 1
            this.status = Tema.ok("curtido")
            this.atualizar(p, reacoes, comentarios, "LIKE")
        }
    }

    void comentar() {
        var p = this.postoFoco()
        if (p == null) { return }
        var texto = this.perguntar("comentário")
        if (texto.length == 0) {
            this.status = Tema.mudo("comentário cancelado")
            return
        }
        var r = ComentariosApi(this.cliente).comentar(p.id, texto, null)
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        var reacoes = 0
        var comentarios = 0
        if (p.counters != null) {
            if (p.counters.reactions != null) { reacoes = p.counters.reactions }
            if (p.counters.comments != null) { comentarios = p.counters.comments }
        }
        this.status = Tema.ok("comentário enviado")
        this.atualizar(p, reacoes, comentarios + 1, p.currentUserReaction)
    }

    void atualizar(PostResumo p, Int reacoes, Int comentarios, String? reacao) {
        var novo = TelaFeed.comContadores(p, reacoes, comentarios, reacao)
        var lista = listOf<PostResumo>()
        for (var i = 0; i < this.posts.size(); i = i + 1) {
            if (this.posts.get(i).id == p.id) {
                lista.add(novo)
            } else {
                lista.add(this.posts.get(i))
            }
        }
        this.posts = lista
        this.reconstruir()
    }

    static PostResumo comContadores(PostResumo p, Int reacoes, Int comentarios, String? reacao) {
        var salvos = 0
        var compartilhados = 0
        var republicados = 0
        if (p.counters != null) {
            if (p.counters.saves != null) { salvos = p.counters.saves }
            if (p.counters.shares != null) { compartilhados = p.counters.shares }
            if (p.counters.reposts != null) { republicados = p.counters.reposts }
        }
        var contadores = Contadores(reacoes, comentarios, salvos, compartilhados, republicados)
        return PostResumo(p.id, p.type, p.content, p.createdAt, p.authorId, p.authorName,
            p.authorUsername, p.authorAvatar, p.authorBadge, p.authorHeadline, p.tags,
            contadores, reacao, p.communityId, p.repostOf, p.repostOfAuthor, p.repostOfContent,
            p.repostWithOpinion, p.poll, p.currentUserReposted, p.acceptedCommentId, p.topic,
            p.editedAt, p.media)
    }

    String perguntar(String rotulo) {
        this.teclado.sair()
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        var texto = Entrada.texto(rotulo)
        Ansi.escrever(Ansi.OCULTAR_CURSOR)
        this.teclado.entrar()
        return texto
    }

    void mostrarImagens() {
        var p = this.postoFoco()
        if (p == null) { return }
        if (Cartao.totalImagens(p) == 0) {
            this.status = Tema.mudo("este post não tem mídias")
            return
        }
        this.teclado.sair()
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        print(Ansi.NORMAL)
        print(Ansi.LIMPAR)
        this.imprimirImagens(p)
        Entrada.pausar()
        print(Ansi.ALTERNATIVO)
        Ansi.escrever(Ansi.OCULTAR_CURSOR)
        this.teclado.entrar()
    }

    void imprimirImagens(PostResumo p) {
        var anexos = p.media
        if (anexos == null) { return }
        for (var i = 0; i < anexos.size(); i = i + 1) {
            var anexo = anexos.get(i)
            if (!Imagem.eImagem(anexo.mimeType)) { continue }
            var url = ""
            if (anexo.cdnUrl != null) { url = Midia.url(anexo.cdnUrl) }
            if (url.length == 0) { continue }
            Imagem.mostrar(url, Imagem.COLUNAS_AVATAR)
        }
    }

    void mostrarImagens(PostResumo p) {
        this.imprimirImagens(p)
    }

    String titulo() {
        if (this.corporativo()) { return "feed profissional" }
        return "feed"
    }

    String subtitulo() {
        if (this.corporativo()) { return "o que o lado profissional está publicando" }
        return "o que a rede está postando agora"
    }

    String vazio() {
        if (this.corporativo()) { return "nada no feed profissional por aqui" }
        return "feed vazio — siga alguém pelo Explorar"
    }

    String resumo(PostResumo p) {
        var quem = ""
        if (p.authorName != null) { quem = p.authorName + ": " }
        var trecho = ""
        if (p.content != null) { trecho = p.content }
        if (trecho.length > 48) { trecho = trecho.substring(0, 48) + "…" }
        if (trecho.length == 0) { trecho = "(mídia)" }
        return quem + trecho
    }

    List<String> linhasDoPost(PostResumo p) {
        return Cartao.linhas(p, Ansi.LARGURA_CONTEUDO, Cartao.usuarioAtual(this.cliente))
    }

    String card(PostResumo p) {
        return Caixa.juntar(this.linhasDoPost(p))
    }

    Int totalImagens(PostResumo p) {
        return Cartao.totalImagens(p)
    }

    static String tipoEmTexto(String tipo) {
        return Cartao.tipoEmTexto(tipo)
    }
}
