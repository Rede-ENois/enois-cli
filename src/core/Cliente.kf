package core

import java.net.URLEncoder
import kof.json

class Cliente {

    Config config
    Sessao sessao
    Bool sessaoPerdida

    public constructor(Config config, Sessao sessao) {
        this.config = config
        this.sessao = sessao
        this.sessaoPerdida = false
    }

    String cabecalhosBase() {
        return "Accept: application/json\n"
            + "X-Client-Origin: " + this.config.origem
    }

    String cabecalhos(String metodo, String chaveIdempotencia) {
        var h = this.cabecalhosBase()
        if (this.sessao.logado()) {
            h = h + "\nX-Session-Token: " + this.sessao.token
        }
        if (Cliente.escreve(metodo)) {
            h = h + "\nX-CSRF-Protection: 1\nContent-Type: application/json"
            if (chaveIdempotencia.length > 0) {
                h = h + "\nIdempotency-Key: " + chaveIdempotencia
            }
        }
        return h
    }

    static Bool escreve(String metodo) {
        return metodo == "POST" || metodo == "PUT" || metodo == "PATCH" || metodo == "DELETE"
    }

    String url(String caminho) {
        var c = caminho
        if (c.startsWith("/")) { c = c.substring(1) }
        return this.config.urlApi + "/" + c
    }

    Resposta get(String caminho) {
        return this.enviar("GET", caminho, "", false)
    }

    Resposta post(String caminho, String corpoJson) {
        return this.enviar("POST", caminho, corpoJson, true)
    }

    Resposta put(String caminho, String corpoJson) {
        return this.enviar("PUT", caminho, corpoJson, true)
    }

    Resposta patch(String caminho, String corpoJson) {
        return this.enviar("PATCH", caminho, corpoJson, true)
    }

    Resposta delete(String caminho) {
        return this.enviar("DELETE", caminho, "", true)
    }

    Resposta enviar(String metodo, String caminho, String corpo, Bool escrita) {
        var chave = ""
        if (escrita) { chave = uuid.v4() }
        var r = this.disparar(metodo, caminho, corpo, chave)
        if (r.codigo == 401 && this.sessao.logado()) {
            var renovou = false
            if (this.sessao.renova.length > 0) { renovou = this.renovar() }
            if (renovou) {
                r = this.disparar(metodo, caminho, corpo, chave)
            }
            if (r.codigo == 401) { this.perderSessao() }
        }
        return r
    }

    void perderSessao() {
        this.sessao.limpar()
        this.sessaoPerdida = true
    }

    Resposta disparar(String metodo, String caminho, String corpo, String chaveIdempotencia) {
        http.timeout(15)
        http.retry(1)
        try {
            var res = http.send(metodo, this.url(caminho), corpo,
                this.cabecalhos(metodo, chaveIdempotencia))
            return Resposta(res.status(), res.body(), res.headers())
        } catch (String e) {
            return Resposta(0, "{\"code\":\"REDE\",\"message\":\"falha de rede: " + e + "\"}", "")
        }
    }

    Bool renovar() {
        if (this.sessao.renova.length == 0) { return false }
        var corpo = json.encode(mapOf("refreshToken", this.sessao.renova))
        try {
            var res = http.send("POST", this.url("/auth/refresh"), corpo,
                "Accept: application/json\nContent-Type: application/json\n"
                + "X-Client-Origin: " + this.config.origem)
            if (res.status() == 401 || res.status() == 403) {
                this.perderSessao()
                return false
            }
            if (res.status() != 200) { return false }
            var nova = Sessao.deResposta(res.headers())
            if (nova.token.length == 0) {
                this.perderSessao()
                return false
            }
            this.sessao.token = nova.token
            if (nova.renova.length > 0) { this.sessao.renova = nova.renova }
            this.sessao.salvar()
            return true
        } catch (String e) {
            return false
        }
    }

    String entrar(String email, String senha) {
        var corpo = json.encode(mapOf("email", email, "password", senha))
        var r = this.disparar("POST", "/auth/login", corpo, "")
        if (r.codigo == 202) {
            var m = r.comoMapa()
            var desafio = Json.texto(m, "challengeId")
            var metodo = Json.texto(m, "method")
            return "2fa:" + desafio + ":" + metodo
        }
        if (r.ok()) {
            var m = r.comoMapa()
            if (Json.logico(m, "passwordExpired")) {
                return "senha-expirada:" + Json.texto(m, "resetToken")
            }
        }
        if (!r.ok()) { return "erro:" + r.mensagem() }
        var nova = Sessao.deResposta(r.headersComoTexto())
        if (nova.token.length == 0) { return "erro:servidor não devolveu a sessão" }
        this.sessao.token = nova.token
        this.sessao.renova = nova.renova
        this.carregarEu()
        this.sessao.salvar()
        return "ok"
    }

    String verificar2fa(String challengeId, String codigo) {
        var corpo = json.encode(mapOf("challengeId", challengeId, "code", codigo))
        var r = this.disparar("POST", "/auth/2fa/verify", corpo, "")
        if (!r.ok()) { return "erro:" + r.mensagem() }
        var nova = Sessao.deResposta(r.headersComoTexto())
        if (nova.token.length == 0) { return "erro:servidor não devolveu a sessão" }
        this.sessao.token = nova.token
        this.sessao.renova = nova.renova
        this.carregarEu()
        this.sessao.salvar()
        return "ok"
    }

    String redefinirSenha(String resetToken, String senha) {
        var corpo = json.encode(mapOf("token", resetToken, "password", senha))
        var r = this.enviar("POST", "/auth/password/reset", corpo, true)
        if (!r.ok()) { return "erro:" + r.mensagem() }
        var nova = Sessao.deResposta(r.headersComoTexto())
        if (nova.token.length > 0) {
            this.sessao.token = nova.token
            this.sessao.renova = nova.renova
            this.carregarEu()
            this.sessao.salvar()
            return "ok"
        }
        return "ok"
    }

    void carregarEu() {
        var r = this.get("/auth/me")
        if (!r.ok()) { return }
        var m = r.comoMapa()
        var nome = Json.texto(m, "name")
        var login = Json.texto(m, "username")
        var email = Json.texto(m, "email")
        var id = Json.texto(m, "id")
        var avatar = this.avatar()
        var faisca = this.saldo()
        this.sessao.usuario = Usuario(id, nome, login, email, avatar, faisca)
    }

    String avatar() {
        var r = this.get("/me")
        if (!r.ok()) { return "" }
        return Json.texto(r.comoMapa(), "avatar")
    }

    Int saldo() {
        var r = this.get("/carteira")
        if (!r.ok()) { return 0 }
        return Json.numero(r.comoMapa(), "balance")
    }

    Bool sessaoValida() {
        if (!this.sessao.logado()) { return false }
        var r = this.get("/auth/me")
        if (!r.ok()) { return false }
        this.carregarEu()
        this.sessao.salvar()
        return true
    }

    Bool sair() {
        var r = this.disparar("POST", "/auth/logout", "{}", uuid.v4())
        if (r.ok()) {
            this.sessao.limpar()
            return true
        }
        if (r.codigo == 401) {
            this.sessao.limpar()
            return true
        }
        return false
    }

    static String par(String chave, String? valor) {
        if (valor == null) { return "" }
        if (valor.length == 0) { return "" }
        return URLEncoder.encode(chave, "UTF-8") + "=" + URLEncoder.encode(valor, "UTF-8")
    }

    static String numero(Int valor) {
        return String.valueOf(valor)
    }

    static String query(List<String> pares) {
        var fora = ""
        for (var p in pares) {
            if (p.length == 0) { continue }
            var pedaco = p
            if (pedaco.startsWith("?")) { pedaco = pedaco.substring(1) }
            if (pedaco.length == 0) { continue }
            if (fora.length > 0) { fora = fora + "&" }
            fora = fora + pedaco
        }
        if (fora.length == 0) { return "" }
        return "?" + fora
    }

    static String pagina(String? cursor, Int limite) {
        return Cliente.query(listOf(
            Cliente.par("cursor", cursor),
            Cliente.par("limit", Cliente.numero(limite))))
    }

    static String caminho(String? bruto) {
        if (bruto == null) { return "" }
        return URLEncoder.encode(bruto, "UTF-8")
    }
}
