package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class EventosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? formato, String? cursor, Int limite, String? recorrente) {
        return this.cliente.get("/events" + Cliente.query(listOf(
            Cliente.par("format", formato),
            Cliente.par("cursor", cursor),
            Cliente.par("limit", Cliente.numero(limite)),
            Cliente.par("recurring", recorrente))))
    }

    Resposta obter(String eventoId) {
        return this.cliente.get("/events/" + Cliente.caminho(eventoId))
    }

    Resposta criar(String titulo, String data, String hora, String formato) {
        return this.cliente.post("/events",
            json.encode(mapOf("title", titulo, "date", data, "time", hora, "format", formato)))
    }

    Resposta editar(String eventoId, String titulo, String data, String hora) {
        return this.cliente.patch("/events/" + Cliente.caminho(eventoId),
            json.encode(mapOf("title", titulo, "date", data, "time", hora)))
    }

    Resposta apagar(String eventoId) {
        return this.cliente.delete("/events/" + Cliente.caminho(eventoId))
    }

    Resposta participar(String eventoId) {
        return this.cliente.post("/events/" + Cliente.caminho(eventoId) + "/attendees", "{}")
    }

    Resposta cancelarPresenca(String eventoId) {
        return this.cliente.delete("/events/" + Cliente.caminho(eventoId) + "/attendees")
    }

    Resposta recorrencia(String eventoId, String recorrencia) {
        return this.cliente.patch("/events/" + Cliente.caminho(eventoId) + "/recurrence",
            json.encode(mapOf("recurrence", recorrencia)))
    }

    static Evento unico(Resposta r) {
        var vazio = Evento("", null, null, null, null, null, null, null, null, null,
            null, null, null, null, null, null, null, null)
        if (!r.ok()) { return vazio }
        try {
            return json.decode<Evento>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }

    static PaginaEventos pagina(Resposta r) {
        if (!r.ok()) { return PaginaEventos(listOf<Evento>(), null) }
        try {
            return json.decode<PaginaEventos>(r.corpo)
        } catch (String e) {
            return PaginaEventos(listOf<Evento>(), null)
        }
    }
}
