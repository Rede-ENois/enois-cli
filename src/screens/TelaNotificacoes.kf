package screens

import tipos.*
import api.*
import core.Ansi
import core.Cliente
import core.Entrada
import core.Sessao
import core.Teclado
import core.Tema
import ui.Caixa
import ui.Lista
import ui.Menu
import ui.Vista

class TelaNotificacoes {

    Cliente cliente
    Sessao sessao
    String contexto
    Vista vista
    Teclado teclado
    List<Notificacao> notificacoes = listOf<Notificacao>()
    List<Bool> lidas = listOf<Bool>()
    String proximo = ""
    Bool temMais = false
    String erro = ""

    public constructor(Cliente cliente) {
        this.cliente = cliente
        this.sessao = Sessao()
        this.contexto = "social"
    }

    public constructor(Cliente cliente, String contexto) {
        this.cliente = cliente
        this.sessao = Sessao()
        this.contexto = contexto
    }

    public constructor(Cliente cliente, Sessao sessao, String contexto) {
        this.cliente = cliente
        this.sessao = sessao
        this.contexto = contexto
    }

    String contextoDoServidor() {
        if (this.contexto == "profissional") { return "PROFESSIONAL" }
        return "SOCIAL"
    }

    void executar() {
        var teclado = Teclado()
        if (Teclado.disponivel() && teclado.entrar()) {
            this.executarInterativo(teclado)
            return
        }
        this.executarSimples()
    }

    void executarInterativo(Teclado teclado) {
        this.teclado = teclado
        this.vista = Vista(Vista.alturaPadrao())
        print(Ansi.OCULTAR_CURSOR)
        print(Ansi.ALTERNATIVO)
        println("")
        this.carregarPagina("")
        var rodando = true
        while (rodando && Entrada.ativa) {
            if (this.temMais && this.notificacoes.size() > 0 && this.vista.rolagem.noFim()) {
                this.carregarPagina(this.proximo)
            }
            this.desenhar()
            teclado.ligarMouse()
            var tecla = teclado.ler()
            if (tecla.nome == "clique") {
                this.clicar(tecla)
            } else if (tecla.nome == "cima") {
                this.vista.rolagem.moverFoco(-1)
            } else if (tecla.nome == "baixo") {
                this.vista.rolagem.moverFoco(1)
            } else if (tecla.nome == "roda-cima") {
                this.vista.rolagem.rolar(-3)
            } else if (tecla.nome == "roda-baixo") {
                this.vista.rolagem.rolar(3)
            } else if (tecla.nome == "enter") {
                this.abrirFoco()
            } else if (tecla.nome == "texto") {
                if (tecla.caractere == "k") {
                    this.vista.rolagem.moverFoco(-1)
                } else if (tecla.caractere == "j") {
                    this.vista.rolagem.moverFoco(1)
                } else if (tecla.caractere == "r") {
                    this.recarregar()
                } else if (tecla.caractere == "m") {
                    this.marcarTodas()
                } else if (tecla.caractere == "q") {
                    rodando = false
                }
            } else if (tecla.nome == "escape" || tecla.nome == "ctrl-c") {
                rodando = false
            }
        }
        teclado.desligarMouse()
        Ansi.escrever(Ansi.NORMAL)
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        teclado.sair()
    }

    void executarSimples() {
        var cursor = ""
        var temMais = true
        while (temMais) {
            var r = NotificacoesApi(this.cliente).listar(cursor, 20, this.contextoDoServidor())
            if (!r.ok()) {
                println(Tema.erro(r.mensagem()))
                Entrada.pausar()
                return
            }
            var pagina = NotificacoesApi.pagina(r)
            var itens = pagina.items
            print(Ansi.LIMPAR)
            println(Menu.topo("Énóis", ""))
            println(Tema.destaque("notificações"))
            if (itens == null || itens.size() == 0) {
                println(Caixa.simples(Lista.vazia("nenhuma notificação")))
                Entrada.pausar()
                return
            }
            for (var i = 0; i < itens.size(); i = i + 1) {
                println(this.linha(itens.get(i)))
            }
            if (Entrada.ativa) { Entrada.pausar() }
            var proximo = ""
            if (pagina.nextCursor != null) { proximo = pagina.nextCursor }
            if (proximo.length == 0) {
                temMais = false
            } else {
                temMais = Entrada.confirmar("carregar mais")
                if (temMais) { cursor = proximo }
            }
        }
    }

    void desenhar() {
        this.vista.desenhar(
            Menu.topo("Énóis", ""),
            Menu.cabecalho("notificações", this.subtitulo()),
            Menu.rodape("↑↓ move · roda rola · clique abre · enter abre · m marca todas · r recarrega · q volta"))
    }

    String subtitulo() {
        if (this.contexto == "profissional") { return "o que chegou no lado profissional" }
        return "o que chegou na sua rede"
    }

    void clicar(Tecla tecla) {
        var alvo = this.vista.regioes.em(tecla.linha, tecla.coluna)
        if (alvo.tipo != "item") { return }
        this.abrirNotificacao(alvo.indice)
    }

    void abrirFoco() {
        var indice = this.vista.rolagem.dadoDoBloco(this.vista.rolagem.foco)
        this.abrirNotificacao(indice)
    }

    void abrirNotificacao(Int indice) {
        if (indice < 0 || indice >= this.notificacoes.size()) { return }
        var n = this.notificacoes.get(indice)
        if (!this.lidas.get(indice)) {
            NotificacoesApi(this.cliente).marcarLida(n.id)
            this.marcarLida(indice)
        }
        var href = ""
        if (n.href != null) { href = n.href }
        if (href.length == 0) { return }
        Destino(this.cliente, this.sessao, this.contexto).abrir(href)
        this.teclado.limpar()
    }

    void marcarLida(Int indice) {
        var nova = listOf<Bool>()
        for (var i = 0; i < this.lidas.size(); i = i + 1) {
            if (i == indice) {
                nova.add(true)
            } else {
                nova.add(this.lidas.get(i))
            }
        }
        this.lidas = nova
        this.reconstruir()
    }

    void marcarTodas() {
        NotificacoesApi(this.cliente).marcarTodasLidas()
        var nova = listOf<Bool>()
        for (var i = 0; i < this.lidas.size(); i = i + 1) {
            nova.add(true)
        }
        this.lidas = nova
        this.reconstruir()
    }

    void recarregar() {
        this.notificacoes = listOf<Notificacao>()
        this.lidas = listOf<Bool>()
        this.proximo = ""
        this.temMais = false
        this.erro = ""
        this.vista = Vista(Vista.alturaPadrao())
        this.carregarPagina("")
    }

    void reconstruir() {
        var deslocamento = this.vista.rolagem.deslocamento
        var foco = this.vista.rolagem.foco
        this.vista = Vista(Vista.alturaPadrao())
        for (var i = 0; i < this.notificacoes.size(); i = i + 1) {
            this.vista.adicionar(i, this.linhasDe(this.notificacoes.get(i), this.lidas.get(i)))
        }
        this.vista.rolagem.deslocamento = deslocamento
        this.vista.rolagem.foco = foco
    }

    void carregarPagina(String cursor) {
        var r = NotificacoesApi(this.cliente).listar(cursor, 20, this.contextoDoServidor())
        if (!r.ok()) {
            this.erro = r.mensagem()
            this.temMais = false
            this.estadoVazio()
            return
        }
        var pagina = NotificacoesApi.pagina(r)
        var itens = pagina.items
        if (itens != null) {
            for (var i = 0; i < itens.size(); i = i + 1) {
                var n = itens.get(i)
                var lida = "" + n.read == "true"
                this.notificacoes.add(n)
                this.lidas.add(lida)
                this.vista.adicionar(this.notificacoes.size() - 1, this.linhasDe(n, lida))
            }
        }
        var novo = ""
        if (pagina.nextCursor != null) { novo = pagina.nextCursor }
        if (novo.length == 0 || novo == this.proximo) {
            this.temMais = false
        } else {
            this.proximo = novo
            this.temMais = true
        }
        this.estadoVazio()
    }

    void estadoVazio() {
        if (this.vista.total() > 0) { return }
        var texto = "nenhuma notificação"
        if (this.erro.length > 0) { texto = this.erro }
        this.vista.adicionar(-1, Caixa.simples(Lista.vazia(texto)))
    }

    String linha(Notificacao n) {
        var titulo = "notificação"
        if (n.title != null) { titulo = n.title }
        var detalhe = ""
        if (n.preview != null) {
            detalhe = " — " + n.preview
        } else if (n.body != null) {
            detalhe = " — " + n.body
        }
        var texto = titulo + detalhe
        if ("" + n.read == "true") {
            return Tema.mudo("· " + texto)
        }
        return "● " + Tema.texto(texto)
    }

    List<String> linhasDe(Notificacao n, Bool lida) {
        var titulo = "notificação"
        if (n.title != null) { titulo = n.title }
        var marca = "· "
        if (!lida) { marca = "● " }
        var primeira = marca + Tema.texto(titulo)
        var detalhe = ""
        if (n.preview != null) { detalhe = n.preview }
        if (detalhe.length == 0 && n.body != null) { detalhe = n.body }
        var segunda = ""
        if (detalhe.length > 0) {
            segunda = "  " + Tema.mudo(Ansi.cortar(detalhe, Ansi.LARGURA_CONTEUDO - 6))
        }
        var modulo = ""
        if (n.module != null) { modulo = n.module }
        if (modulo.length > 0) {
            if (segunda.length > 0) { segunda = segunda + " " }
            segunda = segunda + Tema.suave(modulo)
        }
        var linhas = listOf<String>()
        linhas.add(primeira)
        linhas.add(segunda)
        return linhas
    }
}
