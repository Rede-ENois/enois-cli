package screens

import tipos.*
import api.*
import core.*
import ui.Caixa
import ui.Imagem
import ui.Lista
import ui.Menu
import ui.Vista

class TelaFeed {

    Cliente cliente
    String contexto
    Vista vista
    List<PostResumo> posts = listOf<PostResumo>()
    String proximo = ""
    Bool temMais = false
    String erro = ""

    public constructor(Cliente cliente) {
        this.cliente = cliente
        this.contexto = "social"
    }

    public constructor(Cliente cliente, String contexto) {
        this.cliente = cliente
        this.contexto = contexto
    }

    Bool corporativo() {
        return this.contexto == "profissional"
    }

    Resposta carregar(String cursor, Int limite) {
        if (this.corporativo()) { return FeedApi(this.cliente).corporativo(cursor, limite) }
        return FeedApi(this.cliente).listar(cursor, limite)
    }

    void executar() {
        var teclado = Teclado()
        if (Teclado.disponivel() && teclado.entrar()) {
            this.executarInterativo(teclado)
            return
        }
        this.executarSimples()
    }

    void executarInterativo(Teclado teclado) {
        this.vista = Vista(Vista.alturaPadrao())
        print(Ansi.OCULTAR_CURSOR)
        print(Ansi.ALTERNATIVO)
        println("")
        this.carregarPagina("")
        var rodando = true
        while (rodando && Entrada.ativa) {
            if (this.temMais && this.posts.size() > 0 && this.vista.rolagem.noFim()) {
                this.carregarPagina(this.proximo)
            }
            this.desenhar()
            teclado.ligarMouse()
            var tecla = teclado.ler()
            if (tecla.nome == "clique") {
                this.clicar(tecla)
            } else if (tecla.nome == "cima") {
                this.vista.rolagem.moverFoco(-1)
            } else if (tecla.nome == "baixo") {
                this.vista.rolagem.moverFoco(1)
            } else if (tecla.nome == "roda-cima") {
                this.vista.rolagem.rolar(-3)
            } else if (tecla.nome == "roda-baixo") {
                this.vista.rolagem.rolar(3)
            } else if (tecla.nome == "enter") {
                this.abrirFoco()
            } else if (tecla.nome == "texto") {
                if (tecla.caractere == "k") {
                    this.vista.rolagem.moverFoco(-1)
                } else if (tecla.caractere == "j") {
                    this.vista.rolagem.moverFoco(1)
                } else if (tecla.caractere == "r") {
                    this.recarregar()
                } else if (tecla.caractere == "q") {
                    rodando = false
                }
            } else if (tecla.nome == "escape" || tecla.nome == "ctrl-c") {
                rodando = false
            }
        }
        teclado.desligarMouse()
        Ansi.escrever(Ansi.NORMAL)
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        teclado.sair()
    }

    void executarSimples() {
        var r = this.carregar("", 10)
        var rodando = true
        while (rodando && Entrada.ativa) {
            if (!r.ok()) {
                println(Tema.erro(r.mensagem()))
                Entrada.pausar()
                return
            }
            var pagina = FeedApi.paginaFeed(r)
            var itens = pagina.items
            print(Ansi.LIMPAR)
            println(Menu.topo("Énóis", ""))
            println(Menu.cabecalho(this.titulo(), this.subtitulo()))
            if (itens == null || itens.size() == 0) {
                println(Caixa.simples(Lista.vazia(this.vazio())))
                Entrada.pausar()
                return
            }
            for (var i = 0; i < itens.size(); i = i + 1) {
                println(this.card(itens.get(i)))
                this.mostrarImagens(itens.get(i))
            }
            var proximo = ""
            if (pagina.nextCursor != null) { proximo = pagina.nextCursor }
            var opcoes = listOf<String>()
            for (var i = 0; i < itens.size(); i = i + 1) {
                opcoes.add(this.resumo(itens.get(i)))
            }
            if (proximo.length > 0) { opcoes.add("carregar mais") }
            var escolha = Entrada.menu(this.titulo(), opcoes, "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == itens.size()) {
                r = this.carregar(proximo, 10)
            } else {
                TelaPost(this.cliente).executar(itens.get(escolha))
                r = this.carregar("", 10)
            }
        }
    }

    void desenhar() {
        this.vista.desenhar(
            Menu.topo("Énóis", ""),
            Menu.cabecalho(this.titulo(), this.subtitulo()),
            Menu.rodape("↑↓ move · roda rola · clique abre · enter abre · r recarrega · q volta"))
    }

    void clicar(Tecla tecla) {
        var alvo = this.vista.regioes.em(tecla.linha, tecla.coluna)
        if (alvo.tipo != "item") { return }
        this.abrirPost(alvo.indice)
    }

    void abrirFoco() {
        var indice = this.vista.rolagem.dadoDoBloco(this.vista.rolagem.foco)
        this.abrirPost(indice)
    }

    void abrirPost(Int indice) {
        if (indice < 0 || indice >= this.posts.size()) { return }
        TelaPost(this.cliente).executar(this.posts.get(indice))
    }

    void recarregar() {
        this.posts = listOf<PostResumo>()
        this.proximo = ""
        this.temMais = false
        this.erro = ""
        this.vista = Vista(Vista.alturaPadrao())
        this.carregarPagina("")
    }

    void carregarPagina(String cursor) {
        var r = this.carregar(cursor, 10)
        if (!r.ok()) {
            this.erro = r.mensagem()
            this.temMais = false
            this.estadoVazio()
            return
        }
        var pagina = FeedApi.paginaFeed(r)
        var itens = pagina.items
        if (itens != null) {
            for (var i = 0; i < itens.size(); i = i + 1) {
                var post = itens.get(i)
                this.posts.add(post)
                this.vista.adicionar(this.posts.size() - 1, this.linhasDoPost(post))
            }
        }
        var novo = ""
        if (pagina.nextCursor != null) { novo = pagina.nextCursor }
        if (novo.length == 0 || novo == this.proximo) {
            this.temMais = false
        } else {
            this.proximo = novo
            this.temMais = true
        }
        this.estadoVazio()
    }

    void estadoVazio() {
        if (this.vista.total() > 0) { return }
        var texto = this.vazio()
        if (this.erro.length > 0) { texto = this.erro }
        this.vista.adicionar(-1, Caixa.simples(Lista.vazia(texto)))
    }

    String titulo() {
        if (this.corporativo()) { return "feed profissional" }
        return "feed"
    }

    String subtitulo() {
        if (this.corporativo()) { return "o que o lado profissional está publicando" }
        return "o que a rede está postando agora"
    }

    String vazio() {
        if (this.corporativo()) { return "nada no feed profissional por aqui" }
        return "feed vazio — siga alguém pelo Explorar"
    }

    String resumo(PostResumo p) {
        var quem = ""
        if (p.authorName != null) { quem = p.authorName + ": " }
        var trecho = ""
        if (p.content != null) { trecho = p.content }
        if (trecho.length > 48) { trecho = trecho.substring(0, 48) + "…" }
        if (trecho.length == 0) { trecho = "(mídia)" }
        return quem + trecho
    }

    List<String> linhasDoPost(PostResumo p) {
        var conteudo = this.linhaAutor(p)
        var corpo = this.corpo(p)
        if (corpo.length > 0) { conteudo = conteudo + "\n" + corpo }
        var midias = this.totalImagens(p)
        if (midias > 0) {
            var rotulo = " mídias"
            if (midias == 1) { rotulo = " mídia" }
            conteudo = conteudo + "\n" + Tema.mudo("📷 " + String.valueOf(midias) + rotulo)
        }
        conteudo = conteudo + "\n" + this.linhaRodape(p)
        return Caixa.cartao(conteudo)
    }

    String card(PostResumo p) {
        return Caixa.juntar(this.linhasDoPost(p))
    }

    Int totalImagens(PostResumo p) {
        var anexos = p.media
        if (anexos == null) { return 0 }
        var total = 0
        for (var anexo in anexos) {
            if (Imagem.eImagem(anexo.mimeType)) { total = total + 1 }
        }
        return total
    }

    void mostrarImagens(PostResumo p) {
        var anexos = p.media
        if (anexos == null) { return }
        for (var i = 0; i < anexos.size(); i = i + 1) {
            var anexo = anexos.get(i)
            if (!Imagem.eImagem(anexo.mimeType)) { continue }
            var url = ""
            if (anexo.cdnUrl != null) { url = Midia.url(anexo.cdnUrl) }
            if (url.length == 0) { continue }
            Imagem.mostrar(url, Imagem.COLUNAS_AVATAR)
        }
    }

    String corpo(PostResumo p) {
        var corpo = ""
        if (p.content != null) { corpo = p.content }
        if ("" + p.repostWithOpinion == "true" && p.repostOfContent != null) {
            corpo = corpo + "\n" + Tema.mudo("↳ " + p.repostOfContent)
        }
        return corpo
    }

    String linhaAutor(PostResumo p) {
        var nome = ""
        if (p.authorName != null) { nome = p.authorName }
        if (p.authorUsername != null) { nome = nome + " @" + p.authorUsername }
        var extras = ""
        if (p.authorBadge != null && p.authorBadge.length > 0) {
            extras = extras + " · " + p.authorBadge
        }
        if (p.type != null && p.type.length > 0) {
            extras = extras + " · " + Tema.suave(tipoEmTexto(p.type))
        }
        var linha = Tema.destaque(nome + extras)
        if (p.repostOfAuthor != null && p.repostOfAuthor.length > 0) {
            linha = Tema.mudo("↻ @" + p.repostOfAuthor) + "\n" + linha
        }
        return linha
    }

    String linhaRodape(PostResumo p) {
        var reacoes = 0
        var comentarios = 0
        if (p.counters != null) {
            var c = p.counters
            if (c.reactions != null) { reacoes = c.reactions }
            if (c.comments != null) { comentarios = c.comments }
        }
        var rodape = Tema.suave("♥ " + String.valueOf(reacoes) + "   💬 " + String.valueOf(comentarios))
        if (p.poll != null) {
            rodape = rodape + "\n" + this.linhaEnquete(p.poll)
        }
        return rodape
    }

    String linhaEnquete(Enquete e) {
        var opcoes = e.options
        if (opcoes == null || opcoes.size() == 0) { return "" }
        var total = 0
        if (e.totalVotes != null) { total = e.totalVotes }
        var linhas = ""
        for (var i = 0; i < opcoes.size(); i = i + 1) {
            var votos = 0
            if (e.counts != null && i < e.counts.size()) { votos = e.counts.get(i) }
            var fatia = 0
            if (total > 0) { fatia = (votos * 20) / total }
            var barra = ""
            for (var b = 0; b < 20; b = b + 1) {
                if (b < fatia) {
                    barra = barra + "█"
                } else {
                    barra = barra + "░"
                }
            }
            linhas = linhas + Tema.suave(barra + " " + String.valueOf(votos)) + " " + opcoes.get(i) + "\n"
        }
        var resumo = Tema.mudo(String.valueOf(total) + " votos")
        if (linhas.length > 0) { resumo = linhas + resumo }
        return resumo
    }

    static String tipoEmTexto(String tipo) {
        if (tipo == "INSIGHT") { return "insight" }
        if (tipo == "ARTICLE") { return "artigo" }
        if (tipo == "QUESTION") { return "pergunta" }
        if (tipo == "PROJECT") { return "projeto" }
        if (tipo == "OPPORTUNITY") { return "oportunidade" }
        if (tipo == "PAGE") { return "página" }
        if (tipo == "NEWS") { return "notícia" }
        if (tipo == "TUTORIAL") { return "tutorial" }
        if (tipo == "REVIEW") { return "resenha" }
        if (tipo == "BUSINESS") { return "profissional" }
        if (tipo == "DIVERTIDO") { return "divertido" }
        if (tipo == "MOMENT") { return "momento" }
        if (tipo == "INSTANTE") { return "instante" }
        if (tipo == "BLOG") { return "blog" }
        if (tipo == "POLL") { return "enquete" }
        if (tipo == "COMPLAINT") { return "reclamação" }
        return tipo
    }
}
