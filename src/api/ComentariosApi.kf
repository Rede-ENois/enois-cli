package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class ComentariosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String postId, String? cursor, Int limite) {
        return this.cliente.get("/feed/posts/" + Cliente.caminho(postId)
            + "/comments" + Cliente.pagina(cursor, limite))
    }

    Resposta comentar(String postId, String conteudo, String? comentarioPai) {
        return this.cliente.post("/feed/posts/" + Cliente.caminho(postId) + "/comments",
            ComentariosApi.corpoDeComentario(conteudo, comentarioPai, listOf<String>(), false))
    }

    Resposta editar(String postId, String comentarioId, String conteudo, List<String>? mediaIds) {
        var partes = listOf<String>()
        partes.add("\"content\":" + json.encode(conteudo))
        if (mediaIds != null) {
            partes.add("\"mediaIds\":" + ComentariosApi.lista(mediaIds))
        }
        return this.cliente.patch("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId), "{" + PostApi.juntar(partes) + "}")
    }

    Resposta apagar(String postId, String comentarioId) {
        return this.cliente.delete("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId))
    }

    Resposta fixar(String postId, String comentarioId) {
        return this.cliente.post("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId) + "/pin", "{}")
    }

    Resposta desafixar(String postId, String comentarioId) {
        return this.cliente.delete("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId) + "/pin")
    }

    Resposta reagirComentario(String postId, String comentarioId, String tipo) {
        return this.cliente.post("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId) + "/reactions",
            json.encode(mapOf("type", tipo)))
    }

    Resposta desreagirComentario(String postId, String comentarioId) {
        return this.cliente.delete("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId) + "/reactions")
    }

    Resposta reacoesDoComentario(String postId, String comentarioId) {
        return this.cliente.get("/feed/posts/" + Cliente.caminho(postId)
            + "/comments/" + Cliente.caminho(comentarioId) + "/reactions")
    }

    static String corpoDeComentario(String conteudo, String? comentarioPai, List<String> mediaIds, Bool spoiler) {
        var partes = listOf<String>()
        partes.add("\"content\":" + json.encode(conteudo))
        if (comentarioPai != null) {
            partes.add("\"parentCommentId\":" + json.encode(comentarioPai))
        } else {
            partes.add("\"parentCommentId\":null")
        }
        partes.add("\"mediaIds\":" + ComentariosApi.lista(mediaIds))
        partes.add("\"mentionedUserIds\":[]")
        partes.add("\"website\":\"\"")
        if (spoiler) {
            partes.add("\"mediaSpoiler\":true")
        } else {
            partes.add("\"mediaSpoiler\":false")
        }
        return "{" + PostApi.juntar(partes) + "}"
    }

    static String lista(List<String>? itens) {
        if (itens == null) { return "[]" }
        return json.encode(itens)
    }

    static Comentario? criado(Resposta resposta) {
        if (resposta.codigo != 201) { return null }
        try {
            return json.decode<Comentario>(resposta.corpo)
        } catch (String e) {
            return null
        }
    }

    static EdicaoComentario edicao(Resposta resposta) {
        if (!resposta.ok()) { return EdicaoComentario(null, null, null, null) }
        try {
            return json.decode<EdicaoComentario>(resposta.corpo)
        } catch (String e) {
            return EdicaoComentario(null, null, null, null)
        }
    }

    static PaginaComentarios pagina(Resposta r) {
        if (!r.ok()) { return paginaVazia() }
        try {
            var p = json.decode<PaginaComentarios>(r.corpo)
            return p
        } catch (String e) {
            return paginaVazia()
        }
    }

    static PaginaComentarios paginaVazia() {
        return PaginaComentarios(listOf<Comentario>(), null)
    }
}
