package screens

import tipos.*
import api.*
import core.Ansi
import core.Cliente
import core.Entrada
import core.Sessao
import core.Tema
import ui.Caixa
import ui.Lista
import ui.Menu

class TelaPerfil {

    Cliente cliente
    Sessao sessao

    public constructor(Cliente cliente, Sessao sessao) {
        this.cliente = cliente
        this.sessao = sessao
    }

    void executar() {
        print(Ansi.LIMPAR)
        println(Menu.topo("énois", ""))
        println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
        var r = PerfilApi(this.cliente).eu()
        if (!r.ok()) {
            println(Caixa.simples(Lista.vazia("sem perfil — entre na sua conta")))
            Entrada.pausar()
            return
        }
        println(Caixa.simples(this.cartao(PerfilApi.perfil(r))))
        var escolha = Entrada.menu("perfil", listOf("meus posts"), "voltar")
        if (escolha == 0) { this.meusPosts() }
    }

    void meusPosts() {
        if (this.sessao.usuario == null) { return }
        var usuario = this.sessao.usuario.usuario
        var r = FeedApi(this.cliente).porUsuario(usuario, null, 10)
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var itens = FeedApi.paginaFeed(r).items
        if (itens == null || itens.size() == 0) {
            println(Caixa.simples(Lista.vazia("nenhum post ainda")))
            Entrada.pausar()
            return
        }
        var opcoes = listOf<String>()
        for (var i = 0; i < itens.size(); i = i + 1) {
            opcoes.add(TelaFeed(this.cliente).resumo(itens.get(i)))
        }
        var escolha = Entrada.menu("posts", opcoes, "voltar")
        if (escolha < 0) { return }
        TelaPost(this.cliente).executar(itens.get(escolha))
    }

    String cartao(Perfil p) {
        var texto = ""
        if (p.name != null) { texto = p.name }
        if (p.username != null) { texto = texto + " · @" + p.username }
        if (p.headline != null) { texto = texto + "\n" + p.headline }
        if (p.bio != null) { texto = texto + "\n" + p.bio }
        if (p.company != null) { texto = texto + "\n" + Tema.suave(p.company) }
        if (p.location != null) { texto = texto + "\n" + Tema.suave(p.location) }
        if (p.reputation != null) {
            texto = texto + "\n" + Tema.destaque("✦ " + String.valueOf(p.reputation) + " faísca")
        }
        if (p.followersCount != null) {
            texto = texto + "\n" + Tema.mudo(String.valueOf(p.followersCount) + " seguidores"
                + this.conectados(p))
        }
        if (p.badges != null && p.badges.size() > 0) {
            var selos = ""
            for (var i = 0; i < p.badges.size(); i = i + 1) {
                if (i > 0) { selos = selos + " · " }
                selos = selos + p.badges.get(i)
            }
            texto = texto + "\n" + selos
        }
        if (p.statusText != null) { texto = texto + "\n" + Tema.suave(p.statusText) }
        return texto
    }

    String conectados(Perfil p) {
        if (p.connectionsCount == null) { return "" }
        return " · " + String.valueOf(p.connectionsCount) + " conexões"
    }
}
