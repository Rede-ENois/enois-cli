package api

import core.Cliente
import core.Resposta
import tipos.*
import kof.json

class PenalidadesApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta minhas() {
        return this.cliente.get("/me/sanctions")
    }

    Resposta recorrer(String mensagem) {
        return this.cliente.post("/me/sanctions/appeals",
            json.encode(mapOf("message", mensagem)))
    }

    Resposta aplicadas(String estado, Int limite) {
        return this.cliente.get("/admin/sanctions" + Cliente.query(listOf(
            Cliente.par("status", estado),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta editar(String penalidadeId, String campo, String valor) {
        return this.cliente.post("/admin/sanctions/" + Cliente.caminho(penalidadeId)
            + "/edit", json.encode(mapOf("field", campo, "value", valor)))
    }

    Resposta revogar(String penalidadeId) {
        return this.cliente.post("/admin/sanctions/" + Cliente.caminho(penalidadeId)
            + "/revoke", "{}")
    }

    Resposta recursos(String estado, Int limite) {
        return this.cliente.get("/admin/appeals" + Cliente.query(listOf(
            Cliente.par("status", estado),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta deferirRecurso(String recursoId) {
        return this.cliente.post("/admin/appeals/" + Cliente.caminho(recursoId) + "/approve", "{}")
    }

    Resposta indeferirRecurso(String recursoId) {
        return this.cliente.post("/admin/appeals/" + Cliente.caminho(recursoId) + "/deny", "{}")
    }
}
