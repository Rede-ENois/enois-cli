package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class JogosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? termo, String? cursor, Int limite) {
        return this.cliente.get("/games" + Cliente.query(listOf(
            Cliente.par("q", termo),
            Cliente.par("cursor", cursor),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta perfilDeDev(String usuario) {
        return this.cliente.get("/games/" + Cliente.caminho(usuario) + "/profile")
    }

    Resposta meuPerfilDev() {
        return this.cliente.get("/games/profile/mine")
    }

    Resposta obter(String usuario, String slug) {
        return this.cliente.get("/games/" + Cliente.caminho(usuario)
            + "/" + Cliente.caminho(slug))
    }

    Resposta biblioteca() {
        return this.cliente.get("/games/library")
    }

    Resposta seguir(String usuario) {
        return this.cliente.post("/games/" + Cliente.caminho(usuario) + "/follow", "{}")
    }

    Resposta deixarDeSeguir(String usuario) {
        return this.cliente.delete("/games/" + Cliente.caminho(usuario) + "/follow")
    }

    Resposta avaliacoes(String jogoId, Int limite) {
        return this.cliente.get("/games/" + Cliente.caminho(jogoId)
            + "/reviews" + Cliente.par("limit", Cliente.numero(limite)))
    }

    Resposta avaliar(String jogoId, Int nota, String texto) {
        return this.cliente.post("/games/" + Cliente.caminho(jogoId) + "/reviews",
            json.encode(mapOf("rating", Cliente.numero(nota), "body", texto)))
    }

    Resposta minhaAvaliacaoApagar(String jogoId) {
        return this.cliente.delete("/games/" + Cliente.caminho(jogoId) + "/reviews/mine")
    }

    Resposta comentarios(String jogoId, Int limite) {
        return this.cliente.get("/games/" + Cliente.caminho(jogoId)
            + "/comments" + Cliente.par("limit", Cliente.numero(limite)))
    }

    Resposta comentar(String jogoId, String texto) {
        return this.cliente.post("/games/" + Cliente.caminho(jogoId) + "/comments",
            json.encode(mapOf("body", texto)))
    }

    Resposta palavrasHoje() {
        return this.cliente.get("/daily-games/words/today")
    }

    Resposta iniciarPalavras() {
        return this.cliente.post("/daily-games/words/today/start", "{}")
    }

    Resposta jogarPalavras(String tentativa) {
        return this.cliente.post("/daily-games/words/today/guess",
            json.encode(mapOf("guess", tentativa)))
    }

    Resposta rankingPalavras() {
        return this.cliente.get("/daily-games/words/leaderboard")
    }

    Resposta labirintoHoje(String? data) {
        return this.cliente.get("/daily-games/maze/today" + Cliente.par("date", data))
    }

    Resposta iniciarLabirinto() {
        return this.cliente.post("/daily-games/maze/today/start", "{}")
    }

    Resposta rankingLabirinto() {
        return this.cliente.get("/daily-games/maze/leaderboard")
    }

    Resposta blocosHoje() {
        return this.cliente.get("/daily-games/blocks/today")
    }

    Resposta iniciarBlocos() {
        return this.cliente.post("/daily-games/blocks/today/start", "{}")
    }

    Resposta rankingBlocos() {
        return this.cliente.get("/daily-games/blocks/leaderboard")
    }

    Resposta premios() {
        return this.cliente.get("/daily-games/rewards/prizes")
    }

    static PaginaJogos pagina(Resposta r) {
        if (!r.ok()) { return PaginaJogos(listOf<Jogo>(), null) }
        try {
            return json.decode<PaginaJogos>(r.corpo)
        } catch (String e) {
            return PaginaJogos(listOf<Jogo>(), null)
        }
    }

    static List<Jogo> listaDe(Resposta r) {
        if (!r.ok()) { return listOf<Jogo>() }
        try {
            return json.decode<List<Jogo>>(r.corpo)
        } catch (String e) {
            return listOf<Jogo>()
        }
    }

    static List<AvaliacaoJogo> avaliacoesDe(Resposta r) {
        if (!r.ok()) { return listOf<AvaliacaoJogo>() }
        try {
            return json.decode<List<AvaliacaoJogo>>(r.corpo)
        } catch (String e) {
            return listOf<AvaliacaoJogo>()
        }
    }

    static List<ComentarioJogo> comentariosDe(Resposta r) {
        if (!r.ok()) { return listOf<ComentarioJogo>() }
        try {
            var v = json.decode<ComentariosJogo>(r.corpo)
            if (v.items == null) { return listOf<ComentarioJogo>() }
            return v.items
        } catch (String e) {
            return listOf<ComentarioJogo>()
        }
    }
}
