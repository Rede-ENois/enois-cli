package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class ComunidadesApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? assunto, String? termo, String? cidade, String? estado,
                    String? cursor, Int limite) {
        return this.cliente.get("/communities" + Cliente.query(listOf(
            Cliente.par("topic", assunto),
            Cliente.par("q", termo),
            Cliente.par("city", cidade),
            Cliente.par("state", estado),
            Cliente.par("cursor", cursor),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta locais(Int limite) {
        return this.cliente.get("/communities/local" + Cliente.query(listOf(
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta obter(String comunidadeId) {
        return this.cliente.get("/communities/" + Cliente.caminho(comunidadeId))
    }

    Resposta criar(String nome, String? descricao) {
        return this.cliente.post("/communities",
            json.encode(mapOf("name", nome, "description", descricao)))
    }

    Resposta editar(String comunidadeId, String descricao) {
        return this.cliente.patch("/communities/" + Cliente.caminho(comunidadeId),
            json.encode(mapOf("description", descricao)))
    }

    Resposta entrar(String comunidadeId) {
        return this.cliente.post("/communities/" + Cliente.caminho(comunidadeId)
            + "/members", "{}")
    }

    Resposta sair(String comunidadeId) {
        return this.cliente.delete("/communities/" + Cliente.caminho(comunidadeId)
            + "/members")
    }

    Resposta mural(String comunidadeId, String? cursor, Int limite) {
        return this.cliente.get("/communities/" + Cliente.caminho(comunidadeId)
            + "/feed" + Cliente.pagina(cursor, limite))
    }

    Resposta fixado(String comunidadeId) {
        return this.cliente.get("/communities/" + Cliente.caminho(comunidadeId) + "/pin")
    }

    Resposta fixar(String comunidadeId, String postId) {
        return this.cliente.post("/communities/" + Cliente.caminho(comunidadeId) + "/pin",
            json.encode(mapOf("postId", postId)))
    }

    Resposta desafixar(String comunidadeId) {
        return this.cliente.delete("/communities/" + Cliente.caminho(comunidadeId) + "/pin")
    }

    Resposta canais(String comunidadeId) {
        return this.cliente.get("/communities/" + Cliente.caminho(comunidadeId) + "/channels")
    }

    Resposta favoritar(String comunidadeId) {
        return this.cliente.post("/communities/" + Cliente.caminho(comunidadeId)
            + "/favorite", "{}")
    }

    Resposta desfavoritar(String comunidadeId) {
        return this.cliente.delete("/communities/" + Cliente.caminho(comunidadeId)
            + "/favorite")
    }

    Resposta favoritas(Int limite) {
        return this.cliente.get("/communities/favorites" + Cliente.query(listOf(
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta minhas(Int limite) {
        return this.cliente.get("/communities/mine" + Cliente.query(listOf(
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta membros(String comunidadeId) {
        return this.cliente.get("/communities/" + Cliente.caminho(comunidadeId) + "/members")
    }

    Resposta transferir(String comunidadeId, String novoDonoId) {
        return this.cliente.post("/communities/" + Cliente.caminho(comunidadeId)
            + "/transfer", json.encode(mapOf("newOwnerId", novoDonoId)))
    }

    Resposta apagar(String comunidadeId) {
        return this.cliente.delete("/communities/" + Cliente.caminho(comunidadeId))
    }

    static List<MembroComunidade> membrosDe(Resposta r) {
        if (!r.ok()) { return listOf<MembroComunidade>() }
        try {
            var pagina = json.decode<PaginaMembrosComunidade>(r.corpo)
            if (pagina.items == null) { return listOf<MembroComunidade>() }
            return pagina.items
        } catch (String e) {
            return listOf<MembroComunidade>()
        }
    }

    static List<CanalComunidade> canaisDe(Resposta r) {
        if (!r.ok()) { return listOf<CanalComunidade>() }
        try {
            return json.decode<List<CanalComunidade>>(r.corpo)
        } catch (String e) {
            return listOf<CanalComunidade>()
        }
    }

    static Comunidade unica(Resposta r) {
        var vazia = Comunidade("", null, null, null, null, null, null, null, null, null, null)
        if (!r.ok()) { return vazia }
        try {
            return json.decode<Comunidade>(r.corpo)
        } catch (String e) {
            return vazia
        }
    }

    static PaginaComunidades pagina(Resposta r) {
        if (!r.ok()) { return PaginaComunidades(listOf<Comunidade>(), null) }
        try {
            return json.decode<PaginaComunidades>(r.corpo)
        } catch (String e) {
            return PaginaComunidades(listOf<Comunidade>(), null)
        }
    }
}
