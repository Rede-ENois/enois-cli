package api

record AutorSimples(String? id, String? name, String? username, String? avatar)

record PostAnonimo(
    String id,
    String? content,
    String? createdAt,
    Int? reactions,
    Int? comments,
    String? currentUserReaction,
    Troolean? mine
)

record PaginaAnonimos(List<PostAnonimo>? items, String? nextCursor)

record Desafio(
    String id,
    String? title,
    String? description,
    AutorSimples? author,
    String? createdAt,
    String? endsAt,
    String? status,
    String? destaqueId,
    Int? participacoes,
    Troolean? mine
)

record PaginaDesafios(List<Desafio>? items, String? nextCursor)

record ParticipacaoDesafio(String id, String? desafioId, AutorSimples? author, String? content,
                           String? createdAt, Int? cheers, Troolean? cheered, Troolean? mine)

record PaginaParticipacoes(List<ParticipacaoDesafio>? items)

record PostBlog(String id, String? title, String? body, String? bodyFormat, List<String>? mediaIds,
                String? publishedAt, String? updatedAt)

record BlogTerminal(
    String id,
    String? slug,
    String? title,
    String? description,
    String? authorName,
    String? authorUsername,
    String? authorAvatar,
    String? authorBadge,
    Int? posts,
    Troolean? subscribed,
    Troolean? owner,
    List<PostBlog>? items
)

record ResumoBlog(String? slug, String? title, String? description, String? authorName,
                  String? authorUsername, String? authorAvatar, Int? posts)

record Mural(
    String id,
    String? title,
    String? description,
    AutorSimples? owner,
    Int? contributions,
    String? createdAt
)

record PaginaMurais(List<Mural>? items, String? nextCursor)

record Contribuicao(String? postId, PostResumo? post, AutorSimples? addedBy, String? addedAt)

record PaginaContribuicoes(List<Contribuicao>? items, String? nextCursor)

record MuralDoPost(String id, String? title, String? description, Int? contributions,
                   Troolean? tem, String? createdAt)

record MeusMurais(List<MuralDoPost>? items)

record PessoaRanking(String id, String? usuario, String? nome, Int? reputacao, String? ChegouEm)

record Chegada(List<PessoaRanking>? items)

record Sequencia(Int? currentDays, Int? longestDays, Troolean? todayDone, Int? freezesAvailable,
                 String? lastFrozenDay)

record JanelaTermometro(String? rotulo, Int? valor, String? inicio, String? fim)

record Aviso(String id, String? texto, String? criadoEm, String? expiraEm)
