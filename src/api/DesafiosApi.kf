package api

import core.Cliente
import core.Resposta
import tipos.*
import kof.json

class DesafiosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? cursor, Int limite) {
        return this.cliente.get("/desafios" + Cliente.pagina(cursor, limite))
    }

    Resposta obter(String desafioId) {
        return this.cliente.get("/desafios/" + Cliente.caminho(desafioId))
    }

    Resposta participacoes(String desafioId, String? cursor, Int limite) {
        return this.cliente.get("/desafios/" + Cliente.caminho(desafioId)
            + "/participacoes" + Cliente.pagina(cursor, limite))
    }

    Resposta publicar(String titulo, String descricao) {
        return this.cliente.post("/desafios",
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta encerrar(String desafioId, String destaqueId) {
        return this.cliente.post("/desafios/" + Cliente.caminho(desafioId) + "/fechamento",
            json.encode(mapOf("destaqueId", destaqueId)))
    }

    Resposta apagar(String desafioId) {
        return this.cliente.delete("/desafios/" + Cliente.caminho(desafioId))
    }

    Resposta participar(String desafioId, String conteudo) {
        return this.cliente.post("/desafios/" + Cliente.caminho(desafioId) + "/participacoes",
            json.encode(mapOf("content", conteudo)))
    }

    Resposta aplaudir(String participacaoId) {
        return this.cliente.post("/desafios/participacoes/" + Cliente.caminho(participacaoId)
            + "/cheers", "{}")
    }

    static PaginaDesafios pagina(Resposta r) {
        if (!r.ok()) { return PaginaDesafios(listOf<Desafio>(), null) }
        try {
            return json.decode<PaginaDesafios>(r.corpo)
        } catch (String e) {
            return PaginaDesafios(listOf<Desafio>(), null)
        }
    }

    static Desafio unico(Resposta r) {
        var vazio = Desafio("", null, null, null, null, null, null, null, null, null)
        if (!r.ok()) { return vazio }
        try {
            return json.decode<Desafio>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }

    static List<ParticipacaoDesafio> participacoesDe(Resposta r) {
        if (!r.ok()) { return listOf<ParticipacaoDesafio>() }
        try {
            var pagina = json.decode<PaginaParticipacoes>(r.corpo)
            if (pagina.items == null) { return listOf<ParticipacaoDesafio>() }
            return pagina.items
        } catch (String e) {
            return listOf<ParticipacaoDesafio>()
        }
    }
}
