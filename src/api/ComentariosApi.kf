package api

import core.Cliente
import core.Resposta
import kof.json

class ComentariosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String postId, String? cursor, Int limite) {
        return this.cliente.get("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments" + Consulta.pagina(cursor, limite))
    }

    Resposta comentar(String postId, String conteudo, String? comentarioPai) {
        var corpo = json.encode(mapOf("content", conteudo))
        if (comentarioPai != null) {
            corpo = json.encode(mapOf("content", conteudo,
                "parentCommentId", comentarioPai))
        }
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/comments", corpo)
    }

    Resposta editar(String postId, String comentarioId, String conteudo) {
        var corpo = json.encode(mapOf("content", conteudo))
        return this.cliente.patch("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments/" + ConsultaTextos.caminho(comentarioId), corpo)
    }

    Resposta apagar(String postId, String comentarioId) {
        return this.cliente.delete("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments/" + ConsultaTextos.caminho(comentarioId))
    }

    Resposta fixar(String postId, String comentarioId) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments/" + ConsultaTextos.caminho(comentarioId) + "/pin", "{}")
    }

    Resposta desafixar(String postId, String comentarioId) {
        return this.cliente.delete("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments/" + ConsultaTextos.caminho(comentarioId) + "/pin")
    }

    Resposta reagir(String postId, String tipo) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/reactions",
            json.encode(mapOf("type", tipo)))
    }

    Resposta desreagir(String postId) {
        return this.cliente.delete("/feed/posts/" + ConsultaTextos.caminho(postId) + "/reactions")
    }

    Resposta reagirComentario(String postId, String comentarioId, String tipo) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId)
            + "/comments/" + ConsultaTextos.caminho(comentarioId) + "/reactions",
            json.encode(mapOf("type", tipo)))
    }

    Resposta reacoes(String postId) {
        return this.cliente.get("/feed/posts/" + ConsultaTextos.caminho(postId) + "/reactions")
    }

    Resposta salvar(String postId) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/saves", "{}")
    }

    Resposta dessalvar(String postId) {
        return this.cliente.delete("/feed/posts/" + ConsultaTextos.caminho(postId) + "/saves")
    }

    Resposta compartilhar(String postId) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/shares", "{}")
    }

    Resposta republicar(String postId, String? opiniao) {
        var corpo = "{}"
        if (opiniao != null) { corpo = json.encode(mapOf("opinion", opiniao)) }
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/repost", corpo)
    }

    Resposta republicarNaComunidade(String postId, String comunidadeId, String opiniao) {
        return this.cliente.post("/feed/posts/" + ConsultaTextos.caminho(postId) + "/repost",
            json.encode(mapOf("communityId", comunidadeId, "opinion", opiniao)))
    }

    Resposta desfazerRepost(String postId) {
        return this.cliente.delete("/feed/posts/" + ConsultaTextos.caminho(postId) + "/repost")
    }

    static PaginaComentarios pagina(Resposta r) {
        if (!r.ok()) { return paginaVazia() }
        try {
            var p = json.decode<PaginaComentarios>(r.corpo)
            return p
        } catch (String e) {
            return paginaVazia()
        }
    }

    static PaginaComentarios paginaVazia() {
        return PaginaComentarios(listOf<Comentario>(), null)
    }
}
