class DesafiosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? cursor, Int limite) {
        return this.cliente.get("/desafios" + Consulta.pagina(cursor, limite))
    }

    Resposta obter(String desafioId) {
        return this.cliente.get("/desafios/" + ConsultaTextos.caminho(desafioId))
    }

    Resposta participacoes(String desafioId, String? cursor, Int limite) {
        return this.cliente.get("/desafios/" + ConsultaTextos.caminho(desafioId)
            + "/participacoes" + Consulta.pagina(cursor, limite))
    }

    Resposta publicar(String titulo, String descricao) {
        return this.cliente.post("/desafios",
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta encerrar(String desafioId, String destaqueId) {
        return this.cliente.post("/desafios/" + ConsultaTextos.caminho(desafioId) + "/fechamento",
            json.encode(mapOf("destaqueId", destaqueId)))
    }

    Resposta apagar(String desafioId) {
        return this.cliente.delete("/desafios/" + ConsultaTextos.caminho(desafioId))
    }

    Resposta participar(String desafioId, String conteudo) {
        return this.cliente.post("/desafios/" + ConsultaTextos.caminho(desafioId) + "/participacoes",
            json.encode(mapOf("content", conteudo)))
    }

    Resposta aplaudir(String participacaoId) {
        return this.cliente.post("/desafios/participacoes/" + ConsultaTextos.caminho(participacaoId)
            + "/cheers", "{}")
    }

    static PaginaDesafios pagina(Resposta r) {
        if (!r.ok()) { return PaginaDesafios(listOf<Desafio>(), null) }
        try {
            return json.decode<PaginaDesafios>(r.corpo)
        } catch (String e) {
            return PaginaDesafios(listOf<Desafio>(), null)
        }
    }

    static Desafio unico(Resposta r) {
        var vazio = Desafio("", null, null, null, null, null, null, null, null, null)
        if (!r.ok()) { return vazio }
        try {
            return json.decode<Desafio>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }

    static List<ParticipacaoDesafio> participacoesDe(Resposta r) {
        if (!r.ok()) { return listOf<ParticipacaoDesafio>() }
        try {
            var pagina = json.decode<PaginaParticipacoes>(r.corpo)
            if (pagina.items == null) { return listOf<ParticipacaoDesafio>() }
            return pagina.items
        } catch (String e) {
            return listOf<ParticipacaoDesafio>()
        }
    }
}

class BlogsApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(Int limite, String? termo) {
        return this.cliente.get("/blogs" + Consulta.query(listOf(
            Consulta.par("limit", Consulta.numero(limite)),
            Consulta.par("query", termo))))
    }

    Resposta obter(String slug) {
        return this.cliente.get("/blogs/" + ConsultaTextos.caminho(slug))
    }

    Resposta meu() {
        return this.cliente.get("/blogs/me")
    }

    Resposta criarMeu(String titulo, String? descricao) {
        return this.cliente.put("/blogs/me",
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta publicar(String titulo, String corpo, String formato) {
        return this.cliente.post("/blogs/me/posts",
            json.encode(mapOf("title", titulo, "body", corpo, "bodyFormat", formato)))
    }

    Resposta editarPost(String postId, String titulo, String corpo) {
        return this.cliente.patch("/blogs/me/posts/" + ConsultaTextos.caminho(postId),
            json.encode(mapOf("title", titulo, "body", corpo)))
    }

    Resposta apagarPost(String postId) {
        return this.cliente.delete("/blogs/me/posts/" + ConsultaTextos.caminho(postId))
    }

    Resposta inscrever(String slug) {
        return this.cliente.post("/blogs/" + ConsultaTextos.caminho(slug) + "/subscription", "{}")
    }

    Resposta desinscrever(String slug) {
        return this.cliente.delete("/blogs/" + ConsultaTextos.caminho(slug) + "/subscription")
    }

    static List<ResumoBlog> listaDe(Resposta r) {
        if (!r.ok()) { return listOf<ResumoBlog>() }
        try {
            return json.decode<List<ResumoBlog>>(r.corpo)
        } catch (String e) {
            return listOf<ResumoBlog>()
        }
    }

    static BlogTerminal unico(Resposta r) {
        var vazio = BlogTerminal("", null, null, null, null, null, null, null, null, null, null, null)
        if (!r.ok()) { return vazio }
        try {
            return json.decode<BlogTerminal>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }
}

class MuraisApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? cursor, Int limite) {
        return this.cliente.get("/murais" + Consulta.pagina(cursor, limite))
    }

    Resposta obter(String muralId) {
        return this.cliente.get("/murais/" + ConsultaTextos.caminho(muralId))
    }

    Resposta criar(String titulo, String? descricao) {
        return this.cliente.post("/murais",
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta editar(String muralId, String titulo, String descricao) {
        return this.cliente.patch("/murais/" + ConsultaTextos.caminho(muralId),
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta apagar(String muralId) {
        return this.cliente.delete("/murais/" + ConsultaTextos.caminho(muralId))
    }

    Resposta minhasColecoes(String postId) {
        return this.cliente.get("/murais/meus" + Consulta.par("postId", postId))
    }

    Resposta contribuicoes(String muralId, String? cursor, Int limite) {
        return this.cliente.get("/murais/" + ConsultaTextos.caminho(muralId)
            + "/contribuicoes" + Consulta.pagina(cursor, limite))
    }

    Resposta contribuir(String muralId, String postId) {
        return this.cliente.post("/murais/" + ConsultaTextos.caminho(muralId) + "/contribuicoes",
            json.encode(mapOf("postId", postId)))
    }

    Resposta retirar(String muralId, String postId) {
        return this.cliente.delete("/murais/" + ConsultaTextos.caminho(muralId)
            + "/contribuicoes/" + ConsultaTextos.caminho(postId))
    }

    static PaginaMurais pagina(Resposta r) {
        if (!r.ok()) { return PaginaMurais(listOf<Mural>(), null) }
        try {
            return json.decode<PaginaMurais>(r.corpo)
        } catch (String e) {
            return PaginaMurais(listOf<Mural>(), null)
        }
    }

    static Mural unico(Resposta r) {
        var vazio = Mural("", null, null, null, null, null)
        if (!r.ok()) { return vazio }
        try {
            return json.decode<Mural>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }

    static List<Contribuicao> contribuicoesDe(Resposta r) {
        if (!r.ok()) { return listOf<Contribuicao>() }
        try {
            var pagina = json.decode<PaginaContribuicoes>(r.corpo)
            if (pagina.items == null) { return listOf<Contribuicao>() }
            return pagina.items
        } catch (String e) {
            return listOf<Contribuicao>()
        }
    }

    static List<MuralDoPost> meusDe(Resposta r) {
        if (!r.ok()) { return listOf<MuralDoPost>() }
        try {
            var pagina = json.decode<MeusMurais>(r.corpo)
            if (pagina.items == null) { return listOf<MuralDoPost>() }
            return pagina.items
        } catch (String e) {
            return listOf<MuralDoPost>()
        }
    }
}

