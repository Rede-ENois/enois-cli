package ui

import core.*
import api.SinaisApi
import ui.Abas
import ui.Badge
import ui.Menu
import ui.Painel

class Seletor {

    static List<String> DIGITOS = listOf("1", "2", "3", "4", "5", "6", "7", "8", "9")

    Teclado teclado
    String contexto
    Int cursor
    List<ItemNavegacao> itens
    Cliente cliente
    SinaisApi sinaisApi
    ContagensNavegacao contagens
    Previa previa
    Regioes regioes

    public constructor(String contexto, Cliente cliente) {
        this.teclado = Teclado()
        this.contexto = contexto
        this.cursor = 0
        this.itens = Navegacao.visiveis(contexto)
        this.cliente = cliente
        this.sinaisApi = SinaisApi(cliente)
        this.previa = Previa(cliente, contexto)
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), contexto == "social")
        this.regioes = Regioes()
    }

    static Int digito(String caractere) {
        for (var i = 0; i < Seletor.DIGITOS.size(); i = i + 1) {
            if (Seletor.DIGITOS.get(i) == caractere) { return i }
        }
        return -1
    }

    static Bool encerra(Tecla tecla) {
        if (tecla.nome == "escape" || tecla.nome == "ctrl-c") { return true }
        return tecla.nome == "texto" && (tecla.caractere == "q" || tecla.caractere == "0")
    }

    static Int indiceDoContexto(String nome) {
        for (var i = 0; i < Navegacao.CONTEXTOS.size(); i = i + 1) {
            if (Navegacao.CONTEXTOS.get(i) == nome) { return i }
        }
        return -1
    }

    String contextoDoServidor() {
        if (this.contexto == "profissional") { return "PROFESSIONAL" }
        return "SOCIAL"
    }

    void recarregar() {
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), this.contexto == "social")
    }

    String escolher(String topo, String dica) {
        if (!this.teclado.entrar()) { return "" }
        print(Ansi.OCULTAR_CURSOR)
        print(Ansi.ALTERNATIVO)
        var rota = ""
        var seguindo = true
        while (seguindo) {
            this.desenhar(topo, dica)
            var tecla = this.teclado.ler()
            var escolha = -1
            if (tecla.nome == "clique") {
                var alvo = this.regioes.em(tecla.linha, tecla.coluna)
                if (alvo.tipo == "aba") {
                    this.irParaContexto(alvo.indice)
                } else if (alvo.tipo == "item") {
                    escolha = alvo.indice
                }
            } else if (tecla.nome == "roda-cima" || tecla.nome == "cima") {
                this.mover(-1)
            } else if (tecla.nome == "roda-baixo" || tecla.nome == "baixo") {
                this.mover(1)
            } else if (tecla.nome == "tab" || tecla.nome == "voltar-aba") {
                this.alternarContexto()
            } else if (tecla.nome == "enter") {
                escolha = this.cursor
            } else if (tecla.nome == "texto") {
                if (tecla.caractere == "k") {
                    this.mover(-1)
                } else if (tecla.caractere == "j") {
                    this.mover(1)
                } else if (tecla.caractere == "r") {
                    this.previa.limpar()
                    this.recarregar()
                } else {
                    var atalho = Seletor.digito(tecla.caractere)
                    if (atalho >= 0) {
                        escolha = atalho
                    } else if (Seletor.encerra(tecla)) {
                        seguindo = false
                    }
                }
            } else if (Seletor.encerra(tecla)) {
                seguindo = false
            }
            if (escolha >= 0) {
                this.cursor = escolha
                if (this.confirmar(escolha)) { continue }
                rota = this.rotaDo(escolha)
                seguindo = false
            }
        }
        this.teclado.desligarMouse()
        print(Ansi.NORMAL)
        print(Ansi.MOSTRAR_CURSOR)
        this.teclado.sair()
        return rota
    }

    Bool confirmar(Int indice) {
        if (indice < 0 || indice >= this.itens.size()) { return true }
        if (this.itens.get(indice).rota == "trocar contexto") {
            this.alternarContexto()
            return true
        }
        return false
    }

    String rotaDo(Int indice) {
        if (indice < 0 || indice >= this.itens.size()) { return "" }
        return this.itens.get(indice).rota
    }

    void mover(Int passo) {
        var novo = this.cursor + passo
        if (novo < 0) { novo = this.itens.size() - 1 }
        if (novo >= this.itens.size()) { novo = 0 }
        this.cursor = novo
    }

    void alternarContexto() {
        this.irParaContexto(Seletor.indiceDoContexto(Navegacao.proximoContexto(this.contexto)))
    }

    void irParaContexto(Int indice) {
        if (indice < 0 || indice >= Navegacao.CONTEXTOS.size()) { return }
        var novo = Navegacao.CONTEXTOS.get(indice)
        if (novo == this.contexto) { return }
        this.contexto = novo
        this.itens = Navegacao.visiveis(this.contexto)
        this.cursor = 0
        this.recarregar()
        this.previa.trocarContexto(this.contexto)
    }

    void desenhar(String topo, String dica) {
        var largura = Ansi.LARGURA_CONTEUDO
        print(Ansi.LIMPAR)
        this.regioes.limpar()
        var linha = 1
        for (var parte in topo.split("\n")) {
            println(parte)
            linha = linha + 1
        }
        println("")
        linha = linha + 1
        println(Abas.lista(Navegacao.CONTEXTOS, this.contexto))
        Abas.registrar(this.regioes, linha, Navegacao.CONTEXTOS, this.contexto)
        this.teclado.ligarMouse()
        linha = linha + 1
        println("")
        linha = linha + 1
        if (Painel.cabe(largura)) {
            linha = this.desenharPainel(linha, largura)
        } else {
            linha = this.desenharMenu(linha, largura)
        }
        println("")
        println(Menu.rodape(dica))
    }

    Int desenharPainel(Int linha, Int largura) {
        var coluna = Painel.larguraEsquerda(largura)
        var esquerda = this.menu(coluna)
        var direita = this.previaDe(Painel.larguraDireita(largura))
        var linhas = Painel.linhas(Seletor.textos(esquerda), direita, largura)
        for (var i = 0; i < linhas.size(); i = i + 1) {
            println(linhas.get(i))
            if (i < esquerda.size() && esquerda.get(i).indice >= 0) {
                this.regioes.adicionar(linha + i, 1, coluna, esquerda.get(i).indice, "item")
            }
        }
        return linha + linhas.size()
    }

    Int desenharMenu(Int linha, Int largura) {
        var linhas = this.menu(largura)
        for (var i = 0; i < linhas.size(); i = i + 1) {
            println(linhas.get(i).texto)
            if (linhas.get(i).indice >= 0) {
                this.regioes.adicionar(linha + i, 1, largura, linhas.get(i).indice, "item")
            }
        }
        return linha + linhas.size()
    }

    static List<String> textos(List<LinhaMenu> linhas) {
        var saida = listOf<String>()
        for (var linha in linhas) { saida.add(linha.texto) }
        return saida
    }

    List<LinhaMenu> menu(Int largura) {
        var linhas = listOf<LinhaMenu>()
        var secao = ""
        var numero = 1
        var foco = 0
        for (var i = 0; i < this.itens.size(); i = i + 1) {
            var item = this.itens.get(i)
            if (item.secao != secao) {
                secao = item.secao
                if (linhas.size() > 0) { linhas.add(LinhaMenu.livre("")) }
                linhas.add(LinhaMenu.livre(Abas.grupo(secao)))
            }
            var rotulo = this.rotulo(numero, item, largura)
            if (i == this.cursor) {
                foco = linhas.size()
                linhas.add(LinhaMenu(Tema.selecionado(Ansi.padDireita(rotulo, largura)), i))
            } else {
                linhas.add(LinhaMenu(rotulo, i))
            }
            numero = numero + 1
        }
        return this.janela(linhas, foco)
    }

    List<LinhaMenu> janela(List<LinhaMenu> linhas, Int foco) {
        return Seletor.janelaDe(linhas, foco, this.alturaConteudo())
    }

    static List<LinhaMenu> janelaDe(List<LinhaMenu> linhas, Int foco, Int altura) {
        if (linhas.size() <= altura) { return linhas }
        var inicio = foco - altura / 2
        if (inicio > linhas.size() - altura) { inicio = linhas.size() - altura }
        if (inicio < 0) { inicio = 0 }
        var acima = inicio > 0
        var abaixo = inicio + altura < linhas.size()
        var espaco = altura
        if (acima) { espaco = espaco - 1 }
        if (abaixo) { espaco = espaco - 1 }
        var saida = listOf<LinhaMenu>()
        if (acima) {
            saida.add(LinhaMenu.livre(Tema.mudo("  ↑ " + String.valueOf(inicio) + " linhas acima")))
        }
        for (var i = inicio; i < inicio + espaco; i = i + 1) { saida.add(linhas.get(i)) }
        if (abaixo) {
            var restantes = linhas.size() - inicio - espaco
            saida.add(LinhaMenu.livre(Tema.mudo("  ↓ " + String.valueOf(restantes) + " linhas abaixo")))
        }
        return saida
    }

    String rotulo(Int numero, ItemNavegacao item, Int largura) {
        var texto = "  " + Ansi.padEsquerda(String.valueOf(numero), 2) + ". " + item.rotulo
        var selo = this.selo(item)
        if (selo.length > 0) { texto = texto + " " + selo }
        var sobra = largura - Ansi.largura(texto) - 3
        if (item.descricao.length > 0 && sobra > 8) {
            texto = texto + "  " + Tema.mudo(Ansi.cortar(item.descricao, sobra))
        }
        return texto
    }

    String selo(ItemNavegacao item) {
        return Badge.sinal(Sinais.de(item.rota, item.notifica, this.contagens))
    }

    ItemNavegacao itemAtual() {
        if (this.itens.size() == 0) { return ItemNavegacao("", "", "", "", null, null) }
        var indice = this.cursor
        if (indice < 0 || indice >= this.itens.size()) { indice = 0 }
        return this.itens.get(indice)
    }

    Int alturaConteudo() {
        var total = Terminal.altura() - 9
        if (total < 6) { total = 6 }
        if (total > 24) { total = 24 }
        return total
    }

    Int limite() {
        return this.alturaConteudo()
    }

    List<String> previaDe(Int largura) {
        var item = this.itemAtual()
        var linhas = listOf<String>()
        linhas.add(Tema.destaque(item.rotulo))
        if (item.descricao.length > 0) {
            for (var parte in Ansi.quebrar(item.descricao, largura)) { linhas.add(Tema.mudo(parte)) }
        }
        var selo = this.selo(item)
        if (selo.length > 0) {
            linhas.add("")
            linhas.add(Tema.suave("sinal ") + selo)
        }
        linhas.add("")
        linhas.add(Ansi.divisor(largura, Tema.BORDA_SUAVE))
        this.previaCorpo(linhas, item, largura)
        return Seletor.recortar(linhas, this.limite())
    }

    static List<String> recortar(List<String> linhas, Int limite) {
        if (linhas.size() <= limite) { return linhas }
        var saida = listOf<String>()
        for (var i = 0; i < limite; i = i + 1) { saida.add(linhas.get(i)) }
        return saida
    }

    void previaCorpo(List<String> linhas, ItemNavegacao item, Int largura) {
        var limite = this.limite()
        for (var bruta in this.previa.linhas(item.rota)) {
            if (linhas.size() >= limite) { return }
            for (var parte in Ansi.quebrar(bruta, largura)) {
                if (linhas.size() >= limite) { return }
                linhas.add(parte)
            }
        }
    }
}
