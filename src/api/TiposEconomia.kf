package api

record Carteira(Int? balance, Int? escala, Int? cotacaoBrlCents, Int? cotacaoBrlMicros,
                String? chave, List<Lancamento>? entries, Sequencia? streak)

record Lancamento(Int? amount, String? kind, String? message, String? refId, String? createdAt)

record Extrato(List<Lancamento>? entries, Int? page, Int? size, Troolean? hasNext)

record Cotacao(Int? brlCents, Int? brlMicros, Int? escala, String? atualizadaEm,
               List<PontoCotacao>? historico)

record PontoCotacao(Int? brlCents, Int? brlMicros, String? em)

record ItemLoja(String id, String? kind, String? collection, String? name, String? description,
                Int? priceMf, String? cssRing, Int? releaseOrder, Troolean? available,
                Troolean? purchasable, Troolean? owned, Troolean? equipped)

record LojaColecao(String id, String? name, Troolean? available, List<JanelaLoja>? windows,
                   List<LookLoja>? looks)

record JanelaLoja(String? start, String? end)

record LookLoja(String id, String? title, List<String>? items, String? statusIcon,
                String? statusText, Troolean? owned, Troolean? equipped)

record Anuncio(String id, String? sellerName, String? sellerUsername, String? itemKind,
               String? itemId, String? title, String? description, Int? price, String? status,
               String? createdAt)

record Compra(String id, String? listingId, String? buyerId, String? sellerId, Int? price,
              String? state, String? createdAt, String? decidedAt, String? itemKind,
              String? title, String? itemId)

record Campanha(String id, String? slug, String? name, String? description, String? setting,
                String? gameSystem, String? systemFamily, String? visibility, String? status,
                Int? members, String? viewerRole, Troolean? joined, String? createdAt)

record PaginaCampanhas(List<Campanha>? items, String? nextCursor)

record MaquinaEstado(String? gameId, Int? estado, String? resultado, String? proximaJogada,
                     Int? tentativas, Troolean? terminou)

record Ranking(String? jogo, List<Posicao>? entradas, String? minhaPuntuacao)

record Posicao(String? usuario, String? nome, Int? pontos, Int? colocacao)
