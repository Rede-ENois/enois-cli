package screens

import core.Ansi
import core.Cliente
import core.Entrada
import core.Tema
import ui.Menu

class TelaEconomia {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    void executar() {
        var rodando = true
        while (rodando && Entrada.ativa) {
            print(Ansi.LIMPAR)
            println(Menu.topo("énois", ""))
            println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
            println(Tema.destaque("economia"))
            println(Tema.mudo("faíscas, loja e marketplace"))
            var escolha = Entrada.menu("economia",
                listOf("carteira", "loja", "marketplace"), "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == 0) {
                TelaCarteira(this.cliente).executar()
            } else if (escolha == 1) {
                TelaLoja(this.cliente).executar()
            } else if (escolha == 2) {
                TelaMarketplace(this.cliente).executar()
            }
        }
    }
}
