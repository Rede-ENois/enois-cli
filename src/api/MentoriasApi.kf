package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class MentoriasApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? especialidade, String? termo, String? cursor, Int limite) {
        return this.cliente.get("/mentors" + Cliente.query(listOf(
            Cliente.par("expertise", especialidade),
            Cliente.par("query", termo),
            Cliente.par("cursor", cursor),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta obter(String mentorId) {
        return this.cliente.get("/mentors/" + Cliente.caminho(mentorId))
    }

    Resposta criar(List<String> especialidades, String preco) {
        var lista = ""
        for (var e in especialidades) {
            if (lista.length > 0) { lista = lista + "," }
            lista = lista + "\"" + e + "\""
        }
        return this.cliente.post("/mentors",
            "{\"expertise\":[" + lista + "],\"price\":\"" + preco + "\"}")
    }

    Resposta editar(String mentorId, List<String> especialidades, String preco) {
        var lista = ""
        for (var e in especialidades) {
            if (lista.length > 0) { lista = lista + "," }
            lista = lista + "\"" + e + "\""
        }
        return this.cliente.patch("/mentors/" + Cliente.caminho(mentorId),
            "{\"expertise\":[" + lista + "],\"price\":\"" + preco + "\"}")
    }

    Resposta apagar(String mentorId) {
        return this.cliente.delete("/mentors/" + Cliente.caminho(mentorId))
    }

    Resposta vagas(String mentorId) {
        return this.cliente.get("/mentors/" + Cliente.caminho(mentorId) + "/slots")
    }

    Resposta criarVaga(String mentorId, String comecaEm) {
        return this.cliente.post("/mentors/" + Cliente.caminho(mentorId) + "/slots",
            json.encode(mapOf("startsAt", comecaEm)))
    }

    Resposta apagarVaga(String mentorId, String vagaId) {
        return this.cliente.delete("/mentors/" + Cliente.caminho(mentorId)
            + "/slots/" + Cliente.caminho(vagaId))
    }

    Resposta agendar(String mentorId, String vagaId) {
        return this.cliente.post("/mentors/" + Cliente.caminho(mentorId) + "/sessions",
            json.encode(mapOf("slotId", vagaId)))
    }

    Resposta entrarNaSala(String mentorId, String sessaoId) {
        return this.cliente.post("/mentors/" + Cliente.caminho(mentorId)
            + "/sessions/" + Cliente.caminho(sessaoId) + "/join", "{}")
    }

    Resposta minhasSessoes() {
        return this.cliente.get("/mentors/sessions/mine")
    }

    static List<VagaMentor> vagasDe(Resposta r) {
        if (!r.ok()) { return listOf<VagaMentor>() }
        try {
            var pagina = json.decode<PaginaVagasMentor>(r.corpo)
            if (pagina.items == null) { return listOf<VagaMentor>() }
            return pagina.items
        } catch (String e) {
            return listOf<VagaMentor>()
        }
    }

    static List<SessaoMentoria> sessoesDe(Resposta r) {
        if (!r.ok()) { return listOf<SessaoMentoria>() }
        try {
            return json.decode<List<SessaoMentoria>>(r.corpo)
        } catch (String e) {
            return listOf<SessaoMentoria>()
        }
    }

    static PaginaMentores pagina(Resposta r) {
        if (!r.ok()) { return PaginaMentores(listOf<Mentor>(), null) }
        try {
            return json.decode<PaginaMentores>(r.corpo)
        } catch (String e) {
            return PaginaMentores(listOf<Mentor>(), null)
        }
    }
}
