package tipos

record Contadores(Int? reactions, Int? comments, Int? saves, Int? shares, Int? reposts)

record Enquete(
    List<String>? options,
    List<Int>? counts,
    List<Int>? myVotes,
    Int? totalVotes,
    Troolean? multipleChoice,
    String? endsAt
)

record ComunidadeRef(String id, String? name, Troolean? joined)

record PostResumo(
    String id,
    String? type,
    String? content,
    String? createdAt,
    String? authorId,
    String? authorName,
    String? authorUsername,
    String? authorAvatar,
    String? authorBadge,
    String? authorHeadline,
    List<String>? tags,
    Contadores? counters,
    String? currentUserReaction,
    String? communityId,
    String? repostOf,
    String? repostOfAuthor,
    String? repostOfContent,
    Troolean? repostWithOpinion,
    Enquete? poll,
    Troolean? currentUserReposted,
    String? acceptedCommentId,
    String? topic,
    String? editedAt
)

record PaginaPost(List<PostResumo>? items, String? nextCursor)

record PaginaFeed(List<PostResumo>? items, String? nextCursor, String? lastSeenAt)
