package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class ProjetosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta meus() {
        return this.cliente.get("/me/projects")
    }

    Resposta deUsuario(String usuario) {
        return this.cliente.get("/users/" + Cliente.caminho(usuario) + "/projects")
    }

    static List<ProjetoUsuario> listaDe(Resposta r) {
        if (!r.ok()) { return listOf<ProjetoUsuario>() }
        try {
            return json.decode<List<ProjetoUsuario>>(r.corpo)
        } catch (String e) {
            return listOf<ProjetoUsuario>()
        }
    }
}
