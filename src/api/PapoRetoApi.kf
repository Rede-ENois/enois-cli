package api

import core.Cliente
import core.Resposta
import tipos.*
import kof.json

class PapoRetoApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta assuntos(String? comunidade) {
        return this.cliente.get("/papo-reto" + Cliente.query(listOf(
            Cliente.par("comunidade", comunidade))))
    }

    Resposta linhaDoTempo(String assunto, String janela) {
        return this.cliente.get("/papo-reto/" + Cliente.caminho(assunto)
            + "/timeline" + Cliente.par("janela", janela))
    }

    Resposta analise() {
        return this.cliente.get("/papo-reto/analise")
    }

    static List<ReclameAssunto> assuntosDe(Resposta r) {
        if (!r.ok()) { return listOf<ReclameAssunto>() }
        try {
            return json.decode<List<ReclameAssunto>>(r.corpo)
        } catch (String e) {
            return listOf<ReclameAssunto>()
        }
    }

    static List<IntervaloFalas> timelineDe(Resposta r) {
        if (!r.ok()) { return listOf<IntervaloFalas>() }
        try {
            return json.decode<List<IntervaloFalas>>(r.corpo)
        } catch (String e) {
            return listOf<IntervaloFalas>()
        }
    }
}
