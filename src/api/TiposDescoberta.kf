package api

record ResultadoBusca(
    String id,
    String? type,
    String? title,
    String? subtitle,
    String? image,
    String? href
)

record PaginaBusca(List<ResultadoBusca>? items, String? nextCursor)

record Comunidade(
    String id,
    String? name,
    String? description,
    Int? members,
    String? topic,
    String? cover,
    String? avatar,
    String? bannerHtml,
    Troolean? joined,
    String? city,
    String? state
)

record PaginaComunidades(List<Comunidade>? items, String? nextCursor)

record MembroComunidade(String? userId, String? username, String? name, String? avatar, String? role)
record PaginaMembrosComunidade(List<MembroComunidade>? items, String? nextCursor)

record CanalComunidade(String? id, String? name, String? slug, String? topic, String? description, String? createdAt)
record ListaCanais(List<CanalComunidade>? items)

record Grupo(
    String id,
    String? slug,
    String? name,
    String? description,
    String? topic,
    String? avatar,
    String? banner,
    String? joinMode,
    String? status,
    Int? members,
    String? viewerRole,
    Troolean? joined,
    Troolean? requestPending,
    String? createdAt
)

record PaginaGrupos(List<Grupo>? items, String? nextCursor)

record MembroGrupo(String? userId, String? username, String? name, String? avatar, String? role, String? joinedAt)
record PaginaMembrosGrupo(List<MembroGrupo>? items, String? nextCursor)

record PedidoGrupo(String? id, String? userId, String? username, String? name, String? avatar, String? message, String? createdAt)
record PaginaPedidosGrupo(List<PedidoGrupo>? items, String? nextCursor)

record TopicoGrupo(String? id, String? name, String? description, Int? position, String? status)
record ListaTopicos(List<TopicoGrupo>? items)
record PaginaTopicos(List<TopicoGrupo>? items, String? nextCursor)

record Evento(
    String id,
    String? title,
    String? date,
    String? time,
    String? format,
    String? host,
    Int? attendees,
    String? cover,
    String? streamUrl,
    String? location,
    Troolean? expired,
    Troolean? attending,
    String? recurrence,
    String? seriesId,
    String? nextOccurrenceDate,
    String? city,
    String? state,
    Troolean? tamoJunto
)

record PaginaEventos(List<Evento>? items, String? nextCursor)

record Colecao(String id, String? title, String? description, Int? postCount, String? createdAt)
record PaginaColecoes(List<Colecao>? items, String? nextCursor)
record ColecaoPost(String? postId, PostResumo? post, String? adicionadoAt)
record PaginaColecaoPosts(List<ColecaoPost>? items, String? nextCursor)

record PostGrupo(
    String id,
    String? groupId,
    String? topicId,
    String? authorName,
    String? authorUsername,
    String? authorAvatar,
    String? content,
    Troolean? pinned,
    Int? reactions,
    Int? comments,
    String? createdAt
)

record PaginaPostsGrupo(List<PostGrupo>? items, String? nextCursor)
