package core

class Ansi {

    static String ESC = "\u001b"
    static String LIMPAR = ESC + "[2J" + ESC + "[H"
    static String LIMPAR_LINHA = ESC + "[2K"
    static String ALTERNATIVO = ESC + "[?1049h"
    static String NORMAL = ESC + "[?1049l"
    static String OCULTAR_CURSOR = ESC + "[?25l"
    static String MOSTRAR_CURSOR = ESC + "[?25h"
    static String MOUSE_LIGAR = ESC + "[?1000h" + ESC + "[?1006h"
    static String MOUSE_DESLIGAR = ESC + "[?1006l" + ESC + "[?1000l"
    static String CONSULTAR_CURSOR = ESC + "[6n"

    static Int LARGURA_CONTEUDO = Terminal.largura()
    static Int LARGURA_MINIMA = Terminal.LARGURA_MINIMA

    static void medir() {
        Ansi.LARGURA_CONTEUDO = Terminal.largura()
    }

    static void escrever(String texto) {
        if (texto == null) { return }
        write(1, texto, strlen(texto))
    }

    static Int alturaLinha(String texto, Int colunas) {
        if (colunas <= 0) { return 1 }
        var visivel = Ansi.largura(texto)
        if (visivel <= colunas) { return 1 }
        var linhas = visivel / colunas
        if (visivel % colunas != 0) { linhas = linhas + 1 }
        return linhas
    }

    static Int alturas(String texto, Int colunas) {
        if (texto == null) { return 1 }
        var total = 0
        for (var parte in texto.split("\n")) {
            total = total + Ansi.alturaLinha(parte, colunas)
        }
        if (total < 1) { total = 1 }
        return total
    }

    static Int largura(String s) {
        if (s == null) { return 0 }
        var total = 0
        var i = 0
        while (i < s.length) {
            var c = s.charAt(i)
            if (c == 27) {
                i = Ansi.pularSequencia(s, i)
                continue
            }
            if (Ansi.peso(c) == 2) {
                total = total + 2
            } else {
                total = total + 1
            }
            i = i + 1
        }
        return total
    }

    static Int peso(Int c) {
        if (c == 0x200D || (c >= 0xFE00 && c <= 0xFE0F)) { return 0 }
        if (c >= 0x200B && c <= 0x200F) { return 0 }
        if (c == 0xFEFF) { return 0 }
        if (c >= 0x1F300 && c <= 0x1FAFF) { return 2 }
        if (c >= 0x2600 && c <= 0x27BF) { return 2 }
        return 1
    }

    static Int pularSequencia(String s, Int inicio) {
        var i = inicio + 1
        if (i >= s.length) { return s.length }
        if (s.charAt(i) != 91) { return i }
        i = i + 1
        while (i < s.length) {
            var c = s.charAt(i)
            i = i + 1
            if (c >= 64 && c <= 126) { break }
        }
        return i
    }

    static String trecho(String s, Int de, Int ate) {
        var saida = ""
        for (var i = de; i < ate; i = i + 1) {
            saida = saida + s.charAt(i)
        }
        return saida
    }

    static String fatiar(String s, Int de, Int ate) {
        if (s == null) { return "" }
        var saida = ""
        var coluna = 0
        var i = 0
        while (i < s.length) {
            var c = s.charAt(i)
            if (c == 27) {
                var fim = Ansi.pularSequencia(s, i)
                saida = saida + Ansi.trecho(s, i, fim)
                i = fim
                continue
            }
            var peso = Ansi.peso(c)
            if (coluna >= de && coluna + peso <= ate) {
                saida = saida + c
            }
            coluna = coluna + peso
            i = i + 1
        }
        return saida + Tema.RESET
    }

    static String sobrepor(String fundo, String caixa, Int coluna, Int larguraCaixa) {
        var antes = Ansi.fatiar(fundo, 0, coluna - 1)
        var depois = Ansi.fatiar(fundo, coluna - 1 + larguraCaixa, 1000000)
        return antes + caixa + depois
    }

    static String posicao(Int linha, Int coluna) {
        return ESC + "[" + linha + ";" + coluna + "H"
    }

    static String padDireita(String s, Int maximo) {
        var faltam = maximo - largura(s)
        if (faltam <= 0) { return s }
        var espacos = ""
        for (var i = 0; i < faltam; i = i + 1) {
            espacos = espacos + " "
        }
        return s + espacos
    }

    static String padEsquerda(String s, Int maximo) {
        var faltam = maximo - largura(s)
        if (faltam <= 0) { return s }
        var espacos = ""
        for (var i = 0; i < faltam; i = i + 1) {
            espacos = espacos + " "
        }
        return espacos + s
    }

    static String centrar(String s, Int maximo) {
        var faltam = maximo - largura(s)
        if (faltam <= 0) { return s }
        var esquerda = faltam / 2
        var direita = faltam - esquerda
        var e = ""
        var d = ""
        for (var i = 0; i < esquerda; i = i + 1) { e = e + " " }
        for (var i = 0; i < direita; i = i + 1) { d = d + " " }
        return e + s + d
    }

    static String cortar(String s, Int maximo) {
        if (maximo <= 0) { return "" }
        if (largura(s) <= maximo) { return s }
        var saida = ""
        var total = 0
        var i = 0
        while (i < s.length) {
            var c = s.charAt(i)
            if (c == 27) {
                var fim = Ansi.pularSequencia(s, i)
                saida = saida + Ansi.trecho(s, i, fim)
                i = fim
                continue
            }
            var peso = Ansi.peso(c)
            if (total + peso > maximo - 1) { break }
            saida = saida + c
            total = total + peso
            i = i + 1
        }
        return saida + "…" + Tema.RESET
    }

    static List<String> quebrar(String texto, Int larguraMaxima) {
        var linhas = listOf<String>()
        if (texto == null || texto.length == 0) {
            linhas.add("")
            return linhas
        }
        var atual = ""
        for (var palavra in texto.split(" ")) {
            var candidata = atual + " " + palavra
            if (atual.length == 0) { candidata = palavra }
            if (largura(candidata) > larguraMaxima && atual.length > 0) {
                linhas.add(atual)
                atual = palavra
            } else {
                atual = candidata
            }
        }
        if (atual.length > 0) { linhas.add(atual) }
        return linhas
    }

    static String divisor(Int largura, String cor) {
        var linha = ""
        for (var i = 0; i < largura; i = i + 1) {
            linha = linha + "─"
        }
        return cor + linha + Tema.RESET
    }

    static String cabecalho(String titulo, Int largura) {
        return Tema.destaque(titulo) + "\n" + divisor(largura, Tema.BORDA_SUAVE)
    }
}
