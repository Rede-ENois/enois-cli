package screens

import api.*
import core.Ansi
import core.Cliente
import core.Entrada
import core.Tema
import ui.Caixa
import ui.Lista
import ui.Menu

class TelaBusca {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    void executar() {
        var termo = Entrada.textoObrigatorio("buscar")
        var r = BuscaApi(this.cliente).buscar(termo, null, 30)
        print(Ansi.LIMPAR)
        println(Menu.topo("énois", ""))
        println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
        if (!r.ok()) {
            println(Tema.erro(r.mensagem()))
            Entrada.pausar()
            return
        }
        var itens = BuscaApi.pagina(r).items
        if (itens == null || itens.size() == 0) {
            println(Caixa.simples(Lista.vazia("nada encontrado para " + termo)))
            Entrada.pausar()
            return
        }
        for (var i = 0; i < itens.size(); i = i + 1) {
            var item = itens.get(i)
            var titulo = ""
            if (item.title != null) { titulo = item.title }
            var tipo = ""
            if (item.type != null) { tipo = " · " + Tema.suave(item.type) }
            println(Tema.destaque(titulo) + tipo)
            if (item.subtitle != null) { println("  " + item.subtitle) }
            println("")
        }
        Entrada.pausar()
    }
}
