package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class ParesEstudoApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta meus() {
        return this.cliente.get("/study-pairs/me")
    }

    Resposta buscar(String? termo, Int limite) {
        return this.cliente.get("/study-pairs/search" + Cliente.query(listOf(
            Cliente.par("q", termo),
            Cliente.par("limit", Cliente.numero(limite)))))
    }

    Resposta metasPopulares() {
        return this.cliente.get("/study-pairs/goals/popular")
    }

    Resposta pedir(String objetivo, String? assunto) {
        return this.cliente.post("/study-pairs/requests",
            json.encode(mapOf("goal", objetivo, "topic", assunto)))
    }

    Resposta cancelarPedido() {
        return this.cliente.delete("/study-pairs/requests/current")
    }

    Resposta checkin(String duplaId, String nota) {
        return this.cliente.post("/study-pairs/" + Cliente.caminho(duplaId) + "/checkins",
            json.encode(mapOf("note", nota)))
    }

    Resposta encerrar(String duplaId) {
        return this.cliente.post("/study-pairs/" + Cliente.caminho(duplaId) + "/end", "{}")
    }

    static MeusPares meusDe(Resposta r) {
        var vazio = MeusPares(null, listOf<ParDupla>())
        if (!r.ok()) { return vazio }
        try {
            return json.decode<MeusPares>(r.corpo)
        } catch (String e) {
            return vazio
        }
    }

    static List<ResultadoPar> buscaDe(Resposta r) {
        if (!r.ok()) { return listOf<ResultadoPar>() }
        try {
            var lista = json.decode<ListaPares>(r.corpo)
            if (lista.items == null) { return listOf<ResultadoPar>() }
            return lista.items
        } catch (String e) {
            return listOf<ResultadoPar>()
        }
    }

    static List<MetaPopular> metasDe(Resposta r) {
        if (!r.ok()) { return listOf<MetaPopular>() }
        try {
            var lista = json.decode<MetasPopulares>(r.corpo)
            if (lista.items == null) { return listOf<MetaPopular>() }
            return lista.items
        } catch (String e) {
            return listOf<MetaPopular>()
        }
    }
}
