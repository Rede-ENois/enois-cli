package ui

import core.*

class Vista {

    Regioes regioes = Regioes()
    Rolagem rolagem
    List<AcaoRegiao> acoes = listOf<AcaoRegiao>()
    Int altura = 0
    String contexto = ""
    String secaoAtiva = ""
    ContagensNavegacao contagens = null
    Int linhaConteudo = 1
    Int alturaConteudo = 0
    List<String> quadro = listOf<String>()

    public constructor(Int altura) {
        this.altura = altura
        this.rolagem = Rolagem(altura)
    }

    List<String> fundo() {
        return this.quadro
    }

    void marcarSecoes(String contexto, String ativa, ContagensNavegacao contagens) {
        this.contexto = contexto
        this.secaoAtiva = ativa
        this.contagens = contagens
    }

    static Int alturaPadrao() {
        var total = Terminal.altura() - 9
        if (total < 6) { total = 6 }
        return total
    }

    void adicionar(Int indice, List<String> linhas) {
        this.rolagem.adicionar(Bloco(indice, linhas))
    }

    Int total() {
        return this.rolagem.tamanho()
    }

    String posicao() {
        var total = this.rolagem.tamanho()
        if (total <= 0) { return "" }
        return String.valueOf(this.rolagem.foco + 1) + "/" + String.valueOf(total)
    }

    List<String> montar(String topo, String cabecalho, String rodape) {
        Ansi.medir()
        var partesTopo = topo.split("\n")
        var partesCabecalho = cabecalho.split("\n")
        var partesRodape = rodape.split("\n")
        var conteudo = Terminal.altura() - 1 - partesTopo.length - partesCabecalho.length - partesRodape.length - 2
        if (conteudo < 4) { conteudo = 4 }
        this.altura = conteudo
        this.rolagem.altura = conteudo
        this.rolagem.limitar()
        this.regioes.limpar()
        var linhas = listOf<String>()
        for (var parte in partesTopo) { linhas.add(parte) }
        var linha = partesTopo.length + 1
        var indice = 0
        for (var parte in partesCabecalho) {
            linhas.add(parte)
            if (indice == 0 && this.contexto.length > 0) {
                BarraSecoes.registrar(this.regioes, linha, this.contexto, this.secaoAtiva, this.contagens)
            }
            indice = indice + 1
            linha = linha + 1
        }
        linhas.add("")
        linha = linha + 1
        this.linhaConteudo = linha
        this.alturaConteudo = conteudo
        var visiveis = this.rolagem.visiveis()
        for (var i = 0; i < visiveis.size(); i = i + 1) {
            linhas.add(visiveis.get(i))
            var bloco = this.rolagem.blocoDaLinha(this.rolagem.deslocamento + i)
            if (bloco >= 0) {
                var dado = this.rolagem.dadoDoBloco(bloco)
                var linhaNoBloco = this.rolagem.deslocamento + i - this.rolagem.inicioDoBloco(bloco)
                for (var acao in this.acoes) {
                    if (acao.dado != dado) { continue }
                    if (acao.linha != linhaNoBloco) { continue }
                    this.regioes.adicionarAcao(linha, acao.inicio, acao.fim, acao.indice, acao.tipo, dado)
                }
                this.regioes.adicionar(linha, 1, Ansi.LARGURA_CONTEUDO, dado, "item")
            }
            linha = linha + 1
        }
        linhas.add("")
        for (var parte in partesRodape) { linhas.add(parte) }
        this.quadro = linhas
        return linhas
    }

    void desenhar(String topo, String cabecalho, String rodape) {
        print(Ansi.LIMPAR)
        Vista.imprimir(this.montar(topo, cabecalho, rodape))
    }

    static void imprimir(List<String> linhas) {
        for (var linha in linhas) { println(linha) }
    }
}
