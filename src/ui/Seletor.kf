package ui

import core.*
import api.SinaisApi
import ui.Abas
import ui.Badge
import ui.Menu
import ui.Painel

class Seletor {

    static List<String> DIGITOS = listOf("1", "2", "3", "4", "5", "6", "7", "8", "9")

    Teclado teclado
    String contexto
    Int cursor
    List<ItemNavegacao> itens
    Cliente cliente
    SinaisApi sinaisApi
    ContagensNavegacao contagens
    Previa previa

    public constructor(String contexto, Cliente cliente) {
        this.teclado = Teclado()
        this.contexto = contexto
        this.cursor = 0
        this.itens = Navegacao.visiveis(contexto)
        this.cliente = cliente
        this.sinaisApi = SinaisApi(cliente)
        this.previa = Previa(cliente, contexto)
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), contexto == "social")
    }

    static Int digito(String caractere) {
        for (var i = 0; i < Seletor.DIGITOS.size(); i = i + 1) {
            if (Seletor.DIGITOS.get(i) == caractere) { return i }
        }
        return -1
    }

    static Bool encerra(Tecla tecla) {
        if (tecla.nome == "escape" || tecla.nome == "ctrl-c") { return true }
        return tecla.nome == "texto" && (tecla.caractere == "q" || tecla.caractere == "0")
    }

    String contextoDoServidor() {
        if (this.contexto == "profissional") { return "PROFESSIONAL" }
        return "SOCIAL"
    }

    void recarregar() {
        this.contagens = this.sinaisApi.carregar(this.contextoDoServidor(), this.contexto == "social")
    }

    String escolher(String topo, String dica) {
        if (!this.teclado.entrar()) { return "" }
        print(Ansi.OCULTAR_CURSOR)
        print(Ansi.ALTERNATIVO)
        var rota = ""
        var seguindo = true
        while (seguindo) {
            this.desenhar(topo, dica)
            var tecla = this.teclado.ler()
            if (tecla.nome == "cima" || (tecla.nome == "texto" && tecla.caractere == "k")) {
                this.mover(-1)
            } else if (tecla.nome == "baixo" || (tecla.nome == "texto" && tecla.caractere == "j")) {
                this.mover(1)
            } else if (tecla.nome == "tab" || tecla.nome == "voltar-aba") {
                this.alternarContexto()
            } else if (tecla.nome == "enter") {
                seguindo = this.confirmar(this.cursor, rota)
                if (!seguindo) { rota = this.rotaDo(this.cursor) }
            } else if (tecla.nome == "texto" && tecla.caractere == "r") {
                this.previa.limpar()
                this.recarregar()
            } else if (tecla.nome == "texto") {
                var atalho = Seletor.digito(tecla.caractere)
                if (atalho >= 0) {
                    this.cursor = atalho
                    seguindo = this.confirmar(this.cursor, rota)
                    if (!seguindo) { rota = this.rotaDo(this.cursor) }
                } else if (Seletor.encerra(tecla)) {
                    seguindo = false
                }
            } else if (Seletor.encerra(tecla)) {
                seguindo = false
            }
        }
        print(Ansi.NORMAL)
        print(Ansi.MOSTRAR_CURSOR)
        this.teclado.sair()
        return rota
    }

    Bool confirmar(Int indice, String rota) {
        if (indice < 0 || indice >= this.itens.size()) { return true }
        if (this.itens.get(indice).rota == "trocar contexto") {
            this.alternarContexto()
            return true
        }
        return false
    }

    String rotaDo(Int indice) {
        if (indice < 0 || indice >= this.itens.size()) { return "" }
        return this.itens.get(indice).rota
    }

    void mover(Int passo) {
        var novo = this.cursor + passo
        if (novo < 0) { novo = this.itens.size() - 1 }
        if (novo >= this.itens.size()) { novo = 0 }
        this.cursor = novo
    }

    void alternarContexto() {
        this.contexto = Navegacao.proximoContexto(this.contexto)
        this.itens = Navegacao.visiveis(this.contexto)
        this.cursor = 0
        this.recarregar()
        this.previa.trocarContexto(this.contexto)
    }

    void desenhar(String topo, String dica) {
        var largura = Ansi.LARGURA_CONTEUDO
        print(Ansi.LIMPAR)
        println(topo)
        println("")
        println(Abas.lista(Navegacao.CONTEXTOS, this.contexto))
        println("")
        if (Painel.cabe(largura)) {
            var esquerda = this.menu(Painel.larguraEsquerda(largura))
            var direita = this.previaDe(Painel.larguraDireita(largura))
            for (var linha in Painel.linhas(esquerda, direita, largura)) { println(linha) }
        } else {
            for (var linha in this.menu(largura)) { println(linha) }
        }
        println("")
        println(Menu.rodape(dica))
    }

    List<String> menu(Int largura) {
        var linhas = listOf<String>()
        var secao = ""
        var numero = 1
        for (var i = 0; i < this.itens.size(); i = i + 1) {
            var item = this.itens.get(i)
            if (item.secao != secao) {
                secao = item.secao
                if (linhas.size() > 0) { linhas.add("") }
                linhas.add(Abas.grupo(secao))
            }
            var rotulo = this.rotulo(numero, item, largura)
            if (i == this.cursor) {
                linhas.add(Tema.selecionado(Ansi.padDireita(rotulo, largura)))
            } else {
                linhas.add(rotulo)
            }
            numero = numero + 1
        }
        return linhas
    }

    String rotulo(Int numero, ItemNavegacao item, Int largura) {
        var texto = "  " + Ansi.padEsquerda(String.valueOf(numero), 2) + ". " + item.rotulo
        var selo = this.selo(item)
        if (selo.length > 0) { texto = texto + " " + selo }
        var sobra = largura - Ansi.largura(texto) - 3
        if (item.descricao.length > 0 && sobra > 8) {
            texto = texto + "  " + Tema.mudo(Ansi.cortar(item.descricao, sobra))
        }
        return texto
    }

    String selo(ItemNavegacao item) {
        return Badge.sinal(Sinais.de(item.rota, item.notifica, this.contagens))
    }

    ItemNavegacao itemAtual() {
        if (this.itens.size() == 0) { return ItemNavegacao("", "", "", "", null, null) }
        var indice = this.cursor
        if (indice < 0 || indice >= this.itens.size()) { indice = 0 }
        return this.itens.get(indice)
    }

    Int limite() {
        var total = Terminal.altura() - 10
        if (total < 8) { total = 8 }
        if (total > 24) { total = 24 }
        return total
    }

    List<String> previaDe(Int largura) {
        var item = this.itemAtual()
        var linhas = listOf<String>()
        linhas.add(Tema.destaque(item.rotulo))
        if (item.descricao.length > 0) {
            for (var parte in Ansi.quebrar(item.descricao, largura)) { linhas.add(Tema.mudo(parte)) }
        }
        var selo = this.selo(item)
        if (selo.length > 0) {
            linhas.add("")
            linhas.add(Tema.suave("sinal ") + selo)
        }
        linhas.add("")
        linhas.add(Ansi.divisor(largura, Tema.BORDA_SUAVE))
        this.previaCorpo(linhas, item, largura)
        return linhas
    }

    void previaCorpo(List<String> linhas, ItemNavegacao item, Int largura) {
        var limite = this.limite()
        for (var bruta in this.previa.linhas(item.rota)) {
            if (linhas.size() >= limite) { return }
            for (var parte in Ansi.quebrar(bruta, largura)) {
                if (linhas.size() >= limite) { return }
                linhas.add(parte)
            }
        }
    }
}
