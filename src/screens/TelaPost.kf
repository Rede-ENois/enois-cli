package screens

import tipos.*
import api.*
import core.*
import ui.*
import servicos.*

class TelaPost {

    Cliente cliente
    PostResumo post
    ComentarioService servico
    PostService postServico
    Vista vista
    Teclado teclado
    String status = ""
    String destino = ""
    Int largura = 0
    Bool ocupado = false
    Bool saindo = false

    public constructor(Cliente cliente) {
        this.cliente = cliente
        this.servico = ComentarioService(cliente)
        this.postServico = PostService(cliente)
    }

    void executar(PostResumo post) {
        TelaPostSimples(this.cliente).executar(post)
    }

    String executarInterativo(PostResumo post, Teclado teclado) {
        this.post = post
        this.teclado = teclado
        this.vista = Vista(Vista.alturaPadrao())
        Imagem.preparar(post)
        this.carregarComentarios()
        var rodando = true
        var pintar = true
        while (rodando && Entrada.ativa) {
            if (this.servico.temMais && this.vista.rolagem.noFim()) {
                this.carregarMais()
            }
            if (pintar) {
                this.desenhar()
                teclado.ligarMouse()
            }
            pintar = true
            var tecla = teclado.ler()
            if (tecla.nome == "clique") {
                if (!this.clicar(tecla)) { pintar = false }
            } else if (tecla.nome == "cima") {
                this.vista.rolagem.moverFoco(-1)
            } else if (tecla.nome == "baixo") {
                this.vista.rolagem.moverFoco(1)
            } else if (tecla.nome == "roda-cima") {
                this.vista.rolagem.rolar(-3)
            } else if (tecla.nome == "roda-baixo") {
                this.vista.rolagem.rolar(3)
            } else if (tecla.nome == "enter") {
                this.responderFoco()
            } else if (tecla.nome == "texto") {
                this.destino = this.atalho(tecla.caractere)
            } else if (tecla.nome == "escape" || tecla.nome == "ctrl-c") {
                rodando = false
            } else if (Teclado.inerte(tecla)) {
                pintar = false
            }
            if (this.saindo || this.destino.length > 0) { rodando = false }
        }
        return this.destino
    }

    String atalho(String caractere) {
        var comentario = this.comentarioFoco()
        if (caractere == "q" || caractere == "Q") { this.saindo = true }
        if (caractere == "r" || caractere == "R") { this.recarregar() }
        if (caractere == "m" || caractere == "M") { this.mostrarImagens() }
        if (caractere == "c" || caractere == "C") { this.comentar(comentario) }
        if (caractere == "l" || caractere == "L") { this.curtir(comentario) }
        if (caractere == "e" || caractere == "E") { this.reagir(comentario) }
        if (comentario == null) {
            if (caractere == "s" || caractere == "S") { this.salvar() }
            if (caractere == "x" || caractere == "X") { this.compartilhar() }
            if (caractere == "p" || caractere == "P") { this.repostar() }
        } else {
            if (caractere == "t" || caractere == "T") { this.editar(comentario) }
            if (caractere == "d" || caractere == "D") { this.apagar(comentario) }
            if (caractere == "p" || caractere == "P") { this.fixar(comentario) }
        }
        var indice = Seletor.digito(caractere)
        if (indice >= 0) {
            var rotas = Navegacao.secoesDe(this.contexto())
            if (indice < rotas.size()) { return rotas.get(indice) }
        }
        return ""
    }

    String contexto() {
        if (this.cliente == null || this.cliente.config == null) { return "social" }
        return this.cliente.config.contexto
    }

    String usuarioId() {
        if (this.cliente == null || this.cliente.sessao == null) { return "" }
        var usuario = this.cliente.sessao.usuario
        if (usuario == null) { return "" }
        return usuario.id
    }

    Bool meuPost() {
        if (this.post.authorId == null) { return false }
        return this.post.authorId == this.usuarioId()
    }

    void desenhar() {
        Ansi.medir()
        if (this.largura != Ansi.LARGURA_CONTEUDO) { this.reconstruir() }
        var topo = Cabecalho.linha(this.cliente, "post", this.contexto())
        var cabecalho = Caixa.juntar(BarraSecoes.linhas(this.contexto(), "feed", this.contagens()))
        this.vista.marcarSecoes(this.contexto(), "feed", null)
        var rodape = Caixa.juntar(BarraContexto.linhas(this.atalhos(), this.status, this.vista.posicao()))
        this.vista.desenhar(topo, cabecalho, rodape)
    }

    ContagensNavegacao contagens() {
        return ContagensNavegacao(null, listOf<String>(), 0, 0)
    }

    List<String> atalhos() {
        var lista = listOf<String>()
        var comentario = this.comentarioFoco()
        if (comentario == null) {
            lista.add("↑↓ navega")
            lista.add("L curtir")
            lista.add("E reagir")
            lista.add("C comenta")
            lista.add("R atualiza")
            lista.add("S salvar")
            lista.add("X compartilhar")
            lista.add("P reposta")
            lista.add("M mídias")
            lista.add("Q volta")
            return lista
        }
        lista.add("enter responde")
        lista.add("L curtir")
        lista.add("E reagir")
        if (comentario.meu(this.usuarioId())) {
            lista.add("T editar")
            lista.add("D apagar")
        } else if (this.meuPost()) {
            lista.add("P fixa")
        }
        lista.add("C comenta")
        lista.add("R atualiza")
        lista.add("M mídias")
        lista.add("Q volta")
        return lista
    }

    Bool clicar(Tecla tecla) {
        var alvo = this.vista.regioes.em(tecla.linha, tecla.coluna)
        if (alvo.tipo == "secao") {
            var rotas = Navegacao.secoesDe(this.contexto())
            if (alvo.indice >= 0 && alvo.indice < rotas.size()) {
                this.destino = rotas.get(alvo.indice)
            }
            return true
        }
        if (alvo.tipo == "acao") {
            this.clicarAcao(alvo.dado, alvo.indice)
            return true
        }
        if (alvo.tipo != "item") { return false }
        this.vista.rolagem.foco = alvo.dado
        return true
    }

    void clicarAcao(Int dado, Int acao) {
        var indice = dado - 1
        if (indice < 0 || indice >= this.servico.comentarios.size()) { return }
        this.vista.rolagem.foco = dado
        var comentario = this.servico.comentarios.get(indice)
        if (acao == 0) { this.reagirComentario(comentario, "LIKE") }
        if (acao == 1) { this.comentar(comentario) }
        if (acao == 2) { this.editar(comentario) }
        if (acao == 3) { this.apagar(comentario) }
    }

    Comentario? comentarioFoco() {
        var dado = this.vista.rolagem.dadoDoBloco(this.vista.rolagem.foco)
        if (dado <= 0) { return null }
        var indice = dado - 1
        if (indice >= this.servico.comentarios.size()) { return null }
        return this.servico.comentarios.get(indice)
    }

    void reconstruir() {
        var deslocamento = this.vista.rolagem.deslocamento
        var foco = this.vista.rolagem.foco
        this.vista = Vista(Vista.alturaPadrao())
        this.vista.adicionar(0, Cartao.linhasCompletas(this.post, Ansi.LARGURA_CONTEUDO,
            Cartao.usuarioAtual(this.cliente)))
        var autor = this.usuarioId()
        var acoes = listOf<AcaoRegiao>()
        for (var i = 0; i < this.servico.comentarios.size(); i = i + 1) {
            var comentario = this.servico.comentarios.get(i)
            var linhas = CartaoComentario.linhas(comentario, Ansi.LARGURA_CONTEUDO,
                this.servico.nivel(comentario.id), autor)
            this.vista.adicionar(i + 1, linhas)
            var daLinha = CartaoComentario.acoes(comentario, autor)
            var linha = linhas.size() - 1
            for (var j = 0; j < daLinha.size(); j = j + 1) {
                var acao = daLinha.get(j)
                acoes.add(AcaoRegiao(i + 1, linha, acao.inicio + 1, acao.fim + 1, acao.indice, "acao"))
            }
        }
        this.vista.acoes = acoes
        this.vista.rolagem.deslocamento = deslocamento
        this.vista.rolagem.foco = foco
        this.largura = Ansi.LARGURA_CONTEUDO
    }

    void carregarComentarios() {
        if (!this.servico.carregar(this.post.id)) {
            this.status = Tema.mudo("comentários indisponíveis")
        }
        this.reconstruir()
    }

    void carregarMais() {
        this.status = Tema.mudo("carregando mais comentários…")
        this.desenhar()
        if (!this.servico.carregarMais(this.post.id)) {
            this.status = Tema.erro("não carregou mais comentários")
            return
        }
        this.reconstruir()
        this.status = Tema.mudo(String.valueOf(this.servico.comentarios.size()) + " comentários")
    }

    void responderFoco() {
        var comentario = this.comentarioFoco()
        if (comentario == null) { return }
        this.comentar(comentario)
    }

    void comentar(Comentario? pai) {
        var usuarioPai = ""
        if (pai != null) { usuarioPai = pai.usuario() }
        var modal = ModalComentario(this.teclado, this.vista.fundo(), usuarioPai, false, "")
        var enviou = modal.executar()
        this.restaurar()
        if (!enviou) { return }
        var texto = modal.texto().trim()
        if (texto.length == 0) {
            this.status = Tema.mudo("comentário vazio")
            return
        }
        var resultado = ResultadoComentario(false, "", null)
        if (pai == null) {
            resultado = this.servico.criar(this.post.id, texto, null)
        } else {
            resultado = this.servico.criar(this.post.id, texto, pai.id)
        }
        if (!resultado.sucesso) {
            this.status = Tema.erro(resultado.mensagem)
            return
        }
        this.post = this.post.comComentario()
        this.status = Tema.ok(resultado.mensagem)
        this.reconstruir()
        this.focarComentario(resultado.comentario)
    }

    void focarComentario(Comentario? comentario) {
        if (comentario == null) { return }
        for (var i = 0; i < this.servico.comentarios.size(); i = i + 1) {
            if (this.servico.comentarios.get(i).id == comentario.id) {
                this.vista.rolagem.foco = i + 1
                this.vista.rolagem.alinhar()
                return
            }
        }
    }

    void editar(Comentario comentario) {
        if (!comentario.meu(this.usuarioId())) {
            this.status = Tema.mudo("só o autor edita este comentário")
            return
        }
        var atual = ""
        if (comentario.content != null) { atual = comentario.content }
        var modal = ModalComentario(this.teclado, this.vista.fundo(), "", true, atual)
        var enviou = modal.executar()
        this.restaurar()
        if (!enviou) { return }
        var texto = modal.texto().trim()
        if (texto.length == 0) {
            this.status = Tema.mudo("edição vazia")
            return
        }
        var resultado = this.servico.editar(this.post.id, comentario.id, texto)
        if (!resultado.sucesso) {
            this.status = Tema.erro(resultado.mensagem)
            return
        }
        this.status = Tema.ok(resultado.mensagem)
        this.reconstruir()
    }

    void apagar(Comentario comentario) {
        if (!comentario.meu(this.usuarioId())) {
            this.status = Tema.mudo("só o autor apaga este comentário")
            return
        }
        var confirmacao = ModalConfirmacao(this.teclado, this.vista.fundo(),
            "apagar o comentário de @" + comentario.usuario() + "?")
        var confirmou = confirmacao.executar()
        this.restaurar()
        if (!confirmou) { return }
        var resultado = this.servico.apagar(this.post.id, comentario.id)
        if (!resultado.sucesso) {
            this.status = Tema.erro(resultado.mensagem)
            return
        }
        this.status = Tema.ok(resultado.mensagem)
        this.reconstruir()
    }

    void fixar(Comentario comentario) {
        if (comentario.resposta()) {
            this.status = Tema.mudo("só comentários raiz podem ser fixados")
            return
        }
        if (!comentario.meu(this.usuarioId()) && !this.meuPost()) {
            this.status = Tema.mudo("só o autor do post ou do comentário fixa")
            return
        }
        var resultado = ResultadoComentario(false, "", null)
        if (comentario.fixado()) {
            resultado = this.servico.desafixar(this.post.id, comentario.id)
        } else {
            resultado = this.servico.fixar(this.post.id, comentario.id)
        }
        if (!resultado.sucesso) {
            this.status = Tema.erro(resultado.mensagem)
            return
        }
        this.carregarComentarios()
        this.status = Tema.ok(resultado.mensagem)
    }

    void curtir(Comentario? comentario) {
        if (comentario == null) {
            this.aplicarReacao("LIKE")
            return
        }
        this.reagirComentario(comentario, "LIKE")
    }

    void reagir(Comentario? comentario) {
        var tipos = listOf<String>()
        var rotulos = listOf<String>()
        for (var i = 0; i < Reacoes.TIPOS.size(); i = i + 1) {
            tipos.add(Reacoes.TIPOS.get(i))
            rotulos.add(Reacoes.rotulo(Reacoes.TIPOS.get(i)))
        }
        var modal = ModalReacoes(this.teclado, this.vista.fundo(), tipos, rotulos)
        var escolheu = modal.executar()
        this.restaurar()
        if (!escolheu) { return }
        if (comentario == null) {
            this.aplicarReacao(modal.escolhido)
        } else {
            this.reagirComentario(comentario, modal.escolhido)
        }
    }

    void reagirComentario(Comentario comentario, String tipo) {
        var resultado = this.servico.reagir(this.post.id, comentario.id, tipo)
        if (!resultado.sucesso) {
            this.status = Tema.erro(resultado.mensagem)
            return
        }
        this.status = Tema.ok(resultado.mensagem)
        this.reconstruir()
    }

    void aplicarReacao(String tipo) {
        if (this.ocupado) { return }
        if (!this.postServico.podeAlternar(this.post.id)) { return }
        this.postServico.marcar(this.post.id)
        this.ocupado = true
        var anterior = this.post
        var removendo = anterior.temReacao(tipo)
        this.post = this.post.reacaoOtimista(tipo)
        this.reconstruir()
        this.status = Tema.mudo("reagindo…")
        var r = this.postServico.confirmar(anterior, tipo)
        this.ocupado = false
        if (!r.sucesso) {
            this.status = Tema.erro(r.mensagem)
            this.post = anterior
            this.reconstruir()
            return
        }
        this.post = r.post
        this.status = Tema.ok(if (removendo) { "reação removida" } else { "reação registrada" })
        this.reconstruir()
    }

    void salvar() {
        var r = PostApi(this.cliente).salvar(this.post.id)
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        this.status = Tema.ok("post salvo")
    }

    void compartilhar() {
        var r = PostApi(this.cliente).compartilhar(this.post.id)
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        this.status = Tema.ok("compartilhado")
    }

    void repostar() {
        var opiniao = this.perguntar("sua opinião (opcional)")
        var r = Resposta(0, "", "")
        if (opiniao.length == 0) {
            r = PostApi(this.cliente).republicar(this.post.id, null, null)
        } else {
            r = PostApi(this.cliente).republicar(this.post.id, opiniao, null)
        }
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        this.status = Tema.ok("repostado")
    }

    void recarregar() {
        if (this.ocupado) { return }
        this.ocupado = true
        this.status = Tema.mudo("atualizando…")
        var r = FeedApi(this.cliente).obter(this.post.id)
        this.ocupado = false
        if (!r.ok()) {
            this.status = Tema.erro(r.mensagem())
            return
        }
        var atualizado = FeedApi.post(r)
        if (atualizado != null) { this.post = atualizado }
        this.carregarComentarios()
        this.status = Tema.ok("atualizado")
    }

    String perguntar(String rotulo) {
        this.teclado.sair()
        Ansi.escrever(Ansi.MOSTRAR_CURSOR)
        var texto = Entrada.texto(rotulo)
        Ansi.escrever(Ansi.OCULTAR_CURSOR)
        this.teclado.entrar()
        return texto
    }

    void mostrarImagens() {
        if (!GaleriaTela.abrir(this.teclado, this.post)) {
            this.status = Tema.mudo("este post não tem mídias")
            return
        }
        this.restaurar()
    }

    void restaurar() {
        print(Ansi.LIMPAR)
        Vista.imprimir(this.vista.montar(
            Cabecalho.linha(this.cliente, "post", this.contexto()),
            Caixa.juntar(BarraSecoes.linhas(this.contexto(), "feed", this.contagens())),
            Caixa.juntar(BarraContexto.linhas(this.atalhos(), this.status, this.vista.posicao()))))
    }
}
