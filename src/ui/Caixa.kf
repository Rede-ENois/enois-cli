package ui

import core.Ansi
import core.Tema

/**
 * Card do DS: fundo `card`, canto arredondado simulado por bordas finas na
 * cor `border-soft`, título em `primary` e conteúdo com quebra de linha.
 *
 * O DS usa radius 1rem e sombra suave; no terminal, o card é uma caixa de
 * "╭╮╰╯│─" com o fundo colorido — superfície sem borda dura.
 */
class Caixa {

    /** Largura padrão dos cards: a coluna de conteúdo do DS (100 colunas). */
    static Int larguraPadrao() {
        return Ansi.LARGURA_CONTEUDO
    }

    /** Card com título e um bloco de texto livre; multi-linha quebra por \n. */
    static List<String> card(String titulo, String corpo) {
        var largura = Caixa.larguraPadrao()
        var interna = largura - 4
        var linhas = listOf<String>()
        linhas.add(Caixa.linhaSuperior(largura))
        var rotulo = " " + titulo + " "
        linhas.add(Caixa.conteudo(Tema.destaque(rotulo), interna))
        linhas.add(Caixa.linhaMeio(largura))
        for (var parte in Ansi.quebrar(corpo, interna)) {
            linhas.add(Caixa.conteudo(parte, interna))
        }
        linhas.add(Caixa.linhaInferior(largura))
        return linhas
    }

    /** Card com corpo multi-linha (post): quebra cada linha por `\n` e desenha. */
    static List<String> cartao(String corpo) {
        var largura = Caixa.larguraPadrao()
        var interna = largura - 4
        var linhas = listOf<String>()
        linhas.add(Caixa.linhaSuperior(largura))
        for (var linha in Caixa.partes(corpo)) {
            for (var parte in Ansi.quebrar(linha, interna)) {
                linhas.add(Caixa.conteudo(parte, interna))
            }
        }
        linhas.add(Caixa.linhaInferior(largura))
        return linhas
    }

    /** Divide o corpo em linhas mantendo as vazias (o `split` do Kof pula vazias). */
    static List<String> partes(String corpo) {
        var saida = listOf<String>()
        var atual = ""
        for (var i = 0; i < corpo.length; i = i + 1) {
            var c = corpo.substring(i, i + 1)
            if (c == "\n") {
                saida.add(atual)
                atual = ""
            } else {
                atual = atual + c
            }
        }
        saida.add(atual)
        return saida
    }

    /** Card simples, sem título: só o corpo dentro da borda. */
    static List<String> simples(String corpo) {
        var largura = Caixa.larguraPadrao()
        var interna = largura - 4
        var linhas = listOf<String>()
        linhas.add(Caixa.linhaSuperior(largura))
        for (var parte in Ansi.quebrar(corpo, interna)) {
            linhas.add(Caixa.conteudo(parte, interna))
        }
        linhas.add(Caixa.linhaInferior(largura))
        return linhas
    }

    /** Desenha a lista de linhas na saída padrão. */
    static void desenhar(List<String> linhas) {
        for (var l in linhas) {
            println(l)
        }
    }

    static String linhaSuperior(Int largura) {
        var meio = ""
        for (var i = 0; i < largura - 2; i = i + 1) {
            meio = meio + "─"
        }
        return Tema.pinta(Tema.BORDA_SUAVE, "╭" + meio + "╮")
    }

    static String linhaMeio(Int largura) {
        var meio = ""
        for (var i = 0; i < largura - 2; i = i + 1) {
            meio = meio + "─"
        }
        return Tema.pinta(Tema.BORDA_SUAVE, "├" + meio + "┤")
    }

    static String linhaInferior(Int largura) {
        var meio = ""
        for (var i = 0; i < largura - 2; i = i + 1) {
            meio = meio + "─"
        }
        return Tema.pinta(Tema.BORDA_SUAVE, "╰" + meio + "╯")
    }

    /** Uma linha de conteúdo: texto à esquerda, padding colorido, borda. */
    static String conteudo(String texto, Int interna) {
        var restante = interna - Ansi.largura(texto)
        var espacos = ""
        for (var i = 0; i < restante; i = i + 1) {
            espacos = espacos + " "
        }
        return Tema.pinta(Tema.BORDA_SUAVE, "│ ") + texto + espacos + Tema.pinta(Tema.BORDA_SUAVE, " │")
    }
}
