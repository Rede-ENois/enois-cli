package api

record Notificacao(
    String id,
    String? kind,
    String? context,
    String? module,
    String? actorId,
    String? actorName,
    String? actorUsername,
    String? actorAvatar,
    String? title,
    String? body,
    String? preview,
    String? createdAt,
    Troolean? read,
    String? href,
    String? ctaLabel,
    Int? actorCount
)

record PaginaNotificacao(List<Notificacao>? items, String? nextCursor)

record ResumoNaoLidas(Int? mensagens, Int? notificacoes, Int? total)
