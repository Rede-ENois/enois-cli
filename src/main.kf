import core.*
import api.*
import ui.*
import screens.*

main() {
    var cfg = Config.carregar()
    var s = Sessao.carregar()
    var cliente = Cliente(cfg, s)
    var entrar = TelaEntrar(cliente, cfg, s)
    var feed = TelaFeed(cliente)
    var notificacoes = TelaNotificacoes(cliente)
    var mensagens = TelaMensagens(cliente, s)
    var perfil = TelaPerfil(cliente, s)
    var executando = true
    while (executando && Entrada.ativa) {
        print(Ansi.LIMPAR)
        var usuario = ""
        if (s.logado() && s.usuario != null) { usuario = s.usuario.usuario }
        println(Menu.topo("énois", usuario))
        println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
        var estado = Tema.mudo("sem sessão · alvo: " + cfg.alvo)
        if (s.logado()) { estado = Tema.ok("sessão ativa") + Tema.mudo(" · alvo: " + cfg.alvo) }
        println(estado)
        var opcoes = listOf<String>()
        if (s.logado()) {
            opcoes = listOf("feed", "notificações", "mensagens", "perfil", "sair", "trocar alvo")
        } else {
            opcoes = listOf("entrar", "trocar alvo")
        }
        var escolha = Entrada.menu("principal", opcoes, "encerrar")
        if (escolha < 0) {
            executando = false
        } else if (opcoes.get(escolha) == "entrar") {
            if (entrar.executar()) { entrar.provarFeed() }
        } else if (opcoes.get(escolha) == "notificações") {
            notificacoes.executar()
        } else if (opcoes.get(escolha) == "mensagens") {
            mensagens.executar()
        } else if (opcoes.get(escolha) == "perfil") {
            perfil.executar()
        } else if (opcoes.get(escolha) == "sair") {
            cliente.sair()
            println(Tema.mudo("sessão encerrada"))
        } else if (opcoes.get(escolha) == "feed") {
            var r = FeedApi(cliente).listar(null, 10)
            if (!r.ok()) {
                println(Tema.erro(r.mensagem()))
                Entrada.pausar()
            } else {
                var rodando = true
                while (rodando) {
                    rodando = feed.pagina(FeedApi.paginaFeed(r))
                    if (rodando) {
                        var cursor = ""
                        var p = FeedApi.paginaFeed(r)
                        if (p.nextCursor != null) { cursor = p.nextCursor }
                        r = FeedApi(cliente).listar(cursor, 10)
                        if (!r.ok()) { println(Tema.erro(r.mensagem())); rodando = false }
                    }
                }
            }
        } else if (opcoes.get(escolha) == "trocar alvo") {
            if (cfg.alvo == "qa") {
                cfg.usaAlvo("producao")
            } else {
                cfg.usaAlvo("qa")
            }
            cfg.salvar()
            println(Tema.suave("alvo: " + cfg.alvo))
        }
    }
    println(Tema.mudo("até já"))
}
