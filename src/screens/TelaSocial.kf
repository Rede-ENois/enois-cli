package screens

import core.Ansi
import core.Cliente
import core.Entrada
import core.Sessao
import core.Tema
import ui.Menu

class TelaSocial {

    Cliente cliente
    Sessao sessao

    public constructor(Cliente cliente, Sessao sessao) {
        this.cliente = cliente
        this.sessao = sessao
    }

    void executar() {
        var rodando = true
        while (rodando && Entrada.ativa) {
            print(Ansi.LIMPAR)
            println(Menu.topo("énois", ""))
            println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
            println(Tema.destaque("social"))
            println(Tema.mudo("jogos, campanhas, blogs, murais, desafios e empresas"))
            var escolha = Entrada.menu("social", listOf("jogos", "roleplay", "blogs", "murais",
                "desafios", "papo reto", "empresas", "projetos", "selos"), "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == 0) {
                TelaJogos(this.cliente).executar()
            } else if (escolha == 1) {
                TelaRoleplay(this.cliente).executar()
            } else if (escolha == 2) {
                TelaBlogs(this.cliente).executar()
            } else if (escolha == 3) {
                TelaMurais(this.cliente).executar()
            } else if (escolha == 4) {
                TelaDesafios(this.cliente).executar()
            } else if (escolha == 5) {
                TelaPapoReto(this.cliente).executar()
            } else if (escolha == 6) {
                TelaEmpresas(this.cliente).executar()
            } else if (escolha == 7) {
                TelaProjetos(this.cliente, this.sessao).executar()
            } else {
                TelaSelos(this.cliente, this.sessao).executar()
            }
        }
    }
}
