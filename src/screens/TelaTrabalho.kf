package screens

import core.Ansi
import core.Cliente
import core.Entrada
import core.Tema
import ui.Menu

class TelaTrabalho {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    void executar() {
        var rodando = true
        while (rodando && Entrada.ativa) {
            print(Ansi.LIMPAR)
            println(Menu.topo("énois", ""))
            println(Ansi.divisor(Ansi.LARGURA_CONTEUDO, Tema.BORDA_SUAVE))
            println(Tema.destaque("trabalho"))
            println(Tema.mudo("carreira, serviços e compromissos"))
            var escolha = Entrada.menu("trabalho",
                listOf("vagas", "freelas", "serviços", "mentoria", "agenda"), "voltar")
            if (escolha < 0) {
                rodando = false
            } else if (escolha == 0) {
                TelaVagas(this.cliente).executar()
            } else if (escolha == 1) {
                TelaFreelas(this.cliente).executar()
            } else if (escolha == 2) {
                TelaServicos(this.cliente).executar()
            } else if (escolha == 3) {
                TelaMentoria(this.cliente).executar()
            } else if (escolha == 4) {
                TelaAgenda(this.cliente).executar()
            }
        }
    }
}
