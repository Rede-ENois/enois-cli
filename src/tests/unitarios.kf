test "base64 codifica os bytes certinhos" {
    assert(Base64.codificar(Base64.deBytes("Man".getBytes())) == "TWFu")
    assert(Base64.codificar(Base64.deBytes("Ma".getBytes())) == "TWE=")
    assert(Base64.codificar(Base64.deBytes("M".getBytes())) == "TQ==")
    assert(Base64.codificar(Base64.deBytes("".getBytes())) == "")
    assert(Base64.codificar(Base64.deBytes("Mele".getBytes())) == "TWVsZQ==")
    assert(Base64.codificar(Base64.deBytes("Mel".getBytes())) == "TWVs")
}

test "base64 quebra o arquivo em blocos de tres bytes" {
    var bytes = Base64.deBytes("abcdefg".getBytes())
    var blocos = Base64.blocos(bytes, 4)
    assert(blocos.size() == 3)
    assert(blocos.get(0) == "YWJj")
    assert(blocos.get(1) == "ZGVm")
    assert(blocos.get(2) == "Zw==")
    var inteiro = Base64.blocos(bytes, 6)
    assert(inteiro.size() == 2)
    assert(inteiro.get(0) == "YWJjZGVm")
    assert(inteiro.get(1) == "Zw==")
}

test "url de midia completa o endereco do cdn" {
    assert(Midia.url("/media/a.png") == "https://ik.imagekit.io/socialcoisa/media/a.png")
    assert(Midia.url("media/a.png") == "https://ik.imagekit.io/socialcoisa/media/a.png")
    assert(Midia.url("https://exemplo.test/a.png") == "https://exemplo.test/a.png")
    assert(Midia.url("") == "")
}

test "url de midia desescapa a barra codificada" {
    assert(Midia.url("/media%2Fa.png") == "https://ik.imagekit.io/socialcoisa/media/a.png")
}

test "extensao da midia sai do endereco" {
    assert(Midia.extensao("https://x.test/a/b/avatar.PNG") == ".png")
    assert(Midia.extensao("https://x.test/a/b/avatar.png?w=100") == ".png")
    assert(Midia.extensao("https://x.test/a/b/avatar") == ".bin")
    assert(Midia.extensao("https://x.test/a.b/c") == ".bin")
}

test "protocolo de imagem segue o terminal" {
    assert(Imagem.protocolo("xterm-kitty", "", "") == "kitty")
    assert(Imagem.protocolo("xterm-256color", "iTerm.app", "") == "iterm2")
    assert(Imagem.protocolo("xterm-256color", "", "") == "")
}

test "sequencia do kitty carrega os blocos" {
    var blocos = listOf("YWJj", "ZGVmZw==")
    var saida = Imagem.kittyDeBlocos(blocos, 20)
    assert(saida.contains("_Gf=100,a=T,t=d,i=1,c=20"))
    assert(saida.contains("YWJj"))
    assert(saida.contains("ZGVmZw=="))
    assert(saida.endsWith("\u001b\\"))
}

test "iniciais do avatar seguem o padrao do design system" {
    assert(Imagem.iniciais("Mel Monfre", "") == "MM")
    assert(Imagem.iniciais("Mel", "") == "M")
    assert(Imagem.iniciais("", "melmonfre") == "M")
    assert(Imagem.iniciais("", "") == "?")
}

test "miniatura mantem proporcao e cabe no limite" {
    assert(Png.alvoLargura(5120, 2880, 256) == 256)
    assert(Png.alvoAltura(5120, 2880, 256) == 144)
    assert(Png.alvoLargura(2880, 5120, 256) == 144)
    assert(Png.alvoAltura(2880, 5120, 256) == 256)
    assert(Png.alvoLargura(100, 80, 256) == 100)
    assert(Png.alvoAltura(100, 80, 256) == 80)
}

test "miniatura nunca fica com lado zero" {
    assert(Png.alvoLargura(10, 1000, 256) == 2)
    assert(Png.alvoAltura(1000, 10, 256) == 2)
    assert(Png.aoMenos1(0) == 1)
}

test "png pronto vai direto para o terminal" {
    assert(Imagem.paraPng("/cache/a.png") == "/cache/a.png")
}

test "sinal de mensagens segue a contagem de nao lidas" {
    var contagens = ContagensNavegacao(null, listOf<String>(), 3, 0)
    var sinal = Sinais.de("mensagens", null, contagens)
    assert(sinal != null)
    if (sinal != null) {
        assert(sinal.forma == "messages")
        assert(sinal.contagem == 3)
    }
}

test "rota sem contagem nenhuma nao ganha sinal" {
    var contagens = ContagensNavegacao(null, listOf<String>(), 0, 0)
    assert(Sinais.de("mensagens", null, contagens) == null)
    assert(Sinais.de("rede", null, contagens) == null)
    assert(Sinais.de("feed", null, contagens) == null)
    assert(Sinais.de("notificações", null, contagens) == null)
}

test "pedidos pendentes viram contagem na rede" {
    var contagens = ContagensNavegacao(null, listOf<String>(), 0, 4)
    var sinal = Sinais.de("rede", null, contagens)
    assert(sinal != null)
    if (sinal != null) {
        assert(sinal.forma == "count")
        assert(sinal.contagem == 4)
    }
}

test "avisos descontam os modulos desativados" {
    var resumo = ResumoSinal(5, mapOf("MESSAGES", 2, "JOBS", 1), null, 0)
    var contagens = ContagensNavegacao(resumo, listOf<String>("JOBS"), 0, 0)
    assert(Sinais.avisos(contagens) == 4)
    var sinal = Sinais.de("notificações", null, contagens)
    assert(sinal != null)
    if (sinal != null) {
        assert(sinal.forma == "count")
        assert(sinal.contagem == 4)
    }
}

test "avisos nunca ficam negativos" {
    var resumo = ResumoSinal(1, mapOf("JOBS", 9), null, 0)
    var contagens = ContagensNavegacao(resumo, listOf<String>("JOBS"), 0, 0)
    assert(Sinais.avisos(contagens) == 0)
    assert(Sinais.de("notificações", null, contagens) == null)
}

test "evento de hoje usa a forma de hoje" {
    var resumo = ResumoSinal(0, mapOf("EVENTS", 3), null, 2)
    var contagens = ContagensNavegacao(resumo, listOf<String>(), 0, 0)
    var sinal = Sinais.de("eventos", null, contagens)
    assert(sinal != null)
    if (sinal != null) { assert(sinal.forma == "today") }
    assert(Sinais.eventosHoje(contagens) == 2)
}

test "comunidade com aviso acende o ponto" {
    var resumo = ResumoSinal(0, mapOf("GROUPS", 1), mapOf("kof", 1), 0)
    var contagens = ContagensNavegacao(resumo, listOf<String>(), 0, 0)
    var comunidades = Sinais.de("comunidades", null, contagens)
    assert(comunidades != null)
    if (comunidades != null) { assert(comunidades.forma == "new") }
    var grupos = Sinais.de("grupos", "GROUPS", contagens)
    assert(grupos != null)
    if (grupos != null) { assert(grupos.forma == "new") }
}

test "explorar olha os modulos de jogo" {
    var resumo = ResumoSinal(0, mapOf("DAILY_GAMES", 1), null, 0)
    var comJogo = ContagensNavegacao(resumo, listOf<String>(), 0, 0)
    assert(Sinais.de("explorar", null, comJogo) != null)
    var semJogo = ContagensNavegacao(ResumoSinal(0, mapOf("GROUPS", 1), null, 0),
        listOf<String>(), 0, 0)
    assert(Sinais.de("explorar", null, semJogo) == null)
}

test "navegacao leva o modulo de aviso de cada rota" {
    var itens = Navegacao.itens()
    assert(itens.get(5).notifica == "GROUPS")
    assert(itens.get(6).notifica == "EVENTS")
    assert(itens.get(7).notifica == "BLOGS")
    assert(itens.get(8).notifica == "STUDY_PAIRS")
    assert(itens.get(9).notifica == "JOBS")
    assert(itens.get(12).notifica == "COMPANIES")
    assert(itens.get(13).notifica == "MENTORING")
    assert(itens.get(0).notifica == null)
}

test "selo desenha cada forma do design system" {
    assert(Badge.sinal(null) == "")
    assert(Badge.curto(7) == "7")
    assert(Badge.curto(100) == "99+")
    var ponto = Badge.sinal(Sinal("new", 0))
    assert(ponto.contains("●"))
    var hoje = Badge.sinal(Sinal("today", 0))
    assert(hoje.contains("hoje"))
    var balao = Badge.sinal(Sinal("messages", 150))
    assert(balao.contains("99+"))
    assert(Badge.sinal(Sinal("count", 0)) == "")
}

test "painel so abre em terminal largo" {
    assert(Painel.cabe(80))
    assert(!Painel.cabe(60))
    assert(Painel.larguraEsquerda(80) == 34)
    assert(Painel.larguraDireita(80) == 43)
    assert(Painel.larguraEsquerda(120) == 40)
}

test "trecho da previa corta no espaco" {
    var texto = Previa.trecho("mensagem bem comprida para cortar", 12)
    assert(texto.contains("mensagem"))
    assert(!texto.contains("comprida"))
    assert(Previa.trecho("curta", 12).contains("curta"))
}

test "previa guarda e devolve as linhas" {
    var previa = Previa(Cliente(Config.carregar(), Sessao()), "social")
    var linhas = Previa.dividir(Previa.juntar(listOf<String>("a", "b")))
    assert(linhas.size() == 2)
    assert(linhas.get(0) == "a")
    assert(linhas.get(1) == "b")
    assert(previa.contextoDoServidor() == "SOCIAL")
    previa.trocarContexto("profissional")
    assert(previa.contextoDoServidor() == "PROFESSIONAL")
}

test "menu rola dentro da altura do terminal" {
    var linhas = listOf<LinhaMenu>()
    for (var i = 0; i < 20; i = i + 1) { linhas.add(LinhaMenu("l" + String.valueOf(i), i)) }
    var janela = Seletor.janelaDe(linhas, 15, 6)
    assert(janela.size() == 6)
    assert(janela.get(0).texto.contains("acima"))
    assert(janela.get(1).texto.contains("l12"))
    assert(janela.get(4).texto.contains("l15"))
    assert(janela.get(5).texto.contains("abaixo"))
    var fim = Seletor.janelaDe(linhas, 19, 6)
    assert(fim.size() == 6)
    assert(fim.get(5).texto.contains("l18"))
    assert(!fim.get(5).texto.contains("abaixo"))
}

test "menu curto nao ganha janela" {
    var linhas = listOf<LinhaMenu>(LinhaMenu("a", 0), LinhaMenu("b", 1), LinhaMenu("c", 2))
    assert(Seletor.janelaDe(linhas, 0, 6).size() == 3)
    var exato = Seletor.janelaDe(listOf<LinhaMenu>(
        LinhaMenu("a", 0), LinhaMenu("b", 1), LinhaMenu("c", 2), LinhaMenu("d", 3)), 2, 4)
    assert(exato.size() == 4)
    assert(exato.get(0).texto == "a")
}

test "clique do mouse traz linha e coluna" {
    var clique = Teclado.mouseDe("0;12;7M")
    assert(clique.nome == "clique")
    assert(clique.linha == 7)
    assert(clique.coluna == 12)
}

test "soltar o botao nao vira clique" {
    assert(Teclado.mouseDe("0;12;7m").nome == "soltar")
}

test "arrastar o botao tem nome proprio" {
    assert(Teclado.mouseDe("32;12;7M").nome == "arrastar")
}

test "so o botao esquerdo navega" {
    var direito = Teclado.mouseDe("2;12;7M")
    assert(direito.nome == "clique-outro")
    assert(direito.botao == 2)
    assert(Teclado.mouseDe("1;12;7M").nome == "clique-outro")
    assert(Teclado.mouseDe("0;12;7M").nome == "clique")
}

test "roda do mouse aponta para cima e para baixo" {
    assert(Teclado.mouseDe("64;3;9M").nome == "roda-cima")
    assert(Teclado.mouseDe("65;3;9M").nome == "roda-baixo")
}

test "sequencia de mouse incompleta fica desconhecida" {
    assert(Teclado.mouseDe("0;12").nome == "desconhecida")
    assert(Teclado.mouseDe("").nome == "desconhecida")
}

test "regiao devolve o alvo sob o cursor" {
    var regioes = Regioes()
    regioes.adicionar(10, 3, 20, 4, "item")
    var alvo = regioes.em(10, 5)
    assert(alvo.tipo == "item")
    assert(alvo.indice == 4)
}

test "regiao fora da faixa devolve alvo vazio" {
    var regioes = Regioes()
    regioes.adicionar(10, 3, 20, 4, "item")
    var alvo = regioes.em(11, 5)
    assert(alvo.tipo == "")
    assert(alvo.indice == -1)
}

test "abas registram a coluna de cada aba" {
    var regioes = Regioes()
    Abas.registrar(regioes, 5, listOf<String>("social", "profissional"), "profissional")
    var primeira = regioes.em(5, 4)
    assert(primeira.tipo == "aba")
    assert(primeira.indice == 0)
    var segunda = regioes.em(5, 14)
    assert(segunda.tipo == "aba")
    assert(segunda.indice == 1)
}

test "fundo do bloco focado mantem a cor depois do reset" {
    var pintado = Tema.comFundoSobre(Tema.FUNDO_PRIMARIO_SUAVE, Tema.texto("post"))
    assert(pintado.contains(Tema.FUNDO_PRIMARIO_SUAVE))
    assert(pintado.endsWith(Tema.RESET))
}

test "rolagem mostra exatamente a altura do bloco" {
    var rolagem = Rolagem(4)
    rolagem.adicionar(Bloco(0, listOf<String>("a", "b")))
    rolagem.adicionar(Bloco(1, listOf<String>("c", "d")))
    var visiveis = rolagem.visiveis()
    assert(visiveis.size() == 4)
    assert(visiveis.get(0).contains("a"))
    assert(visiveis.get(1).contains("b"))
    assert(visiveis.get(2).contains("c"))
    assert(visiveis.get(3).contains("d"))
}

test "rolagem acha o bloco pela linha" {
    var rolagem = Rolagem(4)
    rolagem.adicionar(Bloco(0, listOf<String>("a", "b", "c")))
    rolagem.adicionar(Bloco(1, listOf<String>("d")))
    assert(rolagem.blocoDaLinha(0) == 0)
    assert(rolagem.blocoDaLinha(2) == 0)
    assert(rolagem.blocoDaLinha(3) == 1)
    assert(rolagem.blocoDaLinha(9) == -1)
}

test "rolagem move o foco e alinha a janela" {
    var rolagem = Rolagem(2)
    for (var i = 0; i < 5; i = i + 1) {
        rolagem.adicionar(Bloco(i, listOf<String>("linha " + String.valueOf(i))))
    }
    rolagem.moverFoco(4)
    assert(rolagem.foco == 4)
    assert(rolagem.deslocamento == 3)
    rolagem.moverFoco(-9)
    assert(rolagem.foco == 0)
    assert(rolagem.deslocamento == 0)
}

test "rolagem limita o deslocamento no fim da lista" {
    var rolagem = Rolagem(3)
    for (var i = 0; i < 4; i = i + 1) {
        rolagem.adicionar(Bloco(i, listOf<String>("linha " + String.valueOf(i))))
    }
    rolagem.rolar(50)
    assert(rolagem.deslocamento == 1)
    assert(rolagem.noFim())
}

test "destino quebra o caminho em segmentos" {
    var partes = Destino.segmentos("/api/feed/posts/abc123")
    assert(partes.size() == 3)
    assert(partes.get(0) == "feed")
    assert(partes.get(1) == "posts")
    assert(partes.get(2) == "abc123")
}

test "destino tira a barra final e a query" {
    var partes = Destino.segmentos("/grupos/enois/")
    assert(partes.size() == 2)
    assert(partes.get(1) == "enois")
}

test "destino acha o parametro da query" {
    assert(Destino.parametro("/eventos?evento=99", "evento") == "99")
    assert(Destino.parametro("/eventos?other=1", "evento") == "")
}

test "tempo relativo mede minutos horas e data antiga" {
    assert(Tempo.data("2020-03-05T10:00:00Z") == "05 mar 2020")
    assert(Tempo.data("") == "")
    assert(Tempo.relativo(null) == "")
    assert(Tempo.relativo("2020-03-05T00:00:00Z") == "05 mar 2020")
    var hoje = Tempo.relativo(time.todayIso())
    assert(hoje == "agora" || hoje.endsWith(" h") || hoje.endsWith(" min"))
}

test "tempo escolhe o mes certo e ignora data invalida" {
    assert(Tempo.mes("01") == "jan")
    assert(Tempo.mes("12") == "dez")
    assert(Tempo.mes("13") == "13")
    assert(Tempo.mes("ab") == "ab")
    assert(Tempo.epoch("2020-03-05T00:00:00Z") == Tempo.epoch("2020-03-05"))
    assert(Tempo.epoch("2020-03-05T01:00:00Z") - Tempo.epoch("2020-03-05") == 3600000L)
    assert(Tempo.epoch("") == 0L)
}

test "cartao mostra autor tipo e contadores" {
    var p = PostResumo("p1", "QUESTION", "Como comecar em Kof?", "2020-03-05T12:00:00Z",
        "u1", "Mel", "mel", "", "mentora", "", listOf<String>("kof"),
        Contadores(3, 2, 1, 0, 0), "", "", "", "", "", null, null, null, null, null, null, null, null, null)
    var linhas = Cartao.linhas(p, 60, "mel")
    assert(linhas.size() == 3)
    assert(linhas.get(0).contains("Mel"))
    assert(linhas.get(0).contains("@mel"))
    assert(linhas.get(0).contains("mentora"))
    assert(linhas.get(0).contains("pergunta"))
    assert(linhas.get(0).contains("05 mar 2020"))
    assert(linhas.get(0).contains("você"))
    assert(linhas.get(1).contains("Como comecar em Kof?"))
    assert(linhas.get(2).contains("♥ 3"))
    assert(linhas.get(2).contains("↩ 2"))
}

test "cartao nao marca como proprio o post de outra pessoa" {
    var p = PostResumo("p2", "INSIGHT", "conteudo", "2020-03-05T12:00:00Z",
        "u2", "Outra", "outra", "", "", "", null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null)
    var linhas = Cartao.linhas(p, 60, "mel")
    assert(!linhas.get(0).contains("você"))
    assert(linhas.get(0).contains("@outra"))
}

test "cartao limita texto longo e conta as midias" {
    var texto = ""
    for (var i = 0; i < 40; i = i + 1) { texto = texto + "palavra grande " }
    var anexos = listOf<MidiaAnexo>(
        MidiaAnexo("m1", "https://cdn.enois.ia.br/a.png", "image/png", 800, 600),
        MidiaAnexo("m2", "https://cdn.enois.ia.br/b.mp4", "video/mp4", 1280, 720))
    var p = PostResumo("p3", null, texto, "", "", "Mel", "mel", "", "", "",
        null, null, null, null, null, null, null, null, null, null, null, null, null, anexos, null, null)
    var linhas = Cartao.linhas(p, 40, "")
    assert(linhas.size() == 6)
    for (var linha in linhas) {
        assert(Ansi.largura(linha) <= 40)
    }
    assert(Cartao.totalImagens(p) == 1)
    assert(linhas.get(5).contains("▣ 1"))
    assert(linhas.get(5).contains("♥ 0"))
    assert(linhas.get(5).contains("↩ 0"))
}

test "cartao corta o autor que passa da largura" {
    var p = PostResumo("p4", "OPPORTUNITY", "", "", "",
        "Nome Muito Comprido Para o Terminal", "usuario_muito_comprido",
        "", "selo", "", null, Contadores(0, 0, 0, 0, 0),
        null, null, null, null, null, null, null, null, null, null, null, null, null, null)
    var linha = Cartao.autor(p, 24, "")
    assert(Ansi.largura(linha) <= 24)
    assert(Cartao.tipoEmTexto("OPPORTUNITY") == "oportunidade")
}

test "cabecalho mostra identidade secao contexto e conexao" {
    var cliente = Cliente(Config(), Sessao())
    var linha = Cabecalho.linha(cliente, "feed", "social")
    assert(linha.contains("Énóis"))
    assert(linha.contains("feed"))
    assert(linha.contains("social"))
    assert(linha.contains("conectado"))
    assert(Ansi.largura(linha) == Ansi.LARGURA_CONTEUDO)
    cliente.estadoRede = "offline"
    assert(Cabecalho.linha(cliente, "feed", "social").contains("sem rede"))
    cliente.estadoRede = "sessao"
    assert(Cabecalho.linha(cliente, "feed", "social").contains("sessão expirada"))
    assert(Cabecalho.colunaContexto("feed") == Ansi.largura(Cabecalho.esquerda("feed", "")) + 6)
}

test "cabecalho encolhe a direita em terminal estreito" {
    var antes = Ansi.LARGURA_CONTEUDO
    var sessao = Sessao("token", "")
    sessao.usuario = Usuario("u-mel", "Mel", "melmonfre", "mel@enois.ia.br", "", 128)
    var cliente = Cliente(Config(), sessao)
    Ansi.LARGURA_CONTEUDO = 40
    var linha = Cabecalho.linha(cliente, "feed", "social")
    assert(Ansi.largura(linha) <= 40)
    assert(linha.contains("conectado"))
    assert(!linha.contains("fagulhas"))
    Ansi.LARGURA_CONTEUDO = antes
}

test "barra de secoes marca a area ativa e os selos" {
    var social = Navegacao.secoesDe("social")
    assert(social.size() == 6)
    assert(social.get(2) == "comunidades")
    assert(Navegacao.secoesDe("profissional").get(2) == "vagas")
    var contagens = ContagensNavegacao(null, listOf<String>(), 4, 0)
    var barra = BarraSecoes.barra("social", "feed", contagens)
    assert(barra.contains("Feed"))
    assert(barra.contains("Comunidades"))
    assert(barra.contains("4"))
    assert(barra.contains(Tema.FUNDO_PRIMARIO_SUAVE))
    assert(BarraSecoes.linhas("social", "feed", null).size() == 2)
}

test "barra de secoes encurta rotulos em terminal estreito" {
    var antes = Ansi.LARGURA_CONTEUDO
    Ansi.LARGURA_CONTEUDO = 40
    var rotulos = BarraSecoes.ajustados(Navegacao.secoesDe("social"), null)
    assert(rotulos.contains("Comun."))
    assert(rotulos.contains("Notif."))
    assert(rotulos.contains("Mens."))
    assert(!rotulos.contains("Comunidades"))
    Ansi.LARGURA_CONTEUDO = antes
}

test "barra de secoes registra o clique de cada area" {
    var regioes = Regioes()
    BarraSecoes.registrar(regioes, 1, "social", "feed", null)
    var primeira = regioes.em(1, 2)
    assert(primeira.tipo == "secao")
    assert(primeira.indice == 0)
    assert(regioes.em(1, 7).indice == 1)
    assert(regioes.em(1, 1).indice == -1)
}

test "barra de secoes cobre o rotulo inteiro com selo" {
    var regioes = Regioes()
    var contagens = ContagensNavegacao(null, listOf<String>(), 4, 0)
    BarraSecoes.registrar(regioes, 1, "social", "feed", contagens)
    var barra = BarraSecoes.barra("social", "feed", contagens)
    var rotulos = BarraSecoes.ajustados(Navegacao.secoesDe("social"), contagens)
    var coluna = 1
    for (var i = 0; i < rotulos.size(); i = i + 1) {
        var largura = Ansi.largura(BarraSecoes.secao(Navegacao.secoesDe("social").get(i), rotulos.get(i), contagens))
        assert(regioes.em(1, coluna + 1).indice == i)
        assert(regioes.em(1, coluna + largura).indice == i)
        assert(regioes.em(1, coluna + largura + 1).indice == -1)
        coluna = coluna + largura + 1
    }
    assert(Ansi.largura(barra) <= Ansi.LARGURA_CONTEUDO)
}

test "barra de contexto junta atalhos status e posicao" {
    var linhas = BarraContexto.linhas(listOf<String>("↑↓ navegar", "enter abrir"), "pronto", "3/10")
    assert(linhas.size() == 2)
    assert(linhas.get(1).contains("↑↓ navegar"))
    assert(linhas.get(1).contains("enter abrir"))
    assert(linhas.get(1).contains("3/10"))
    assert(linhas.get(1).contains("·"))
    assert(Ansi.largura(linhas.get(1)) == Ansi.LARGURA_CONTEUDO)
    assert(BarraContexto.linhas(listOf<String>(), "", "").size() == 2)
    assert(BarraContexto.juntar(listOf<String>()) == "")
    assert(BarraContexto.juntarAte(listOf<String>("↑↓ navegar", "enter abrir"), 16).contains("…"))
    assert(BarraContexto.juntarAte(listOf<String>("↑↓ navegar"), 40).contains("↑↓ navegar"))
}

test "rolagem marca o bloco focado com a barra lateral" {
    var rolagem = Rolagem(2)
    rolagem.adicionar(Bloco(0, listOf<String>(" a", " b")))
    rolagem.adicionar(Bloco(1, listOf<String>(" c")))
    var visiveis = rolagem.visiveis()
    assert(visiveis.get(0).contains("▌"))
    assert(visiveis.get(1).contains("▌"))
    rolagem.moverFoco(1)
    var depois = rolagem.visiveis()
    assert(!depois.get(0).contains("▌"))
    assert(depois.get(1).contains("▌"))
}

test "aviso sem item nao recebe marcador de foco" {
    var rolagem = Rolagem(2)
    rolagem.adicionar(Bloco(-1, listOf<String>(" aviso")))
    var visiveis = rolagem.visiveis()
    assert(!visiveis.get(0).contains("▌"))
}

test "medir acompanha a largura do terminal" {
    Ansi.LARGURA_CONTEUDO = 33
    Ansi.medir()
    assert(Ansi.LARGURA_CONTEUDO == Terminal.largura())
    assert(Ansi.LARGURA_CONTEUDO >= Terminal.LARGURA_MINIMA)
}

test "falha de conexao derruba o estado para sem rede" {
    var config = Config()
    config.urlApi = "http://127.0.0.1:1/api"
    var cliente = Cliente(config, Sessao())
    cliente.timeoutRequisicao = 1
    cliente.tentativas = 0
    var resposta = cliente.get("/feed")
    assert(resposta.codigo == 0)
    assert(!resposta.ok())
    assert(cliente.estadoRede == "offline")
    assert(resposta.codigoDeErro() == "REDE")
}

test "secoes secundarias ficam fora da barra" {
    var secundarios = Navegacao.secundarios("social")
    var temRede = false
    for (var item in secundarios) {
        assert(item.rota != "feed")
        assert(item.rota != "comunidades")
        assert(item.rota != "notificações")
        assert(item.rota != "mensagens")
        assert(item.rota != "perfil")
        if (item.rota == "rede") { temRede = true }
    }
    assert(temRede)
    var indiceRede = Navegacao.indiceDaSecao("social", "rede")
    assert(indiceRede == -1)
    assert(Navegacao.indiceDaSecao("social", "feed") == 0)
    assert(Navegacao.indiceDaSecao("profissional", "vagas") == 2)
}

test "regioes da barra cobrem a barra desenhada" {
    var antes = Ansi.LARGURA_CONTEUDO
    Ansi.LARGURA_CONTEUDO = 80
    var contagens = ContagensNavegacao(null, listOf<String>(), 9, 3)
    var rotas = Navegacao.secoesDe("social")
    var regioes = Regioes()
    BarraSecoes.registrar(regioes, 2, "social", "feed", contagens)
    assert(regioes.tamanho() == rotas.size())
    var largura = Ansi.largura(BarraSecoes.barra("social", "feed", contagens))
    assert(regioes.em(2, 1).tipo == "")
    assert(regioes.em(2, largura).tipo == "")
    assert(regioes.em(2, largura - 1).indice == rotas.size() - 1)
    assert(regioes.em(3, 2).tipo == "")
    var coluna = 2
    for (var i = 0; i < rotas.size(); i = i + 1) {
        assert(regioes.em(2, coluna).indice == i)
        var secao = BarraSecoes.secao(rotas.get(i), BarraSecoes.rotulos(rotas, false).get(i), contagens)
        coluna = coluna + Ansi.largura(secao) + 1
    }
    Ansi.LARGURA_CONTEUDO = antes
}

test "regioes da barra seguem os rotulos curtos quando a tela estreita" {
    var antes = Ansi.LARGURA_CONTEUDO
    Ansi.LARGURA_CONTEUDO = 60
    var contagens = ContagensNavegacao(null, listOf<String>(), 9, 3)
    var rotas = Navegacao.secoesDe("social")
    var regioes = Regioes()
    BarraSecoes.registrar(regioes, 2, "social", "feed", contagens)
    var largura = Ansi.largura(BarraSecoes.barra("social", "feed", contagens))
    assert(largura <= 60)
    assert(regioes.tamanho() == rotas.size())
    assert(regioes.em(2, largura - 1).indice == rotas.size() - 1)
    var curtos = BarraSecoes.ajustados(rotas, contagens)
    var coluna = 2
    for (var i = 0; i < rotas.size(); i = i + 1) {
        assert(regioes.em(2, coluna).indice == i)
        coluna = coluna + Ansi.largura(BarraSecoes.secao(rotas.get(i), curtos.get(i), contagens)) + 1
    }
    Ansi.LARGURA_CONTEUDO = antes
}

test "toda secao da barra tem atalho numerico na mesma ordem" {
    var rotas = Navegacao.secoesDe("social")
    assert(rotas.size() == 6)
    for (var i = 0; i < rotas.size(); i = i + 1) {
        assert(Seletor.digito(String.valueOf((49 + i) as Char)) == i)
    }
    assert(Seletor.digito("7") == 6)
}

test "eventos de mouse inertes nao redesenham" {
    assert(Teclado.inerte(Tecla("soltar", "")))
    assert(Teclado.inerte(Tecla("clique-outro", "")))
    assert(Teclado.inerte(Tecla("arrastar", "")))
    assert(Teclado.inerte(Tecla("desconhecida", "")))
    assert(!Teclado.inerte(Tecla("clique", "")))
    assert(!Teclado.inerte(Tecla("redimensionar", "")))
    assert(!Teclado.inerte(Tecla("enter", "")))
    assert(!Teclado.inerte(Tecla("texto", "k")))
}


test "reacao otimista soma quando nao ha reacao" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 0, 0, 0), null)
    var otimista = p.reacaoOtimista("LIKE")
    assert(otimista.totalDeReacoes() == 5)
    assert(otimista.currentUserReaction == "LIKE")
    assert(otimista.totalDeComentarios() == 2)
}

test "reacao otimista volta quando a reacao e a mesma" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 0, 0, 0), "LIKE")
    var otimista = p.reacaoOtimista("LIKE")
    assert(otimista.totalDeReacoes() == 3)
    assert(otimista.currentUserReaction == null)
}

test "reacao otimista troca de tipo sem mexer no contador" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 0, 0, 0), "LIKE")
    var otimista = p.reacaoOtimista("WOW")
    assert(otimista.totalDeReacoes() == 4)
    assert(otimista.currentUserReaction == "WOW")
}

test "contadores do servidor substituem a conta local" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 1, 0, 0), "LIKE")
    var resultado = ResultadoAcao("p4", "REACTED", Contadores(9, 3, 1, 2, 0))
    var atualizado = p.comResultado(resultado, "WOW")
    assert(atualizado.totalDeReacoes() == 9)
    assert(atualizado.totalDeComentarios() == 3)
    assert(atualizado.totalDeCompartilhamentos() == 2)
    assert(atualizado.currentUserReaction == "WOW")
}

test "resposta de remocao limpa a reacao e mantem os contadores" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 1, 0, 0), "LIKE")
    var resultado = ResultadoAcao("p5", "REACTION_REMOVED", Contadores(3, 2, 1, 0, 0))
    var atualizado = p.comResultado(resultado, "LIKE")
    assert(atualizado.totalDeReacoes() == 3)
    assert(atualizado.currentUserReaction == null)
}

test "resposta sem contadores mantem o post como estava" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 1, 0, 0), "LIKE")
    var atualizado = p.comResultado(ResultadoAcao("p6", "REACTED", null), "WOW")
    assert(atualizado.totalDeReacoes() == 4)
    assert(atualizado.currentUserReaction == "LIKE")
}

test "comentario soma no contador preservando o resto" {
    var p = PostResumo.vazio().comContadores(Contadores(4, 2, 1, 3, 0), "LOVE")
    var atualizado = p.comComentario()
    assert(atualizado.totalDeComentarios() == 3)
    assert(atualizado.totalDeReacoes() == 4)
    assert(atualizado.totalDeSalvamentos() == 1)
    assert(atualizado.totalDeCompartilhamentos() == 3)
    assert(atualizado.currentUserReaction == "LOVE")
}

test "catalogo de reacoes cobre os 76 tipos do backend" {
    assert(Reacoes.TIPOS.size() == 76)
    assert(Reacoes.ROTULOS.size() == 76)
    assert(Reacoes.TIPOS.get(0) == "LIKE")
    assert(Reacoes.TIPOS.get(75) == "GHOST")
    assert(Reacoes.rotulo("LIKE") == "curtir")
    assert(Reacoes.rotulo("GHOST") == "fantasma")
    assert(Reacoes.valido("WOW"))
    assert(!Reacoes.valido("NAO_EXISTE"))
    assert(Reacoes.rotulos().size() == 76)
}

test "servico bloqueia reacao repetida no mesmo instante" {
    var servico = PostService(Cliente(Config(), Sessao()))
    assert(servico.podeAlternar("p1"))
    servico.marcar("p1")
    assert(!servico.podeAlternar("p1"))
    assert(servico.podeAlternar("p2"))
}

test "publicacao criada insere no topo sem duplicar" {
    var criado = PublicacaoApi.criado(Resposta(201,
        "{\"id\":\"p9\",\"type\":\"INSIGHT\",\"content\":\"ola\",\"createdAt\":\"2020-03-05T12:00:00Z\","
        + "\"authorId\":\"u1\",\"authorName\":\"Mel\",\"authorUsername\":\"mel\","
        + "\"counters\":{\"reactions\":0,\"comments\":0,\"saves\":0,\"shares\":0,\"reposts\":0}}", ""))
    if (criado != null) {
        assert(criado.id == "p9")
        assert(criado.authorUsername == "mel")
        assert(criado.totalDeReacoes() == 0)
    } else {
        assert(false)
    }
}

test "publicacao com corpo invalido nao inventa post" {
    assert(PublicacaoApi.criado(Resposta(201, "nao e json", "")) == null)
    assert(PublicacaoApi.criado(Resposta(200, "{\"id\":\"p9\"}", "")) == null)
}

Comentario comentarioDeTeste(String id, String? pai, String criado, Int reacoes, String? reacao) {
    return Comentario(id, "p1", "u1", "Ana", "ana", null, null, pai, "texto " + id,
        criado, null, reacao, reacoes, null, null, listOf<String>(), null)
}

ComentarioService servicoDeComentarios() {
    return ComentarioService(Cliente(Config(), Sessao()))
}

test "comentario decodificado traz fixado e contador" {
    var c = json.decode<Comentario>("{\"id\":\"c1\",\"authorUsername\":\"mel\",\"pinned\":true,"
        + "\"reactionCount\":7,\"currentUserReaction\":\"LIKE\",\"mediaIds\":[\"m1\",\"m2\"]}")
    assert(c.fixado())
    assert(c.totalDeReacoes() == 7)
    assert(c.temReacao("LIKE"))
    assert(c.totalDeMidias() == 2)
}

test "comentario sem fixacao nem reacao fica neutro" {
    var c = comentarioDeTeste("c2", null, "2024-05-01T10:00:00Z", 0, null)
    assert(!c.fixado())
    assert(!c.aceito())
    assert(!c.reagido())
    assert(!c.resposta())
    assert(c.usuario() == "ana")
    assert(c.nome() == "Ana")
    assert(c.criadoEm() == "2024-05-01T10:00:00Z")
}

test "comentario soma e desfaz reacao no proprio registro" {
    var c = comentarioDeTeste("c3", null, "2024-05-01T10:00:00Z", 3, null)
    var curtido = c.reacaoOtimista("LIKE")
    assert(curtido.totalDeReacoes() == 4)
    assert(curtido.temReacao("LIKE"))
    var desfeito = curtido.reacaoOtimista("LIKE")
    assert(desfeito.totalDeReacoes() == 3)
    assert(!desfeito.reagido())
}

test "comentario troca reacao sem mexer no contador" {
    var c = comentarioDeTeste("c4", null, "2024-05-01T10:00:00Z", 3, "LIKE")
    var trocado = c.reacaoOtimista("WOW")
    assert(trocado.totalDeReacoes() == 3)
    assert(trocado.temReacao("WOW"))
}

test "comentario nunca deixa contador negativo" {
    var c = comentarioDeTeste("c5", null, "", 0, "LIKE")
    var desfeito = c.reacaoOtimista("LIKE")
    assert(desfeito.totalDeReacoes() == 0)
    assert(!desfeito.reagido())
}

test "comentario editado preserva reacao e fixacao" {
    var c = json.decode<Comentario>("{\"id\":\"c6\",\"pinned\":true,\"reactionCount\":2,"
        + "\"currentUserReaction\":\"LIKE\",\"content\":\"antes\"}")
    var novo = c.comConteudo("depois", "2024-06-01T10:00:00Z")
    assert(novo.content == "depois")
    assert(novo.editedAt == "2024-06-01T10:00:00Z")
    assert(novo.fixado())
    assert(novo.temReacao("LIKE"))
}

test "comentario meu e resposta exigem identificadores" {
    var raiz = comentarioDeTeste("c7", null, "", 0, null)
    assert(raiz.meu("u1"))
    assert(!raiz.meu("u2"))
    assert(!raiz.meu(""))
    var resposta = comentarioDeTeste("c8", "c7", "", 0, null)
    assert(resposta.resposta())
    assert(!raiz.resposta())
}

test "corpo de comentario carrega o contrato real" {
    var corpo = ComentariosApi.corpoDeComentario("olá rede", null, listOf<String>(), false)
    assert(corpo == "{\"content\":\"olá rede\",\"parentCommentId\":null,\"mediaIds\":[],"
        + "\"mentionedUserIds\":[],\"website\":\"\",\"mediaSpoiler\":false}")
}

test "corpo de resposta aponta o comentario pai e as midias" {
    var corpo = ComentariosApi.corpoDeComentario("sim", "c1", listOf<String>("m1"), true)
    assert(corpo == "{\"content\":\"sim\",\"parentCommentId\":\"c1\",\"mediaIds\":[\"m1\"],"
        + "\"mentionedUserIds\":[],\"website\":\"\",\"mediaSpoiler\":true}")
}

test "comentario criado so nasce de 201" {
    var corpo = "{\"id\":\"c9\",\"content\":\"oi\",\"createdAt\":\"2024-01-01T00:00:00Z\","
        + "\"authorId\":\"u1\",\"authorUsername\":\"mel\"}"
    var criado = ComentariosApi.criado(Resposta(201, corpo, ""))
    if (criado == null) {
        assert(false)
    } else {
        assert(criado.id == "c9")
        assert(criado.content == "oi")
    }
    assert(ComentariosApi.criado(Resposta(200, corpo, "")) == null)
    assert(ComentariosApi.criado(Resposta(201, "nao e json", "")) == null)
}

test "edicao de comentario decodifica status e data" {
    var r = Resposta(200, "{\"status\":\"COMMENT_EDITED\",\"content\":\"novo\","
        + "\"mediaIds\":[],\"editedAt\":\"2024-02-02T00:00:00Z\"}", "")
    var edicao = ComentariosApi.edicao(r)
    assert(edicao.editado())
    assert(edicao.content == "novo")
    assert(edicao.editedAt == "2024-02-02T00:00:00Z")
    assert(!ComentariosApi.edicao(Resposta(403, "", "")).editado())
}

test "pagina de comentarios decodifica itens e cursor" {
    var r = Resposta(200, "{\"items\":[{\"id\":\"c1\",\"content\":\"a\"},{\"id\":\"c2\",\"content\":\"b\"}],"
        + "\"nextCursor\":\"2024-01-01T00:00:00Z\"}", "")
    var pagina = ComentariosApi.pagina(r)
    var itens = pagina.items
    if (itens == null) {
        assert(false)
    } else {
        assert(itens.size() == 2)
        assert(itens.get(1).id == "c2")
    }
    assert(pagina.nextCursor == "2024-01-01T00:00:00Z")
    var vazia = ComentariosApi.pagina(Resposta(500, "", ""))
    assert(vazia.items != null)
}

test "servico junta paginas sem duplicar" {
    var servico = servicoDeComentarios()
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"c1\"},{\"id\":\"c2\"}],\"nextCursor\":\"k2\"}", "")))
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"c2\"},{\"id\":\"c3\"}],\"nextCursor\":\"k3\"}", "")))
    assert(servico.comentarios.size() == 3)
    assert(servico.cursor == "k3")
    assert(servico.temMais)
}

test "servico para de paginar quando o cursor nao avanca" {
    var servico = servicoDeComentarios()
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"c1\"}],\"nextCursor\":\"k1\"}", "")))
    assert(servico.temMais)
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"c2\"}],\"nextCursor\":\"k1\"}", "")))
    assert(!servico.temMais)
    assert(servico.cursor == "k1")
}

test "servico ordena cronologicamente com fixado no topo" {
    var servico = servicoDeComentarios()
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"b\",\"createdAt\":\"2024-01-02T00:00:00Z\"},"
        + "{\"id\":\"a\",\"createdAt\":\"2024-01-01T00:00:00Z\"},"
        + "{\"id\":\"fixo\",\"createdAt\":\"2024-01-03T00:00:00Z\",\"pinned\":true}]}", "")))
    assert(servico.comentarios.get(0).id == "fixo")
    assert(servico.comentarios.get(1).id == "a")
    assert(servico.comentarios.get(2).id == "b")
}

test "servico calcula o nivel da resposta" {
    var servico = servicoDeComentarios()
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200,
        "{\"items\":[{\"id\":\"raiz\"},{\"id\":\"filho\",\"parentCommentId\":\"raiz\"},"
        + "{\"id\":\"neto\",\"parentCommentId\":\"filho\"},"
        + "{\"id\":\"orfao\",\"parentCommentId\":\"sumiu\"}]}", "")))
    assert(servico.nivel("raiz") == 0)
    assert(servico.nivel("filho") == 1)
    assert(servico.nivel("neto") == 2)
    assert(servico.nivel("orfao") == 1)
}

test "servico substitui e acha comentario por id" {
    var servico = servicoDeComentarios()
    servico.adicionarPagina(ComentariosApi.pagina(Resposta(200, "{\"items\":[{\"id\":\"c1\"}]}", "")))
    var achado = servico.porId("c1")
    if (achado == null) {
        assert(false)
    } else {
        servico.substituir(achado.comConteudo("mudou", null))
    }
    var depois = servico.porId("c1")
    if (depois == null) {
        assert(false)
    } else {
        assert(depois.content == "mudou")
    }
    assert(servico.porId("nao-existe") == null)
}

test "servico bloqueia reacao repetida no comentario" {
    var servico = servicoDeComentarios()
    assert(servico.podeAlternar("c1"))
    servico.marcar("c1")
    assert(!servico.podeAlternar("c1"))
    assert(servico.podeAlternar("c2"))
}

test "acoes do comentario batem com as colunas desenhadas" {
    var c = comentarioDeTeste("c1", null, "", 2, "LIKE")
    var linha = CartaoComentario.linhaDeAcoes(c, "u1")
    var acoes = CartaoComentario.acoes(c, "u1")
    assert(acoes.size() == 4)
    for (var i = 0; i < acoes.size(); i = i + 1) {
        var acao = acoes.get(i)
        var visivel = Ansi.fatiar(linha, acao.inicio, acao.fim + 1)
        assert(Ansi.largura(visivel) == acao.rotulo.length)
        assert(visivel.contains(acao.rotulo))
        assert(Ansi.largura(Ansi.fatiar(linha, acao.inicio - 1, acao.inicio)) == 1)
    }
    var deOutro = Comentario("c2", "p1", "u2", "Bia", "bia", null, null, null, "texto",
        "", null, null, 0, null, null, listOf<String>(), null)
    assert(CartaoComentario.acoes(deOutro, "u1").size() == 2)
}

test "cartao do comentario mostra contador e sinaliza fixado" {
    var c = json.decode<Comentario>("{\"id\":\"c1\",\"authorUsername\":\"mel\",\"content\":\"oi\","
        + "\"pinned\":true,\"reactionCount\":3,\"currentUserReaction\":\"LIKE\"}")
    var linhas = CartaoComentario.linhas(c, 40, 0, "u1")
    var cabeca = linhas.get(0)
    assert(cabeca.contains("⚑"))
    assert(cabeca.contains("@mel"))
    assert(cabeca.contains("3"))
    assert(cabeca.contains("♥"))
    var ultima = linhas.get(linhas.size() - 1)
    assert(ultima.contains("curtir"))
}

test "vista entrega a acao antes do cartao no hit test" {
    var vista = Vista(10)
    vista.adicionar(1, listOf<String>("cartao do comentario", "corpo", "   [curtir] [responder] "))
    vista.adicionar(2, listOf<String>("outro comentario"))
    vista.acoes = listOf(AcaoRegiao(1, 2, 5, 10, 0, "acao"))
    vista.montar("topo", "", "")
    var acao = vista.regioes.em(6, 5)
    assert(acao.tipo == "acao")
    assert(acao.dado == 1)
    assert(acao.indice == 0)
    assert(vista.regioes.em(6, 4).tipo == "item")
    assert(vista.regioes.em(4, 2).tipo == "item")
    assert(vista.regioes.em(7, 2).dado == 2)
}

test "sixel detectado no terminal e nos programas conhecidos" {
    assert(Sixel.suportado("xterm-sixel", ""))
    assert(Sixel.suportado("xterm-256color", "mlterm"))
    assert(Sixel.suportado("", "foot"))
    assert(!Sixel.suportado("xterm-256color", ""))
    assert(!Sixel.suportado("xterm-kitty", "iTerm.app"))
}

test "protocolo cai no sixel quando o terminal declara suporte" {
    assert(Imagem.protocolo("xterm-sixel", "", "") == "sixel")
    assert(Imagem.protocolo("xterm-kitty", "", "") == "kitty")
    assert(Imagem.protocolo("xterm-256color", "iTerm.app", "") == "iterm2")
    assert(Imagem.protocolo("xterm-256color", "", "") == "")
}

test "quantizacao sixel cobre a rampa de 6 niveis" {
    assert(Sixel.nivel(0) == 0)
    assert(Sixel.nivel(51) == 1)
    assert(Sixel.nivel(128) == 3)
    assert(Sixel.nivel(255) == 5)
    assert(Sixel.cor(-65536) == 180)
    assert(Sixel.cor(0 - 16777216) == 0)
    assert(Sixel.cor(0) == -1)
}

test "sixel monta cabecalho, paleta e bandas" {
    var saida = Sixel.montar(listOf<Int>(-65536), 1, 1)
    assert(saida.startsWith(Ansi.ESC + "P0;1;0q\"1;1;1;1"))
    assert(saida.contains("#180;2;100;0;0"))
    assert(saida.contains("#180@-"))
    assert(saida.endsWith(Ansi.ESC + "\\"))
}

test "sixel usa o caractere vazio para coluna sem pixel" {
    assert(Sixel.simbolo(0) == "?")
    assert(Sixel.simbolo(63) == "~")
    assert(Sixel.potencia(0) == 1)
    assert(Sixel.potencia(5) == 32)
}

test "galeria lista apenas imagens com endereco" {
    var p = json.decode<PostResumo>("{\"id\":\"p1\",\"media\":["
        + "{\"id\":\"m1\",\"cdnUrl\":\"/a.jpg\",\"mimeType\":\"image/jpeg\",\"width\":100,\"height\":50},"
        + "{\"id\":\"m2\",\"cdnUrl\":\"/b.mp4\",\"mimeType\":\"video/mp4\"},"
        + "{\"id\":\"m3\",\"mimeType\":\"image/png\"}]}")
    var imagens = Galeria.imagens(p)
    assert(imagens.size() == 1)
    assert(imagens.get(0).id == "m1")
    assert(Galeria.indicador(1, 5) == "2/5")
    assert(Galeria.tipo(imagens.get(0)) == "image/jpeg")
    assert(Galeria.dimensoes(imagens.get(0)) == "100×50")
    assert(Galeria.sufixo(imagens.get(0)) == " · 100×50")
    assert(Galeria.endereco(imagens.get(0)) == Midia.CDN + "/a.jpg")
}

test "galeria usa a largura do conteudo" {
    var antes = Ansi.LARGURA_CONTEUDO
    Ansi.LARGURA_CONTEUDO = 120
    assert(Galeria.colunas() == 114)
    Ansi.LARGURA_CONTEUDO = 40
    assert(Galeria.colunas() == 34)
    Ansi.LARGURA_CONTEUDO = 22
    assert(Galeria.colunas() == 20)
    Ansi.LARGURA_CONTEUDO = antes
}

test "acoes da galeria batem com as colunas desenhadas" {
    var rotulos = listOf<String>()
    rotulos.add("anterior")
    rotulos.add("próxima")
    rotulos.add("abre externo")
    rotulos.add("detalhes")
    rotulos.add("volta")
    var acoes = Galeria.acoes(rotulos)
    var texto = "  "
    for (var acao in acoes) { texto = texto + "[" + acao.rotulo + "] " }
    assert(acoes.size() == 5)
    for (var i = 0; i < acoes.size(); i = i + 1) {
        var acao = acoes.get(i)
        var fatiado = Ansi.fatiar(texto, acao.inicio, acao.fim + 1)
        assert(fatiado.startsWith(acao.rotulo))
        assert(Ansi.largura(fatiado) == acao.rotulo.length)
    }
}

test "abrir sem endereco nao dispara programa externo" {
    assert(Abrir.externo("") == "sem endereço")
}

test "editor edita a partir do fim do texto carregado" {
    var editor = Editor(200)
    editor.definirTexto("linha um\nlinha dois")
    assert(editor.linhaCursor == 1)
    assert(editor.colunaCursor == "linha dois".length)
    editor.inserir("!")
    assert(editor.texto() == "linha um\nlinha dois!")
}

test "paragrafos colapsam linhas vazias e cortam a largura" {
    var linhas = Caixa.paragrafos("um\n\n\n\ndois", 20)
    assert(linhas.size() == 3)
    assert(linhas.get(0) == "um")
    assert(linhas.get(1) == "")
    assert(linhas.get(2) == "dois")
    var longa = Caixa.paragrafos("aaaaaaaaaaaaaaaaaaaaaaaaaaaa", 10)
    assert(Ansi.largura(longa.get(0)) == 10)
}

test "comentario com quebra de linha mantem o recuo nas duas" {
    var c = json.decode<Comentario>("{\"id\":\"c9\",\"authorUsername\":\"mel\","
        + "\"content\":\"linha um\\nlinha dois\"}")
    var linhas = CartaoComentario.linhas(c, 60, 0, "u1")
    var achou = 0
    for (var linha in linhas) {
        if (linha.contains("linha um") || linha.contains("linha dois")) {
            assert(linha.startsWith("   "))
            achou = achou + 1
        }
    }
    assert(achou == 2)
}

test "badge de imagem vira selo e nao despeja a url" {
    var p = PostResumo("p9", "INSIGHT", "oi", "2020-03-05T12:00:00Z", "u1",
        "Messila (Kof) (Kof)", "mel", "",
        "https://api.enois.ia.br/api/storage/uploads/media_1/file.png", "", null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null)
    var linha = Cartao.autor(p, 120, "")
    assert(!linha.contains("https://"))
    assert(linha.contains("◈"))
    assert(linha.contains("Messila (Kof)"))
    assert(linha.contains("@mel"))
    assert(!linha.contains("(Kof) (Kof)"))
}

test "link no corpo ganha cor sem mudar a largura" {
    var texto = "veja https://github.com/Rede-ENois/enois-cli e ajude"
    var linha = Cartao.colorir(texto)
    assert(linha.contains("\u001b[4m"))
    assert(Ansi.largura(linha) == texto.length)
}

test "corpo cortado termina com reticencias" {
    var texto = ""
    for (var i = 0; i < 60; i = i + 1) { texto = texto + "palavra " }
    var p = PostResumo("p10", "INSIGHT", texto, "", "", "Mel", "mel", "", "", "",
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null)
    var linhas = Cartao.linhas(p, 40, "")
    assert(linhas.size() == 6)
    assert(linhas.get(4).contains("…"))
}

test "meio bloco transforma pixels em linhas de terminal" {
    var caminho = "/tmp/enois-teste-meiobloco.png"
    var arquivo = new java.io.File(caminho)
    var imagem = new BufferedImage(2, 2, BufferedImage.TYPE_INT_ARGB)
    imagem.setRGB(0, 0, -65536)
    imagem.setRGB(1, 0, -16776961)
    imagem.setRGB(0, 1, -16711936)
    imagem.setRGB(1, 1, -1)
    ImageIO.write(imagem, "png", arquivo)
    var linhas = MeioBloco.converter(caminho, 2, 4)
    assert(linhas.size() == 1)
    assert(linhas.get(0).contains("▀"))
    assert(linhas.get(0).contains("38;2;"))
    assert(Ansi.largura(linhas.get(0)) == 2)
    arquivo.delete()
}

test "meio bloco cai em ascii sem cor quando o terminal nao tem truecolor" {
    var caminho = "/tmp/enois-teste-meiobloco-ascii.png"
    var arquivo = new java.io.File(caminho)
    var imagem = new BufferedImage(2, 2, BufferedImage.TYPE_INT_ARGB)
    imagem.setRGB(0, 0, -1)
    imagem.setRGB(1, 0, -16777216)
    imagem.setRGB(0, 1, -1)
    imagem.setRGB(1, 1, -16777216)
    ImageIO.write(imagem, "png", arquivo)
    var linhas = MeioBloco.converterAscii(caminho, 2, 4)
    assert(linhas.size() == 1)
    assert(!linhas.get(0).contains(Ansi.ESC))
    assert(linhas.get(0) == "@ ")
    arquivo.delete()
}

test "meio bloco encolhe a largura da imagem alta para caber na altura" {
    var caminho = "/tmp/enois-teste-meiobloco-alto.png"
    var arquivo = new java.io.File(caminho)
    var imagem = new BufferedImage(100, 400, BufferedImage.TYPE_INT_ARGB)
    ImageIO.write(imagem, "png", arquivo)
    assert(MeioBloco.colunasFinais(caminho, 60, 10) == 5)
    MeioBloco.limpar()
    arquivo.delete()
}
