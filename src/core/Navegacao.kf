package core

record ItemNavegacao(
    String rota,
    String rotulo,
    String descricao,
    String secao,
    String? contexto,
    String? notifica
)

class Navegacao {

    static List<String> CONTEXTOS = listOf("social", "profissional")

    static List<ItemNavegacao> itens() {
        return listOf(
            ItemNavegacao("feed", "feed", "publicações de quem você segue", "você", null, null),
            ItemNavegacao("mensagens", "mensagens", "conversas", "você", null, null),
            ItemNavegacao("rede", "rede", "quem você segue", "você", "social", null),
            ItemNavegacao("salvos", "salvos", "o que você guardou", "você", "social", null),
            ItemNavegacao("comunidades", "comunidades", "salas por assunto", "comunidade", "social", null),
            ItemNavegacao("grupos", "grupos", "conversas em grupo", "comunidade", "social", "GROUPS"),
            ItemNavegacao("eventos", "eventos", "agenda da comunidade", "comunidade", "social", "EVENTS"),
            ItemNavegacao("blogs", "blogs", "escritas longas", "comunidade", "social", "BLOGS"),
            ItemNavegacao("par de estudo", "par de estudo", "estudar junto", "comunidade", "social", "STUDY_PAIRS"),
            ItemNavegacao("vagas", "vagas", "oportunidades formais", "trabalho", "profissional", "JOBS"),
            ItemNavegacao("freelances", "freelances", "trabalhos pontuais", "trabalho", "profissional", null),
            ItemNavegacao("serviços", "serviços", "quem faz o quê", "trabalho", "profissional", null),
            ItemNavegacao("empresas", "empresas", "quem contrata", "trabalho", "profissional", "COMPANIES"),
            ItemNavegacao("mentoria", "mentoria", "quem ensina", "trabalho", "profissional", "MENTORING"),
            ItemNavegacao("perfil profissional", "perfil profissional", "como você se apresenta", "trabalho", "profissional", null),
            ItemNavegacao("explorar", "explorar", "todas as salas", "explorar", null, null),
            ItemNavegacao("perfil", "perfil", "seus dados", "conta", null, null),
            ItemNavegacao("notificações", "notificações", "avisos e sinais", "conta", null, null),
            ItemNavegacao("conta", "conta", "senha e sessão", "conta", null, null),
            ItemNavegacao("trocar contexto", "trocar contexto", "social ou profissional", "conta", null, null),
            ItemNavegacao("trocar alvo", "trocar alvo", "qa ou produção", "conta", null, null),
            ItemNavegacao("sair da conta", "sair da conta", "encerrar a sessão", "conta", null, null))
    }

    static List<ItemNavegacao> visiveis(String contexto) {
        var saida = listOf<ItemNavegacao>()
        for (var item in itens()) {
            if (item.contexto == null) {
                saida.add(item)
            } else if (item.contexto == contexto) {
                saida.add(item)
            }
        }
        return saida
    }

    static List<String> secoes(List<ItemNavegacao> lista) {
        var ordem = listOf<String>()
        for (var item in lista) {
            if (!ordem.contains(item.secao)) { ordem.add(item.secao) }
        }
        return ordem
    }

    static List<ItemNavegacao> daSecao(List<ItemNavegacao> lista, String secao) {
        var saida = listOf<ItemNavegacao>()
        for (var item in lista) {
            if (item.secao == secao) { saida.add(item) }
        }
        return saida
    }

    static String proximoContexto(String atual) {
        if (atual == "social") { return "profissional" }
        return "social"
    }
}
