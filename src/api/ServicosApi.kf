package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class ServicosApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta listar(String? cursor, Int limite) {
        return this.cliente.get("/servicos" + Cliente.pagina(cursor, limite))
    }

    Resposta minhasServicos() {
        return this.cliente.get("/servicos/minhas")
    }

    Resposta criarOferta(String titulo, Int preco) {
        return this.cliente.post("/servicos/ofertas",
            json.encode(mapOf("title", titulo, "price", Cliente.numero(preco))))
    }

    Resposta editarOferta(String ofertaId, String titulo, Int preco) {
        return this.cliente.put("/servicos/ofertas/" + Cliente.caminho(ofertaId),
            json.encode(mapOf("title", titulo, "price", Cliente.numero(preco))))
    }

    Resposta apagarOferta(String ofertaId) {
        return this.cliente.delete("/servicos/ofertas/" + Cliente.caminho(ofertaId))
    }

    Resposta contratoDaOferta(String ofertaId) {
        return this.cliente.post("/servicos/ofertas/" + Cliente.caminho(ofertaId)
            + "/contratar", "{}")
    }

    Resposta chatDaOferta(String ofertaId) {
        return this.cliente.post("/servicos/ofertas/" + Cliente.caminho(ofertaId)
            + "/chat", "{}")
    }

    Resposta criarPedido(String titulo, String descricao) {
        return this.cliente.post("/servicos/pedidos",
            json.encode(mapOf("title", titulo, "description", descricao)))
    }

    Resposta propostasDoPedido(String pedidoId) {
        return this.cliente.get("/servicos/pedidos/"
            + Cliente.caminho(pedidoId) + "/propostas")
    }

    Resposta proporNoPedido(String pedidoId, String mensagem) {
        return this.cliente.post("/servicos/pedidos/" + Cliente.caminho(pedidoId)
            + "/propostas", json.encode(mapOf("message", mensagem)))
    }

    Resposta escolherProposta(String pedidoId, String propostaId) {
        return this.cliente.post("/servicos/pedidos/" + Cliente.caminho(pedidoId)
            + "/escolher", json.encode(mapOf("proposalId", propostaId)))
    }

    Resposta aceitarContrato(String contratoId) {
        return this.cliente.post("/servicos/contratos/"
            + Cliente.caminho(contratoId) + "/aceitar", "{}")
    }

    Resposta entregarContrato(String contratoId) {
        return this.cliente.post("/servicos/contratos/"
            + Cliente.caminho(contratoId) + "/entregar", "{}")
    }

    Resposta reembolsoContrato(String contratoId) {
        return this.cliente.post("/servicos/contratos/"
            + Cliente.caminho(contratoId) + "/reembolso", "{}")
    }

    static VitrineServico vitrineDe(Resposta r) {
        var vazia = VitrineServico(listOf<OfertaServico>(), listOf<PedidoServico>())
        if (!r.ok()) { return vazia }
        try {
            var v = json.decode<VitrineServico>(r.corpo)
            if (v.ofertas != null && v.pedidos != null) { return v }
            return vazia
        } catch (String e) {
            return vazia
        }
    }

    static MeusServicos meusDe(Resposta r) {
        var vazio = MeusServicos(listOf<OfertaServico>(), listOf<ContratoServico>(),
            listOf<ContratoServico>())
        if (!r.ok()) { return vazio }
        try {
            var m = json.decode<MeusServicos>(r.corpo)
            if (m.ofertas != null && m.contratosComoComprador != null
                && m.contratosComoVendedor != null) {
                return m
            }
            return vazio
        } catch (String e) {
            return vazio
        }
    }

    static List<PropostaServico> propostasDe(Resposta r) {
        if (!r.ok()) { return listOf<PropostaServico>() }
        try {
            return json.decode<List<PropostaServico>>(r.corpo)
        } catch (String e) {
            return listOf<PropostaServico>()
        }
    }
}
