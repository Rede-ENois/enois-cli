package api

import tipos.*
import core.Cliente
import core.Resposta
import kof.json

class LojaApi {

    Cliente cliente

    public constructor(Cliente cliente) {
        this.cliente = cliente
    }

    Resposta catalogo(String? ordem) {
        var o = "new"
        if (ordem != null) { o = ordem }
        return this.cliente.get("/loja" + Cliente.par("order", o))
    }

    Resposta colecoes() {
        return this.cliente.get("/loja/colecoes")
    }

    Resposta comprar(String itemId) {
        return this.cliente.post("/loja/" + Cliente.caminho(itemId) + "/comprar", "{}")
    }

    Resposta comprarLook(String lookId) {
        return this.cliente.post("/loja/looks/" + Cliente.caminho(lookId) + "/comprar", "{}")
    }

    Resposta equipar(String itemId) {
        return this.cliente.post("/loja/" + Cliente.caminho(itemId) + "/equipar", "{}")
    }

    Resposta desequipar(String itemId) {
        return this.cliente.post("/loja/" + Cliente.caminho(itemId) + "/desequipar", "{}")
    }

    Resposta equiparLook(String lookId) {
        return this.cliente.post("/loja/looks/" + Cliente.caminho(lookId) + "/equipar", "{}")
    }

    Resposta desequiparLook(String lookId) {
        return this.cliente.post("/loja/looks/" + Cliente.caminho(lookId) + "/desequipar", "{}")
    }

    Resposta meuStatus(String texto, String icone) {
        return this.cliente.put("/me/status", json.encode(mapOf("text", texto, "icon", icone)))
    }

    static List<ItemLoja> itensDe(Resposta r) {
        if (!r.ok()) { return listOf<ItemLoja>() }
        try {
            return json.decode<List<ItemLoja>>(r.corpo)
        } catch (String e) {
            return listOf<ItemLoja>()
        }
    }

    static List<LojaColecao> colecoesDe(Resposta r) {
        if (!r.ok()) { return listOf<LojaColecao>() }
        try {
            return json.decode<List<LojaColecao>>(r.corpo)
        } catch (String e) {
            return listOf<LojaColecao>()
        }
    }
}
