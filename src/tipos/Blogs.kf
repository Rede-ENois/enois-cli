package tipos

record PostBlog(String id, String? title, String? body, String? bodyFormat, List<String>? mediaIds,
                String? publishedAt, String? updatedAt)

record BlogTerminal(
    String id,
    String? slug,
    String? title,
    String? description,
    String? authorName,
    String? authorUsername,
    String? authorAvatar,
    String? authorBadge,
    Int? posts,
    Troolean? subscribed,
    Troolean? owner,
    List<PostBlog>? items
)

record ResumoBlog(String? slug, String? title, String? description, String? authorName,
                  String? authorUsername, String? authorAvatar, Int? posts)
